	const resetBtn = document.getElementById('reset-filters');
	const resetBtnTop = document.getElementById('reset-filters-top');
	const filterRecentBtn = document.getElementById('filter-recent');
	const filterOlympiadBtn = document.getElementById('filter-olympiad');
	const filterGeometryBtn = document.getElementById('filter-geometry');
	const filterAlgebraBtn = document.getElementById('filter-algebra');
	const stageFilters = document.querySelectorAll('.stage-filter');

	// Debounced search
	let searchTimeout;
	const debounceSearch = (func, delay) => {
		return (...args) => {
			clearTimeout(searchTimeout);
			searchTimeout = setTimeout(() => func.apply(this, args), delay);
		};
	};

	// Подготовка на податоци за Fuse.js
	const searchData = Array.from(cards).map(card => ({
		id: card.dataset.title,
		title: card.dataset.title,
		body: card.dataset.search,
		element: card
	}));

	const fuse = new Fuse(searchData, {
		keys: ['title', 'body'],
		threshold: 0.3,
		distance: 100
	});

	function filterAndSort(filterGrades = null) {
		const query = searchInput.value.toLowerCase();
		let selectedGrades = filterGrades || Array.from(gradeFilters).filter(i => i.checked).map(i => i.value);
		const selectedCats = Array.from(catFilters).filter(i => i.checked).map(i => i.value);
		const selectedDiffs = Array.from(diffFilters).filter(i => i.checked).map(i => i.value);
		const sortOption = sortSelect.value;

		// Резултати од Fuzzy Search
		const fuseResults = query ? fuse.search(query).map(r => r.item.element) : null;

		// Collect visible cards
		let visibleCards = Array.from(cards).filter(card => {
			const grade = card.dataset.grade || '';
			const cat = card.dataset.category || '';
			const diff = card.dataset.difficulty || '';

			const matchesSearch = !fuseResults || fuseResults.includes(card);
			const matchesGrade = selectedGrades.length === 0 || selectedGrades.includes(grade);
			const matchesCat = selectedCats.length === 0 || selectedCats.includes(cat);
			const matchesDiff = selectedDiffs.length === 0 || selectedDiffs.includes(diff);

			return matchesSearch && matchesGrade && matchesCat && matchesDiff;
		});

		// Sort visible cards
		visibleCards.sort((a, b) => {
			const titleA = a.dataset.title || '';
			const titleB = b.dataset.title || '';
			const diffA = parseInt(a.dataset.difficulty || '0');
			const diffB = parseInt(b.dataset.difficulty || '0');
			const gradeA = parseInt(a.dataset.grade || '0');
			const gradeB = parseInt(b.dataset.grade || '0');
			const catA = a.dataset.category || '';
			const catB = b.dataset.category || '';

			switch (sortOption) {
				case 'title-asc':
					return titleA.localeCompare(titleB);
				case 'title-desc':
					return titleB.localeCompare(titleA);
				case 'difficulty-asc':
					return diffA - diffB;
				case 'difficulty-desc':
					return diffB - diffA;
				case 'grade-asc':
					return gradeA - gradeB;
				case 'grade-desc':
					return gradeB - gradeA;
				case 'category-asc':
					return catA.localeCompare(catB);
				case 'category-desc':
					return catB.localeCompare(catA);
				default:
					return 0; // default order
			}
		});

		// Hide all cards first
		cards.forEach(card => card.style.display = 'none');

		// Show sorted visible cards
		visibleCards.forEach(card => card.style.display = 'block');

		const visibleCount = visibleCards.length;

		// Ажурирај го бројачот со правилна множина
		if (countEl) {
			const text = visibleCount === 1 ? 'задача' : 'задачи';
			countEl.textContent = `${visibleCount} ${text}`;
		}
		if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
	}

	searchInput?.addEventListener('input', debounceSearch(filterAndSort, 300));
	gradeFilters.forEach(i => i.addEventListener('change', filterAndSort));
	catFilters.forEach(i => i.addEventListener('change', filterAndSort));
	diffFilters.forEach(i => i.addEventListener('change', filterAndSort));
	sortSelect?.addEventListener('change', filterAndSort);

	// View mode toggles
	gridViewBtn?.addEventListener('click', () => {
		problemsGrid.classList.remove('grid-cols-1');
		problemsGrid.classList.add('grid-cols-1', 'md:grid-cols-2');
		cards.forEach(card => {
			card.classList.remove('list-view');
			card.classList.add('grid-view');
		});
		gridViewBtn.classList.add('text-blue-600', 'bg-blue-50', 'dark:bg-blue-900/20');
		gridViewBtn.classList.remove('text-slate-400');
		listViewBtn.classList.remove('text-blue-600', 'bg-blue-50', 'dark:bg-blue-900/20');
		listViewBtn.classList.add('text-slate-400');
	});

	listViewBtn?.addEventListener('click', () => {
		problemsGrid.classList.remove('md:grid-cols-2');
		problemsGrid.classList.add('grid-cols-1');
		cards.forEach(card => {
			card.classList.remove('grid-view');
			card.classList.add('list-view');
		});
		listViewBtn.classList.add('text-blue-600', 'bg-blue-50', 'dark:bg-blue-900/20');
		listViewBtn.classList.remove('text-slate-400');
		gridViewBtn.classList.remove('text-blue-600', 'bg-blue-50', 'dark:bg-blue-900/20');
		gridViewBtn.classList.add('text-slate-400');
	});

	const resetAll = () => {
		gradeFilters.forEach(i => i.checked = false);
		catFilters.forEach(i => i.checked = false);
		diffFilters.forEach(i => i.checked = false);
		searchInput.value = '';
		sortSelect.value = 'default';
		filterAndSort();
	};

	resetBtn?.addEventListener('click', resetAll);
	resetBtnTop?.addEventListener('click', resetAll);

	// Quick filter buttons
	filterRecentBtn?.addEventListener('click', () => {
		resetAll();
		// Apply recent filter (grades 8-9)
		document.querySelectorAll('#grade-filters input').forEach(input => {
			if (['8', '9'].includes(input.value)) {
				input.checked = true;
			}
		});
		filterAndSort();
	});

	filterOlympiadBtn?.addEventListener('click', () => {
		resetAll();
		// Apply olympiad filter (difficulty 7-10)
		document.querySelectorAll('#diff-filters input').forEach(input => {
			if (['7', '8', '9', '10'].includes(input.value)) {
				input.checked = true;
			}
		});
		filterAndSort();
	});

	filterGeometryBtn?.addEventListener('click', () => {
		resetAll();
		// Apply geometry filter
		document.querySelectorAll('#cat-filters input').forEach(input => {
			if (input.value.toLowerCase().includes('геометри')) {
				input.checked = true;
			}
		});
		filterAndSort();
	});

	filterAlgebraBtn?.addEventListener('click', () => {
		resetAll();
		// Apply algebra filter
		document.querySelectorAll('#cat-filters input').forEach(input => {
			if (input.value.toLowerCase().includes('алгебр')) {
				input.checked = true;
			}
		});
		filterAndSort();
	});

	// Stage filter buttons in Hero
	stageFilters.forEach(btn => {
		btn.addEventListener('click', () => {
			const grades = JSON.parse(btn.dataset.grades);
			resetAll();
			// Check the corresponding checkboxes in the sidebar
			document.querySelectorAll('#grade-filters input').forEach(input => {
				if (grades.includes(input.value)) {
					input.checked = true;
				}
			});
			filterAndSort();
			// Scroll to problems
			document.getElementById('problems-grid')?.scrollIntoView({ behavior: 'smooth' });
		});
	});

	// Hide skeleton loader and show content on page load
	document.addEventListener('DOMContentLoaded', () => {
		const skeletonLoader = document.getElementById('skeleton-loader');
		const problemsGrid = document.getElementById('problems-grid');
		if (skeletonLoader && problemsGrid) {
			setTimeout(() => {
				skeletonLoader.style.display = 'none';
				problemsGrid.style.display = 'grid';
			}, 500); // Small delay for smooth transition
		}
	});
</script>

