---
import Layout from '../layouts/Layout.astro';
import MathQuote from '../components/MathQuote.astro';
import RoleSelector from '../components/RoleSelector.astro';
import CurriculumViewer from '../components/CurriculumViewer.svelte';
import problems from '../data/problems.json';

// Екстракција на уникатни вредности за филтри
const grades = [...new Set(problems.map(p => p.grade))]
  .filter(g => g && g !== 'N/A')
  .sort((a, b) => parseInt(a) - parseInt(b));
const categories = [...new Set(problems.map(p => p.category))]
  .filter(c => c && c !== 'N/A')
  .sort();

const cleanBody = (text: string) => {
  if (!text) return "";
  return text
    .split('##')[0] // Земи го само текстот пред првиот поднаслов
    .replace(/\[.*?\]\(.*?\)/g, '') // Избриши ги сите Markdown линкови
    .replace(/[\$\#\*\_]/g, '') // Избриши ги специјалните Markdown знаци
    .replace(/\n/g, ' ') // Претвори ги новите редови во празно место
    .trim()
    .slice(0, 120) + '...';
};

const getDifficultyColor = (diff: number) => {
  if (diff <= 3) return 'bg-emerald-500';
  if (diff <= 7) return 'bg-amber-500';
  return 'bg-rose-500';
};
---

<Layout title="МатАрхива | Дигитална библиотека за олимпијци">
	<!-- Hero Section -->
	<div class="relative mb-16 p-12 md:p-20 rounded-[3rem] bg-slate-950 overflow-hidden shadow-2xl border border-white/10 no-print">
		<div class="absolute top-0 right-0 w-full h-full opacity-20 pointer-events-none">
			<div class="absolute top-[-10%] right-[-10%] w-[50%] h-[50%] bg-blue-600 rounded-full blur-[120px]"></div>
			<div class="absolute bottom-[-10%] left-[-10%] w-[40%] h-[40%] bg-indigo-600 rounded-full blur-[100px]"></div>
		</div>

		<!-- Mathematical Illustration -->
		<div class="absolute top-1/2 right-8 transform -translate-y-1/2 opacity-90 pointer-events-none z-10">
			<svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="math-animation">
				<circle cx="100" cy="100" r="80" stroke="url(#gradient)" stroke-width="2" fill="none" class="outer-circle"/>
				<circle cx="100" cy="100" r="60" stroke="url(#gradient)" stroke-width="1" fill="none" class="middle-circle"/>
				<circle cx="100" cy="100" r="40" stroke="url(#gradient)" stroke-width="1" fill="none" class="inner-circle"/>
				<circle cx="100" cy="100" r="20" stroke="url(#gradient)" stroke-width="1" fill="none" class="center-circle"/>
				<path d="M100 20 L100 180 M20 100 L180 100" stroke="url(#gradient)" stroke-width="1" class="axes"/>
				<path d="M65 65 L135 135 M135 65 L65 135" stroke="url(#gradient)" stroke-width="1" class="diagonals"/>
				<text x="95" y="110" font-family="serif" font-size="16" fill="url(#gradient)" text-anchor="middle" class="pi-symbol">π</text>
				<text x="110" y="95" font-family="serif" font-size="12" fill="url(#gradient)" class="pi-exp">2</text>
				<defs>
					<linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
						<stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1" />
						<stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
					</linearGradient>
				</defs>
			</svg>
		</div>
		
		<div class="relative z-10 max-w-5xl mx-auto text-center">
			<div class="flex justify-center items-center gap-3 mb-8">
				<span class="inline-block px-4 py-1.5 rounded-full bg-blue-500/10 text-blue-400 text-xs font-black uppercase tracking-[0.2em] border border-blue-500/20 backdrop-blur-md">
					🚀 Дигитален мост: Курикулум → Олимпијада
				</span>
			</div>

			<h1 class="text-5xl md:text-7xl font-black text-white mb-8 leading-[1.1] tracking-tight">
				Твоето патување до <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400">математичко мајсторство</span>
			</h1>

			<p class="text-slate-400 text-xl mb-12 leading-relaxed max-w-3xl mx-auto font-medium">
				Единствена платформа која ги поврзува лекциите од училиште со предизвиците од олимпијадите преку <span class="text-white">AI анимации</span> и <span class="text-white">интелигентни ресурси</span>.
			</p>

			<!-- Curriculum Quick Access -->
			<div class="mb-16">
				<div class="text-[10px] font-black text-slate-500 uppercase tracking-[0.3em] mb-6">Избери твој степен</div>
				<div class="flex flex-wrap justify-center gap-3">
					{[
						{ label: "1-3 одд", icon: "🌱", color: "from-emerald-500/20 to-emerald-600/20", border: "border-emerald-500/30", text: "text-emerald-400", grades: ["I", "II", "III"] },
						{ label: "4-6 одд", icon: "🌿", color: "from-blue-500/20 to-blue-600/20", border: "border-blue-500/30", text: "text-blue-400", grades: ["IV", "V", "VI"] },
						{ label: "7-9 одд", icon: "🌳", color: "from-indigo-500/20 to-indigo-600/20", border: "border-indigo-500/30", text: "text-indigo-400", grades: ["VII", "VIII", "IX"] },
						{ label: "Средно", icon: "🏔️", color: "from-purple-500/20 to-purple-600/20", border: "border-purple-500/30", text: "text-purple-400", grades: ["HighSchool_1", "HighSchool_2", "HighSchool_3", "HighSchool_4"] }
					].map(stage => (
						<button class="stage-filter group flex items-center gap-3 px-6 py-4 rounded-2xl bg-gradient-to-br border backdrop-blur-xl transition-all hover:scale-105 active:scale-95" 
								class:list={[stage.color, stage.border]}
								data-grades={JSON.stringify(stage.grades)}>
							<span class="text-xl">{stage.icon}</span>
							<span class={`font-bold ${stage.text}`}>{stage.label}</span>
						</button>
					))}
				</div>
			</div>
			
			<!-- Role Entry Points -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
				<a href="/students" class="group p-8 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-xl hover:bg-blue-600/10 hover:border-blue-500/30 transition-all text-left relative overflow-hidden">
					<div class="absolute top-0 right-0 w-24 h-24 bg-blue-600/10 rounded-full blur-3xl -mr-12 -mt-12 transition-all group-hover:bg-blue-600/20"></div>
					<div class="w-12 h-12 bg-blue-500/20 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform border border-blue-500/20">
						<span class="text-2xl">👩‍🎓</span>
					</div>
					<h3 class="text-xl font-bold text-white mb-2">Интерактивно Учење</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Истражувај го светот на математиката низ визуелни докази и чекор-по-чекор објаснувања.</p>
				</a>

				<a href="/teachers" class="group p-8 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-xl hover:bg-indigo-600/10 hover:border-indigo-500/30 transition-all text-left relative overflow-hidden">
					<div class="absolute top-0 right-0 w-24 h-24 bg-indigo-600/10 rounded-full blur-3xl -mr-12 -mt-12 transition-all group-hover:bg-indigo-600/20"></div>
					<div class="w-12 h-12 bg-indigo-500/20 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform border border-indigo-500/20">
						<span class="text-2xl">👨‍🏫</span>
					</div>
					<h3 class="text-xl font-bold text-white mb-2">Наставни Ресурси</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Генерирај персонализирани наставни листови и AI анимации за твоите предавања.</p>
				</a>

				<a href="/curriculum-planner" class="group p-8 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-xl hover:bg-emerald-600/10 hover:border-emerald-500/30 transition-all text-left relative overflow-hidden">
					<div class="absolute top-0 right-0 w-24 h-24 bg-emerald-600/10 rounded-full blur-3xl -mr-12 -mt-12 transition-all group-hover:bg-emerald-600/20"></div>
					<div class="w-12 h-12 bg-emerald-500/20 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform border border-emerald-500/20">
						<span class="text-2xl">📋</span>
					</div>
					<h3 class="text-xl font-bold text-white mb-2">Програма 1-12</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Целосно мапирана национална програма со директни линкови до олимписки задачи.</p>
				</a>
			</div>

			<div class="flex flex-col sm:flex-row gap-4 max-w-2xl mx-auto">
				<div class="relative flex-grow">
					<input 
						type="text" 
						id="search" 
						placeholder="Пребарај тема, поим или задача..." 
						class="w-full pl-14 pr-4 py-5 bg-white/5 border border-white/10 rounded-2xl text-white placeholder-slate-500 focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500/50 outline-none backdrop-blur-xl transition-all shadow-2xl text-center font-medium"
					/>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-500 absolute left-5 top-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
					</svg>
				</div>
			</div>
			
			<div class="mt-10 flex flex-wrap gap-8 justify-center items-center text-slate-500">
				<div class="flex items-center gap-2">
					<div class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
					<span class="text-xs font-bold uppercase tracking-[0.2em]">{problems.length} задачи во архивата</span>
				</div>
				<div class="flex items-center gap-2">
					<div class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></div>
					<span class="text-xs font-bold uppercase tracking-[0.2em]">391 наставни стандарди</span>
				</div>
				<div class="flex items-center gap-2">
					<div class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></div>
					<span class="text-xs font-bold uppercase tracking-[0.2em]">100+ AI анимации</span>
				</div>
			</div>
		</div>
	</div>

	<!-- Daily Features -->
	<div class="max-w-6xl mx-auto mb-16 grid grid-cols-1 lg:grid-cols-2 gap-8">
		<!-- Problem of the Day -->
		<div class="bg-gradient-to-br from-emerald-50 via-blue-50/50 to-indigo-50 dark:from-emerald-900/20 dark:via-blue-900/10 dark:to-indigo-900/10 rounded-3xl p-8 border border-emerald-200/50 dark:border-emerald-800/30 shadow-lg">
			<div class="flex items-center gap-3 mb-6">
				<div class="w-12 h-12 bg-emerald-100 dark:bg-emerald-900/30 rounded-full flex items-center justify-center">
					<span class="text-emerald-600 dark:text-emerald-400 text-2xl">🎯</span>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-emerald-900 dark:text-emerald-100">Задача на денот</h2>
					<p class="text-emerald-600 dark:text-emerald-400 text-sm">Нова задача секој ден</p>
				</div>
			</div>

			<div class="space-y-4 mb-6">
				<div class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700">
					<div class="flex items-center justify-between mb-2">
						<span class="text-xs font-black uppercase tracking-widest px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">
							Одделение 9
						</span>
						<span class="text-xs font-black uppercase tracking-widest px-2 py-1 bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">
							Геометрија
						</span>
					</div>
					<p class="text-sm text-slate-700 dark:text-slate-300 font-medium leading-relaxed">
						Во екранот на компјутер е нацртан квадрат со страни 10 cm. Најди ја плоштината на најголемиот круг...
					</p>
				</div>
			</div>

			<a href="/tasks/problem-of-the-day" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-6 rounded-xl transition-all">
				<span>Реши ја задачата</span>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
				</svg>
			</a>
		</div>

		<!-- Daily Quote -->
		<div class="bg-gradient-to-br from-purple-50 via-pink-50/50 to-rose-50 dark:from-purple-900/20 dark:via-pink-900/10 dark:to-rose-900/10 rounded-3xl p-8 border border-purple-200/50 dark:border-purple-800/30 shadow-lg">
			<div class="flex items-center gap-3 mb-6">
				<div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-full flex items-center justify-center">
					<span class="text-purple-600 dark:text-purple-400 text-2xl">💭</span>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-purple-900 dark:text-purple-100">Цитат на денот</h2>
					<p class="text-purple-600 dark:text-purple-400 text-sm">Математичка инспирација</p>
				</div>
			</div>

			<MathQuote category="general" compact={false} />

			<div class="mt-6 flex items-center justify-between text-xs text-purple-600 dark:text-purple-400">
				<span>Промени секој ден</span>
				<button class="hover:text-purple-800 dark:hover:text-purple-200 transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0V9a8 8 0 1115.356 2m-15.356 2H4"/>
					</svg>
				</button>
			</div>
		</div>
	</div>

	<!-- Visual Learning Hub - Manim Showcase -->
	<div class="max-w-6xl mx-auto mb-24">
		<div class="flex flex-col md:flex-row items-end justify-between mb-12 gap-6">
			<div>
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 text-blue-500 text-[10px] font-black uppercase tracking-widest mb-4 border border-blue-500/20">
					<span class="relative flex h-2 w-2">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
					</span>
					Визуелно Објаснување
				</div>
				<h2 class="text-4xl font-black mb-4">🎬 Визуелно Мајсторство</h2>
				<p class="text-slate-500 font-medium max-w-2xl text-lg">
					Комплексните математички концепти стануваат очигледни преку прецизни Manim анимации. Од основни теореми до олимписки докази.
				</p>
			</div>
			<a href="/curriculum-planner" class="group px-8 py-4 rounded-2xl bg-slate-900 text-white text-sm font-bold hover:bg-blue-600 transition-all flex items-center gap-3">
				Истражи ја библиотеката
				<span class="group-hover:translate-x-1 transition-transform">→</span>
			</a>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{[
				{ title: "Вивијаниева Теорема", grade: "VIII", category: "Геометрија", id: "manim_geom_8_viviani_proof", icon: "📐", desc: "Визуелен доказ за збирот на растојанијата во рамностран триаголник." },
				{ title: "Питагорова Теорема", grade: "VIII", category: "Геометрија", id: "pythagorean_theorem", icon: "📐", desc: "Класичен доказ преку прередување на површини." },
				{ title: "Агли во триаголник", grade: "VI", category: "Геометрија", id: "manim_geom_9_tri_angle_45_60", icon: "📐", desc: "Зошто збирот на внатрешните агли е секогаш 180 степени?" },
				{ title: "Линеарни равенки", grade: "VII", category: "Алгебра", id: "manim_sigma139_y1_p1", icon: "🧮", desc: "Визуелизација на балансот кај равенките." },
				{ title: "Бројни својства", grade: "V", category: "Броеви", id: "manim_numerus_4412", icon: "🔢", desc: "Длабоко навлегување во светот на природните броеви." },
				{ title: "Олимписки предизвик", grade: "IX", category: "Олимпијада", id: "manim_geom_9_centroid_plane_dist", icon: "🏆", desc: "Напредна геометриска анимација за олимпијци." }
			].map(video => (
				<a href={`/curriculum-planner?animation=${video.id}`} class="group bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 flex flex-col h-full">
					<div class="aspect-video bg-slate-100 dark:bg-slate-950 relative flex items-center justify-center overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent z-10 opacity-60 group-hover:opacity-40 transition-opacity"></div>
						<div class="text-5xl group-hover:scale-125 transition-transform z-20 drop-shadow-2xl">🎥</div>
						
						<div class="absolute top-4 left-4 z-20">
							<span class="px-3 py-1 bg-white/10 backdrop-blur-md border border-white/20 text-white text-[10px] font-black rounded-lg">
								{video.grade} ОДД
							</span>
						</div>

						<div class="absolute bottom-4 left-4 right-4 z-20 flex justify-between items-center translate-y-2 group-hover:translate-y-0 transition-transform">
							<span class="text-[10px] font-black uppercase tracking-widest text-blue-400">{video.category}</span>
							<div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white shadow-lg shadow-blue-600/40 opacity-0 group-hover:opacity-100 transition-opacity">
								<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
							</div>
						</div>
					</div>
					<div class="p-8 flex-grow flex flex-col">
						<div class="flex items-center gap-2 mb-3">
							<span class="text-xl">{video.icon}</span>
							<h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 transition-colors">{video.title}</h3>
						</div>
						<p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed line-clamp-2">{video.desc}</p>
					</div>
				</a>
			))}
		</div>
	</div>

	<div class="mt-16 mb-16 max-w-6xl mx-auto">
		<h2 class="text-3xl font-black mb-8 text-center">📚 Наставна Програма и Видео Лекции</h2>
		<CurriculumViewer client:load />
	</div>

	<!-- National Standards Integration Section - The Bridge -->
	<div class="max-w-6xl mx-auto mb-24 relative overflow-hidden bg-slate-900 rounded-[4rem] p-12 md:p-20 border border-white/10 shadow-2xl">
		<div class="absolute top-0 right-0 w-full h-full opacity-10 pointer-events-none">
			<div class="absolute top-0 right-0 w-[50%] h-[50%] bg-blue-500 rounded-full blur-[120px]"></div>
			<div class="absolute bottom-0 left-0 w-[30%] h-[30%] bg-indigo-500 rounded-full blur-[100px]"></div>
		</div>

		<div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
			<div>
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-400 text-[10px] font-black uppercase tracking-widest mb-8 border border-blue-500/20">
					💎 Моќта на Конекцијата
				</div>
				<h2 class="text-4xl md:text-6xl font-black text-white mb-8 leading-tight">
					Од стандард до <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400">олимписки медал</span>
				</h2>
				<p class="text-slate-400 text-lg mb-10 leading-relaxed font-medium">
					Ние веруваме дека олимпискиот шампион се раѓа во училишната клупа. Затоа, секој наставен стандард е поврзан со соодветни напредни предизвици.
				</p>
				
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
					{[
						{ icon: "⚡", title: "391 Стандарди", desc: "Целосно покриена програма 1-9 одд." },
						{ icon: "🧩", title: "Директно Мапирање", desc: "Врска училница-олимпијада." },
						{ icon: "🤖", title: "AI Помош", desc: "Инстант генерирање материјали." },
						{ icon: "📈", title: "Следење напредок", desc: "Визуелен приказ на успехот." }
					].map(item => (
						<div class="flex items-start gap-4 p-4 rounded-2xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors">
							<div class="w-12 h-12 bg-white/5 rounded-xl flex items-center justify-center flex-shrink-0 border border-white/10 text-xl">{item.icon}</div>
							<div>
								<h4 class="font-bold text-white text-sm mb-1">{item.title}</h4>
								<p class="text-slate-500 text-xs leading-relaxed">{item.desc}</p>
							</div>
