---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vision AI Grader - Автоматско Оценување">
  <main class="max-w-4xl mx-auto p-6">
    <div class="text-center mb-10">
      <div class="inline-block p-3 bg-blue-100 dark:bg-blue-900/30 rounded-2xl mb-4">
        <span class="text-4xl">🤖</span>
      </div>
      <h1 class="text-4xl font-black text-slate-900 dark:text-white mb-2 tracking-tight">Vision AI Grader</h1>
      <p class="text-slate-500 dark:text-slate-400 max-w-lg mx-auto">
        Прикачи слика од твоето ракописно решение и добиј инстантна експертска анализа.
      </p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-xl p-8 border border-slate-100 dark:border-slate-800">
      <!-- Upload Zone -->
      <div id="drop-zone" class="border-4 border-dashed border-slate-100 dark:border-slate-800 rounded-[2rem] p-12 text-center hover:border-blue-400 dark:hover:border-blue-500 transition-all cursor-pointer group bg-slate-50/50 dark:bg-slate-800/20">
        <input type="file" id="file-input" class="hidden" accept="image/*" capture="environment" />
        <div class="text-7xl mb-6 group-hover:scale-110 transition-transform duration-300">📸</div>
        <p class="text-xl font-bold text-slate-700 dark:text-slate-200">Допри за да сликаш</p>
        <p class="text-slate-400 mt-2">или довлечи слика овде</p>
      </div>

      <!-- Preview -->
      <div id="preview-container" class="hidden mt-8 space-y-6">
        <div class="relative rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-700 shadow-lg">
           <img id="image-preview" src="#" alt="Preview" class="max-h-[500px] w-full object-contain bg-slate-50 dark:bg-slate-800" />
        </div>
        
        <button id="analyze-btn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-black py-5 rounded-2xl shadow-xl shadow-blue-500/20 transition-all flex items-center justify-center gap-3 text-lg uppercase tracking-wider">
          <span id="btn-icon">🔍</span>
          <span id="btn-text">Анализирај со Gemini 1.5 Pro</span>
        </button>
      </div>

      <!-- Results Display -->
      <div id="result-container" class="hidden mt-10 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
        <div class="flex items-center gap-4">
            <div class="h-2 flex-1 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                <div id="progress-bar" class="h-full bg-blue-500 w-0 transition-all duration-500 shadow-[0_0_10px_rgba(59,130,246,0.5)]"></div>
            </div>
            <span id="status-text" class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-widest">Процесирање...</span>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-slate-50 dark:bg-slate-800/50 p-8 rounded-[2rem] border border-slate-100 dark:border-slate-800">
            <h4 class="font-black text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="text-emerald-500">✓</span> Препознаен текст
            </h4>
            <div id="extracted-text" class="text-sm font-medium text-slate-600 dark:text-slate-400 whitespace-pre-wrap leading-relaxed"></div>
          </div>
          
          <div class="bg-blue-50 dark:bg-blue-900/10 p-8 rounded-[2rem] border border-blue-100 dark:border-blue-900/30">
            <h4 class="font-black text-blue-900 dark:text-blue-400 mb-4 flex items-center gap-2">
                <span>🧠</span> Педагошки совет (ERR)
            </h4>
            <div id="ai-feedback" class="text-sm text-slate-700 dark:text-slate-300 italic leading-relaxed"></div>
          </div>
        </div>

        <!-- Diagnostic Feedback Section -->
        <div id="diagnostic-container" class="hidden p-8 bg-rose-50 dark:bg-rose-900/10 border border-rose-100 dark:border-rose-900/30 rounded-[2rem] space-y-4">
            <h4 class="font-black text-rose-900 dark:text-rose-400 flex items-center gap-2">
                <span>⚠️</span> Дијагностички наод
            </h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div class="bg-white/50 dark:bg-black/20 p-4 rounded-xl">
                    <span class="block font-bold text-rose-800 dark:text-rose-300 uppercase text-xs mb-1">Грешка во:</span>
                    <span id="error-location" class="text-slate-700 dark:text-slate-300"></span>
                </div>
                <div class="bg-white/50 dark:bg-black/20 p-4 rounded-xl">
                    <span class="block font-bold text-rose-800 dark:text-rose-300 uppercase text-xs mb-1">Тип на грешка:</span>
                    <span id="error-type" class="text-slate-700 dark:text-slate-300"></span>
                </div>
                <div class="col-span-full bg-white/50 dark:bg-black/20 p-4 rounded-xl">
                    <span class="block font-bold text-rose-800 dark:text-rose-300 uppercase text-xs mb-1">Дупка во знаењето (Knowledge Gap):</span>
                    <span id="knowledge-gap" class="text-slate-700 dark:text-slate-300 italic"></span>
                </div>
            </div>
        </div>

        <div id="topic-suggestion" class="hidden p-6 bg-amber-50 dark:bg-amber-900/10 border border-amber-100 dark:border-amber-900/30 rounded-2xl text-center">
            <p class="text-amber-800 dark:text-amber-400 text-sm font-bold">
                💡 Препорачана тема за повторување: <span id="suggested-topic" class="underline"></span>
            </p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input');
  const previewContainer = document.getElementById('preview-container');
  const imagePreview = document.getElementById('image-preview');
  const analyzeBtn = document.getElementById('analyze-btn');
  const btnText = document.getElementById('btn-text');
  const btnIcon = document.getElementById('btn-icon');

  // Камера активација
  dropZone.addEventListener('click', () => fileInput.click());

  fileInput.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        imagePreview.src = event.target.result;
        previewContainer.classList.remove('hidden');
        dropZone.classList.add('hidden');
      };
      reader.readAsDataURL(file);
    }
  });

  analyzeBtn.addEventListener('click', async () => {
    const resultContainer = document.getElementById('result-container');
    const progressBar = document.getElementById('progress-bar');
    const statusText = document.getElementById('status-text');
    
    analyzeBtn.disabled = true;
    btnText.innerText = "Анализа во тек...";
    btnIcon.innerText = "🌀";
    btnIcon.classList.add('animate-spin');
    
    resultContainer.classList.remove('hidden');
    
    // Прогрес симулација
    let width = 0;
    const interval = setInterval(() => {
      if (width >= 95) clearInterval(interval);
      width += 2;
      progressBar.style.width = width + '%';
    }, 150);

    try {
        const formData = new FormData();
        formData.append('image', fileInput.files[0]);

        const response = await fetch('/api/vision-grade', {
            method: 'POST',
            body: formData
        });

        const result = await response.json();
        
        clearInterval(interval);
        progressBar.style.width = '100%';
        progressBar.classList.replace('bg-blue-500', 'bg-emerald-500');
        statusText.innerText = "Завршено";
        statusText.classList.replace('text-blue-600', 'text-emerald-600');

        document.getElementById('extracted-text').innerText = result.extractedText;
        document.getElementById('ai-feedback').innerText = result.pedagogicalAdvice;
        
        // Handle Diagnostic Data
        if (!result.isCorrect && result.diagnosticFeedback) {
            document.getElementById('diagnostic-container').classList.remove('hidden');
            document.getElementById('error-location').innerText = result.diagnosticFeedback.errorLocation;
            document.getElementById('error-type').innerText = result.diagnosticFeedback.errorType;
            document.getElementById('knowledge-gap').innerText = result.diagnosticFeedback.knowledgeGap;
        }

        if (result.suggestedTopic) {
            document.getElementById('topic-suggestion').classList.remove('hidden');
            document.getElementById('suggested-topic').innerText = result.suggestedTopic;
        }

        btnText.innerText = "Нова Анализа";
        btnIcon.innerText = "✨";
        btnIcon.classList.remove('animate-spin');
        analyzeBtn.disabled = false;
        analyzeBtn.onclick = () => window.location.reload();

    } catch (error) {
        clearInterval(interval);
        statusText.innerText = "Грешка";
        statusText.classList.replace('text-blue-600', 'text-rose-600');
        document.getElementById('ai-feedback').innerText = "Се појави грешка при поврзување со AI. Обиди се повторно.";
    }
  });
</script>

<style>
    @keyframes fade-in {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-in {
        animation: fade-in 0.5s ease-out forwards;
    }
</style>
