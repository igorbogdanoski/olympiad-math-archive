---
import Layout from '../layouts/Layout.astro';

const quotes = [
  {
    text: "Математиката е јазикот кој Бог го користел за да создаде универзумот.",
    author: "Галилео Галилеј",
    context: "За универзалната моќ на математиката"
  },
  {
    text: "Во математиката процесот на откривање на вистината е исто толку важен колку и самата вистина.",
    author: "Јунор Гаус",
    context: "За важноста на математичкото истражување"
  },
  {
    text: "Математиката е најсовршената форма на уметноста.",
    author: "Џозеф Жубер",
    context: "За естетската димензија на математиката"
  }
];
---

<Layout title="За Авторот | МатАрхива">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="flex mb-8 text-sm font-medium text-slate-500 gap-2 items-center">
      <a href="/" class="hover:text-blue-600 transition-colors">Архива</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-slate-100">За Авторот</span>
    </nav>

    <div class="space-y-12">
      <!-- Author Introduction -->
      <div class="bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-xl overflow-hidden">
        <div class="p-10 border-b border-slate-50 dark:border-slate-800 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-slate-800 dark:to-slate-900">
          <div class="flex items-center gap-6">
            <img src="/logo.svg" alt="GeoMentor Logo" class="w-20 h-20">
            <div>
              <h1 class="text-4xl font-black text-slate-900 dark:text-white leading-tight">
                Игор Богданоски
              </h1>
              <p class="text-lg text-slate-600 dark:text-slate-300 mt-2">
                Основач на GeoMentor - Математичка едукација за иднината
              </p>
              <div class="flex gap-4 mt-4">
                <a href="https://github.com/igorbogdanoski" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 dark:bg-slate-800 rounded-full text-sm font-medium hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                  GitHub
                </a>
                <a href="https://www.linkedin.com/in/igor-bogdanoski" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-sm font-medium hover:bg-blue-200 dark:hover:bg-blue-900/50 transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  LinkedIn
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="p-10">
          <div class="prose prose-slate dark:prose-invert prose-lg max-w-none">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">За мене</h2>
            <p class="text-slate-700 dark:text-slate-300 mb-6 leading-relaxed">
              Здраво! Јас сум Игор Богданоски, основач на платформата <strong>GeoMentor</strong>.
              Сакам да ја направам математиката достапна, интересна и инспиративна за сите ученици.
            </p>

            <p class="text-slate-700 dark:text-slate-300 mb-6 leading-relaxed">
              Како олимпиец по математика, знам колку е важно да се разбере суштината на проблемите,
              а не само да се меморираат формули. Оваа архива е создадена со цел да им помогне на учениците
              да развијат длабоко разбирање на математичките концепти преку интерактивни визуелизации и детални решенија.
            </p>

            <p class="text-slate-700 dark:text-slate-300 mb-6 leading-relaxed">
              Верувам дека секој ученик може да го совлада уметноста на математичкото размислување,
              и сакам да бидам дел од тоа патување.
            </p>

            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4">Мисија</h3>
            <p class="text-slate-700 dark:text-slate-300 mb-6 leading-relaxed">
              Да создадам најдобрата математичка платформа во светот, која ќе ја надмине границите
              на Македонија и ќе инспирира ученици од целиот свет.
            </p>

            <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-6 mt-8">
              <h4 class="text-lg font-semibold text-blue-900 dark:text-blue-100 mb-2">🚀 Идни планови</h4>
              <ul class="text-blue-800 dark:text-blue-200 space-y-2">
                <li>• Превод на архивата на англиски, албански и други јазици</li>
                <li>• Интерактивни вежби со моментална повратна информација</li>
                <li>• AI-powered персонализирани патеки за учење</li>
                <li>• Партнерства со училишта и универзитети</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Mathematical Quotes -->
      <div class="space-y-6">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white text-center">
          🎯 Математички Мисли
        </h2>

        {quotes.map((quote, index) => (
          <div class="bg-gradient-to-r from-slate-50 to-blue-50 dark:from-slate-800 dark:to-blue-900/20 rounded-2xl p-8 border border-slate-200 dark:border-slate-700">
            <blockquote class="text-center">
              <p class="text-xl italic text-slate-800 dark:text-slate-200 mb-4 leading-relaxed">
                "{quote.text}"
              </p>
              <footer class="text-slate-600 dark:text-slate-400">
                <cite class="font-semibold text-lg">{quote.author}</cite>
                <p class="text-sm mt-1 opacity-75">{quote.context}</p>
              </footer>
            </blockquote>
          </div>
        ))}
      </div>

      <!-- Contact Section -->
      <div class="bg-white dark:bg-slate-900 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-lg p-8 text-center">
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">Контакт</h3>
        <p class="text-slate-600 dark:text-slate-300 mb-6">
          Имате идеи, предлози или сакате да соработувате? Слободно контактирајте!
        </p>
        <div class="flex justify-center gap-4">
          <a href="mailto:igor@geomentor.mk" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-full font-medium transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Email
          </a>
          <a href="https://github.com/igorbogdanoski/olympiad-math-archive" class="inline-flex items-center gap-2 px-6 py-3 bg-slate-800 hover:bg-slate-900 text-white rounded-full font-medium transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub Issues
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>