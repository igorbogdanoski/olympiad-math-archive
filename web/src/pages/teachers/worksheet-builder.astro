    // --- EASTER EGG 1: Perfect 100 Score Confetti 🎉 ---
    function checkPerfectScore(problems) {
      const total = problems.reduce((sum, p) => sum + (p.points || 5), 0);

      // Trigger confetti only if exactly 100 and wasn't 100 before
      if (total === 100 && window.lastTotal !== 100) {
        if (typeof confetti === 'function') {
          confetti({
            particleCount: 150,
            spread: 70,
            origin: { y: 0.6 },
            colors: ['#2563eb', '#facc15', '#ef4444']
          });
        }
        
        // Toast notification
        const toast = document.createElement('div');
        toast.className = 'toast-notification';
        toast.innerHTML = '💯 Совршени 100 поени!';
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
      }
      window.lastTotal = total;
    }

    // --- EASTER EGG 2: Konami Code (God Mode) 🕹️ ---
    let konamiCode = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
    let currentPos = 0;

    document.addEventListener('keydown', (e) => {
      if (e.key === konamiCode[currentPos]) {
        currentPos++;
        if (currentPos === konamiCode.length) {
          activateGodMode();
          currentPos = 0;
        }
      } else {
        currentPos = 0;
      }
    });

