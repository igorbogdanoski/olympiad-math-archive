    // Step 2: Problem Selection and Filtering
    function applyFilters() {
      const subject = document.getElementById('filter-subject').value;
      const grade = document.getElementById('filter-grade').value;
      const difficulty = document.getElementById('filter-difficulty').value;
      const bro = document.getElementById('filter-bro').value.toLowerCase();

      filteredProblems = allProblems.filter(problem => {
        // Use 'topic' field from DB (not 'subject')
        if (subject && problem.topic !== subject) return false;
        if (grade && problem.grade !== grade) return false;
        if (difficulty && problem.difficulty !== parseInt(difficulty)) return false;
        if (bro && !problem.curriculum_codes?.some(s => s.toLowerCase().includes(bro))) return false;
        return true;
      });

      renderProblems();
    }

    window.resetFilters = function() {
      document.getElementById('filter-subject').value = '';
      document.getElementById('filter-grade').value = '';
      document.getElementById('filter-difficulty').value = '';
      document.getElementById('filter-bro').value = '';
      filteredProblems = [...allProblems];
      renderProblems();
    }

    function renderProblems() {
      const grid = document.getElementById('problems-grid');
      document.getElementById('available-count').textContent = filteredProblems.length;
      
      if (!problemRenderer || filteredProblems.length === 0) {
        grid.innerHTML = '<p style="padding: 2rem; text-align: center; color: #95a5a6;">Нема достапни задачи...</p>';
        return;
      }
      
      // Render problem cards with rich details
      grid.innerHTML = filteredProblems.slice(0, 50).map(problem => {
        const displayTitle = problem.title || problem.problem_id || `Задача ${problem.id}`;
        const broCode = problem.primary_skill || problem.curriculum_codes?.[0] || '';
        const difficulty = problem.difficulty || 2;
        const diffLabels = ['Лесно', 'Лесно', 'Средно', 'Тешко', 'Олимписко'];
        const diffClasses = ['easy', 'easy', 'medium', 'hard', 'olympiad'];
        
        // Extract preview text
        let preview = '';
        if (problem.content_markdown) {
          preview = problem.content_markdown.split('\n\n')[1] || problem.content_markdown.split('\n')[0];
          preview = preview.replace(/^#+\s*/g, '').replace(/\*\*/g, '').substring(0, 100);
        }
        
        return `
        <div class="problem-card-mini" data-problem-id="${problem.id}" data-selected="false">
          <div class="problem-header">
            <span class="badge badge-${diffClasses[difficulty]}">${diffLabels[difficulty]}</span>
            <span class="badge badge-grade">Одд. ${problem.grade || 7}</span>
            ${broCode ? `<span class="badge badge-bro" title="БРО Код">${broCode.substring(0, 20)}</span>` : ''}
          </div>
          <div class="problem-title">${displayTitle}</div>
          ${preview ? `<div class="problem-preview">${preview}...</div>` : ''}
          <div class="problem-meta">
            <span class="points-tag">${problem.points || 3} поени</span>
            <span class="topic-tag">${problem.topic || 'Алгебра'}</span>
          </div>
        </div>
      `}).join('');
      
      // Add event listeners to cards
      grid.querySelectorAll('.problem-card-mini').forEach(card => {
        card.addEventListener('click', () => {
          const problemId = card.dataset.problemId;
          window.addProblem(problemId);
        });
      });
      
      // Highlight already selected problems
      const currentGroupProblems = window.groups[window.activeGroup] || [];
      currentGroupProblems.forEach(p => {
        const card = grid.querySelector(`[data-problem-id="${p.id}"]`);
        if (card) {
          card.classList.add('selected');
          card.dataset.selected = 'true';
        }
      });
    }

    window.addProblem = function(problemId) {
      const problem = filteredProblems.find(p => p.id === problemId);
      if (!problem) return;
      
      // Get current group's problems
      const currentGroupProblems = window.groups[window.activeGroup] || [];
      
      // Check if already added - TOGGLE behavior
      const existingIndex = currentGroupProblems.findIndex(p => p.id === problemId);
      if (existingIndex >= 0) {
        // Remove from current group
        window.groups[window.activeGroup].splice(existingIndex, 1);
        console.log(`[addProblem] Removed problem ${problemId} from Group ${window.activeGroup}`);
      } else {
        // Add to current group
        window.groups[window.activeGroup].push(problem);
        console.log(`[addProblem] Added problem ${problemId} to Group ${window.activeGroup}`);
      }
      
      // Update both systems for compatibility
      selectedProblems = window.groups[window.activeGroup];
      currentProblems = window.groups[window.activeGroup];
      
      // Re-render both lists
      renderProblems(); // Re-render available problems to update selection state
      window.renderProblemList(window.groups[window.activeGroup]); // Render selected problems list
    }

    function removeProblem(problemId) {
      selectedProblems = selectedProblems.filter(p => p.id !== problemId);
      updateSelectedProblems();
      renderProblems();
    }

    function updateSelectedProblems() {
      const container = document.getElementById('selected-problems-list');
      const countSpan = document.getElementById('selected-problems-count');
      const selectedCountSpan = document.getElementById('selected-count');
      
      if (countSpan) countSpan.textContent = selectedProblems.length;
      if (selectedCountSpan) selectedCountSpan.textContent = selectedProblems.length;
      
      if (!container) return;
      
      if (selectedProblems.length === 0) {
        container.innerHTML = '<p class="empty-state">Избери задачи од листата погоре...</p>';
        document.getElementById('btn-preview').disabled = true;
        return;
      }
      
      // Render selected problems using renderer
      if (problemRenderer) {
        problemRenderer.renderProblems('selected-problems-list', selectedProblems);
        
        // Initialize drag-and-drop
        initializeSortable();
        
        // Update statistics
        updateStatistics();
      }
      
      document.getElementById('btn-preview').disabled = false;
    }

    function initializeSortable() {
      const container = document.getElementById('selected-problems-list');
      if (container && typeof Sortable !== 'undefined') {
        Sortable.create(container, {
          animation: 150,
          handle: '.drag-handle',
          onEnd: function(evt) {
            // Reorder problems array
            const movedProblem = selectedProblems[evt.oldIndex];
            selectedProblems.splice(evt.oldIndex, 1);
            selectedProblems.splice(evt.newIndex, 0, movedProblem);
            
            // Re-render with new order
            updateSelectedProblems();
          }
        });
      }
    }

    function updateStatistics() {
      if (!problemRenderer) return;
      
      const stats = problemRenderer.calculateStats(selectedProblems);
      
      // Update points
      document.getElementById('total-points').textContent = stats.totalPoints;
      
      // Update difficulty balance
      const total = stats.count;
      const easyPercent = (stats.difficulty.easy / total * 100) || 0;
      const mediumPercent = (stats.difficulty.medium / total * 100) || 0;
      const hardPercent = (stats.difficulty.hard / total * 100) || 0;
      
      const difficultyBar = document.getElementById('difficulty-balance');
      difficultyBar.innerHTML = `
        <div class="diff-easy" style="width: ${easyPercent}%">${stats.difficulty.easy}</div>
        <div class="diff-medium" style="width: ${mediumPercent}%">${stats.difficulty.medium}</div>
        <div class="diff-hard" style="width: ${hardPercent}%">${stats.difficulty.hard}</div>
      `;
    }

