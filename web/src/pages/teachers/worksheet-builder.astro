              <span>Име: _____________</span>
              ${className ? `<span>Одделение: ${className}</span>` : '<span>Одделение: ____</span>'}
              ${date ? `<span>Датум: ${date}</span>` : '<span>Датум: ________</span>'}
            </div>
            <div style="margin-top: 0.5rem; font-size: 0.9rem;">
              ${duration ? `<span>Време: ${duration} минути</span>` : ''}
              <span style="margin-left: 1rem;">Вкупно: ${totalPoints} поени</span>
            </div>
          </div>
          
          <!-- Problems -->
          <div style="margin-bottom: 2rem;">
      `;
      
      selectedProblems.forEach((problem, index) => {
        const problemNumber = index + 1;
        const points = problem.points || 5;
        const difficulty = problem.difficulty || 5;
        const difficultyLabel = difficulty <= 3 ? 'Лесно' : difficulty <= 7 ? 'Средно' : 'Тешко';
        
        // Fix cyrillic encoding if title is garbled
        let title = problem.title || 'Untitled Problem';
        if (title.includes('?') && title.length > 20) {
          title = problem.problem_id || 'Задача ' + problemNumber;
        }
        
        // Get content (try content_markdown first, then content)
        let content = problem.content_markdown || problem.content || 'Содржина на проблемот...';
        
        // Strip markdown headers and get first paragraph
        content = content
          .replace(/^#.*$/gm, '')  // Remove headers
          .replace(/\*\*/g, '')     // Remove bold
          .replace(/\*/g, '')       // Remove italic
          .trim()
          .split('\n\n')[0]        // Get first paragraph
          .substring(0, 300);      // Limit length
        
        if (content.includes('?') && content.length > 100) {
          content = '[Содржина со специјални карактери - ќе се прикаже правилно во PDF]';
        }
        
        html += `
          <div style="margin-bottom: 2rem; padding: 1rem; border: 1px solid #e0e0e0; border-radius: 8px; page-break-inside: avoid;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <strong style="font-size: 1.1rem;">Задача ${problemNumber}</strong>
              <span style="background: #e3f2fd; padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.85rem;">
                ${points} ${points === 1 ? 'поен' : 'поени'} • ${difficultyLabel}
              </span>
            </div>
            <p style="margin: 0.5rem 0; color: #666; font-size: 0.9rem;">${title}</p>
            <p style="margin: 0.5rem 0; line-height: 1.6;">${content}${content.length >= 300 ? '...' : ''}</p>
            <div style="margin-top: 1rem; padding-top: 0.5rem; border-top: 1px dashed #ddd;">
              <em style="color: #999; font-size: 0.85rem;">Одговор: _________________________</em>
            </div>
          </div>
        `;
      });
      
      html += `
          </div>
          
          <!-- Footer Note -->
          <div style="margin-top: 2rem; padding: 1rem; background: #f5f5f5; border-radius: 8px; font-size: 0.85rem; color: #666;">
            <p style="margin: 0;"><strong>Забелешка:</strong> Preview е симплифициран. Финалниот PDF ќе содржи:</p>
            <ul style="margin: 0.5rem 0; padding-left: 1.5rem;">
              <li>Точно форматирани математички формули (KaTeX)</li>
              <li>Дијаграми и слики</li>
              <li>Одговорен лист на крајот</li>
              <li>Професионален layout</li>
            </ul>
          </div>
        </div>
      `;
      
      previewContent.innerHTML = html;
      
      // Render any math formulas that might exist
      if (window.renderMathInElement) {
        try {
          renderMathInElement(previewContent);
        } catch (e) {
          console.log('[Preview] KaTeX not available');
        }
      }
    }

    function selectAllVisible() {
      const visibleProblems = filteredProblems.slice(0, 50);
      visibleProblems.forEach(problem => {
        if (!selectedProblems.find(p => p.id === problem.id)) {
          selectedProblems.push(problem);
        }
      });
      updateSelectedProblems();
      alert(`✅ Избрани ${visibleProblems.length} проблеми!`);
    }

    window.deselectAll = function() {
      selectedProblems = [];
      updateSelectedProblems();
      alert('❌ Сите проблеми се откажани.');
    }

    window.selectRandomProblems = function(count) {
      const available = filteredProblems.filter(p => !selectedProblems.find(sp => sp.id === p.id));
      if (available.length === 0) {
        alert('Сите проблеми се веќе избрани!');
        return;
      }
      
      const toSelect = Math.min(count, available.length);
      const shuffled = available.sort(() => Math.random() - 0.5);
      const randomSelection = shuffled.slice(0, toSelect);
      
      randomSelection.forEach(p => selectedProblems.push(p));
      updateSelectedProblems();
      alert(`🎲 Избрани ${toSelect} random проблеми!`);
    }

    window.generatePDF = async function() {
      if (selectedProblems.length === 0) {
        alert('⚠️ Изберете барем еден проблем пред да генерирате PDF!');
        return;
      }

      // Show loading indicator
      const btn = event.target;
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '⏳ Генерирам PDF...';

      try {
        // Get worksheet metadata
        const title = document.getElementById('worksheet-title')?.value || 'Работен Лист';
        const description = document.getElementById('worksheet-description')?.value || '';
        const includeSolutions = document.getElementById('include-solutions')?.checked ?? true;
        
        // Prepare API request
        const apiBase = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
          ? 'http://localhost:8000'
          : '';
        
        const requestBody = {
          title: title,
          description: description,
          problems: selectedProblems.map(p => ({
            id: p.id || p._id || 'unknown',
            problem_id: p.problem_id,
            content: p.content || p.problem_text || 'Нема содржина',
            solution: p.solution || p.answer || null,
            difficulty: p.difficulty,
            grade: p.grade,
            topic: p.topic || p.subject
          })),
          include_solutions: includeSolutions,
          school_name: null,
          teacher_name: null,
          grade: currentTemplate?.grade || null,
          // Approach 3 (Hybrid): Send Macedonian labels to backend
          labels: {
            school: "Училиште:",
            teacher: "Наставник:",
            grade: "Одделение:",
            student: "Ученик:",
            date: "Датум:",
            problem_count: "Број на задачи:",
            description: "Опис:",
            problem: "Задача",
            solutions: "Решенија",
            solution: "Решение",
            generated_via: "Генерирано преку"
          }
        };

        // Call PDF generation API
        const response = await fetch(`${apiBase}/api/worksheet/generate-pdf`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(requestBody)
        });

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.detail || 'PDF generation failed');
        }

        // Download PDF
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `worksheet_${title.replace(/\s+/g, '_')}_${new Date().toISOString().split('T')[0]}.pdf`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);

        alert('✅ PDF успешно генериран и преземен!');

      } catch (error) {
        console.error('PDF Generation Error:', error);
        alert(`❌ Грешка при генерирање на PDF:\n${error.message}\n\nПробајте повторно или контактирајте поддршка.`);
      } finally {
        // Restore button
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    }

    function saveWorksheet() {
      if (selectedProblems.length === 0) {
        alert('⚠️ Изберете барем еден проблем пред да зачувате!');
        return;
      }
      const title = document.getElementById('worksheet-title')?.value || 'Без наслов';
      alert(`Worksheet save functionality coming next! 💾\n\nНаслов: ${title}\nПроблеми: ${selectedProblems.length}`);
    }
  </script>
</Layout>
