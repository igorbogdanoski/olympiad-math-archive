---
// Worksheet Builder Page
// Created: February 2, 2026
// Purpose: Teacher interface for creating custom worksheets
import Layout from '../../layouts/Layout.astro';
import { WORKSHEET_TEMPLATES } from '../../data/worksheet_templates';
import FilterSidebar from '../../components/worksheet/FilterSidebar.astro';
import ProblemList from '../../components/worksheet/ProblemList.astro';
import ExportModal from '../../components/worksheet/ExportModal.astro';

// Load problems data for filtering
import problemsData from '../../data/problems.json';
const problems = problemsData.problems || [];

// Calculate statistics
const geometryProblems = problems.filter(p => p.topic?.toLowerCase().includes('geometry') || p.subject === 'geometry');
const algebraProblems = problems.filter(p => p.topic?.toLowerCase().includes('algebra') || p.subject === 'algebra');
const totalProblems = problems.length;
---

<Layout 
  title="Креирај работен лист | Olympiad Math Archive"
  description="Креирај персонализиран работен лист за твојот час"
>
  <!-- KaTeX CSS for math rendering -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
  
  <!-- Problem Renderer Script -->
  <script is:inline src="/scripts/worksheet-problem-renderer.js"></script>
  
  <!-- Template Manager Script -->
  <script is:inline src="/scripts/worksheet-template-manager.js"></script>
  
  <!-- KaTeX Scripts -->
  <script defer is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script defer is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
  
  <!-- Sortable.js for drag-and-drop -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

  <div class="worksheet-builder">
    <!-- Hero Section -->
    <section class="hero">
      <h1>📄 Worksheet Builder</h1>
      <p class="subtitle">Креирај професионален работен лист за 5 минути</p>
    </section>

    <!-- Step 1: Template Selection -->
    <section class="step-section">
      <div class="step-header">
        <span class="step-number">1</span>
        <h2>Избери template</h2>
      </div>
      
      <div class="template-grid" id="template-grid">
        <!-- Templates will be loaded dynamically from API -->
        <div class="loading-state">
          <div class="spinner"></div>
          <p>Вчитување на templates...</p>
        </div>
      </div>
    </section>

    <!-- Step 2: Problem Selection -->
    <section class="step-section" id="problem-selection" style="display: none;">
      <div class="step-header">
        <span class="step-number">2</span>
        <h2>Избери задачи</h2>
      </div>

      <!-- Filters -->
      <div class="filters-panel">
        <div class="filter-group">
          <label>Област (Наставна програма):</label>
          <select id="filter-subject" onchange="window.triggerFilterUpdate()">
            <option value="">Сите области</option>
            <option value="geometry">Геометрија</option>
            <option value="algebra">Алгебра</option>
            <option value="number_theory">Теорија на броеви</option>
            <option value="combinatorics">Комбинаторика</option>
          </select>
        </div>

        <div class="filter-group">
          <label>Одделение:</label>
          <select id="filter-grade" onchange="applyFilters()">
            <option value="">Сите</option>
            <option value="6">6 одд.</option>
            <option value="7">7 одд.</option>
            <option value="8">8 одд.</option>
            <option value="9">9 одд.</option>
          </select>
        </div>

        <div class="filter-group">
          <label>Тежина:</label>
          <select id="filter-difficulty" onchange="applyFilters()">
            <option value="">Сите</option>
            <option value="easy">Лесно</option>
            <option value="medium">Средно</option>
            <option value="hard">Тешко</option>
          </select>
        </div>

        <div class="filter-group">
          <label>БРО Стандард:</label>
          <input 
            type="text" 
            id="filter-bro" 
            placeholder="М.6.2.1"
            onkeyup="applyFilters()"
          />
        </div>

        <button class="btn-filter-reset" onclick="resetFilters()">
          Reset филтри
        </button>
        
        <!-- BRO Code Legend -->
        <div class="bro-legend" style="margin-top: 1rem; padding: 0.75rem; background: #ecf0f1; border-radius: 6px; font-size: 0.85rem;">
          <details>
            <summary style="cursor: pointer; font-weight: 600; color: #16a085;">
              🎯 Што значат БРО кодовите?
            </summary>
            <div style="margin-top: 0.5rem; line-height: 1.6; color: #2c3e50;">
              <p style="margin-bottom: 0.5rem;"><strong>БРО</strong> = <strong>Б</strong>роен <strong>Р</strong>екорд на <strong>О</strong>бјективи</p>
              <p style="margin-bottom: 0.25rem;"><strong>Формат:</strong> Предмет.Одд.Тема.Цел</p>
              <p style="margin: 0; padding-left: 1rem; font-family: 'Courier New', monospace; color: #16a085;">
                Пример: <strong>М.7.2.3</strong> = Математика, 7мо одд., Тема 2, Цел 3
              </p>
            </div>
          </details>
        </div>
      </div>

      <!-- Problem Count and Balance -->
      <div class="problem-stats">
        <div class="stat-card">
          <span class="stat-label">Избрани задачи:</span>
          <span class="stat-value" id="selected-count">0</span>
          <span class="stat-recommended">/ <span id="recommended-count">0</span> препорачани</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Тежина баланс:</span>
          <div class="difficulty-bar" id="difficulty-balance">
            <div class="diff-easy" style="width: 0%">0</div>
            <div class="diff-medium" style="width: 0%">0</div>
            <div class="diff-hard" style="width: 0%">0</div>
          </div>
        </div>
        <div class="stat-card">
          <span class="stat-label">Вкупно поени:</span>
          <span class="stat-value" id="total-points">0</span>
        </div>
      </div>

      <!-- Available Problems Grid -->
      <div class="problems-container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h3>Достапни задачи (<span class="problem-count" id="available-count">0</span>)</h3>
          <div style="display: flex; gap: 0.5rem;">
            <button class="btn-secondary" onclick="selectRandomProblems(10)" style="font-size: 0.85rem; padding: 0.5rem 0.75rem;">🎲 10 random</button>
            <button class="btn-secondary" onclick="selectAllVisible()" style="font-size: 0.85rem; padding: 0.5rem 0.75rem;">✅ Избери сите</button>
            <button class="btn-secondary" onclick="deselectAll()" style="font-size: 0.85rem; padding: 0.5rem 0.75rem;">❌ Откажи сите</button>
          </div>
        </div>
        <div class="problems-grid" id="problems-grid">
          <!-- Problems will be populated by JavaScript -->
        </div>
      </div>

      <!-- Filter Sidebar + Problem List Layout -->
      <div class="builder-layout">
        <div class="sidebar-col">
          <FilterSidebar />
        </div>
        
        <div class="content-col">
          <ProblemList />
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="action-buttons">
        <button class="btn-secondary" onclick="goBackToTemplates()">
          ← Назад кон templates
        </button>
        <button class="btn-primary" onclick="proceedToPreview()" id="btn-preview" disabled>
          Преглед → 
        </button>
      </div>
    </section>

    <!-- Step 3: Preview & Customize -->
    <section class="step-section" id="preview-section" style="display: none;">
      <div class="step-header">
        <span class="step-number">3</span>
        <h2>Преглед и приспособување</h2>
      </div>

      <!-- Worksheet Metadata -->
      <div class="worksheet-meta-form">
        <div class="form-row">
          <div class="form-group">
            <label for="worksheet-title">Наслов на worksheet:</label>
            <input 
              type="text" 
              id="worksheet-title" 
              placeholder="пр. Тест 1 - Триаголници"
              value=""
            />
          </div>
          <div class="form-group">
            <label for="worksheet-grade">Одделение:</label>
            <select id="worksheet-grade">
              <option value="6">6 одд.</option>
              <option value="7">7 одд.</option>
              <option value="8">8 одд.</option>
              <option value="9">9 одд.</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="teacher-name">Име на наставник:</label>
            <input 
              type="text" 
              id="teacher-name" 
              placeholder="Твое име"
              value=""
            />
          </div>
          <div class="form-group">
            <label for="time-limit">Време (минути):</label>
            <input 
              type="number" 
              id="time-limit" 
              min="5"
              max="180"
              value="45"
            />
          </div>
        </div>

        <div class="form-row">
          <div class="checkbox-group">
            <label>
              <input type="checkbox" id="include-answer-key" checked />
              Вклучи одговорен лист
            </label>
          </div>
          <div class="checkbox-group">
            <label>
              <input type="checkbox" id="show-work-space" checked />
              Прикажи простор за работа
            </label>
          </div>
          <div class="checkbox-group">
            <label>
              <input type="checkbox" id="show-bro-standards" />
              Прикажи БРО стандарди
            </label>
          </div>
        </div>
      </div>

      <!-- Preview -->
      <div class="worksheet-preview" id="worksheet-preview">
        <div class="preview-header">
          <h3>👀 Преглед на worksheet</h3>
          <button class="btn-refresh" onclick="refreshPreview()">🔄 Освежи</button>
        </div>
        <div class="preview-content" id="preview-content">
          <!-- Preview will be rendered here -->
        </div>
      </div>

      <!-- Export Buttons -->
      <div class="action-buttons">
        <button class="btn-secondary" onclick="goBackToProblems()">
          ← Назад кон задачи
        </button>
        <button class="btn-primary" onclick="generatePDF()">
          📥 Генерирај PDF
        </button>
        <button class="btn-success" onclick="saveWorksheet()">
          💾 Зачувај worksheet
        </button>
      </div>
    </section>
  </div>

  <!-- Export Modal Component -->
  <ExportModal />

  <style>
    .worksheet-builder {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
    }

    .hero {
      text-align: center;
      padding: 3rem 0;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 16px;
      color: white;
      margin-bottom: 3rem;
    }

    .hero h1 {
      font-size: 3rem;
      margin-bottom: 0.5rem;
    }

    .subtitle {
      font-size: 1.3rem;
      opacity: 0.95;
    }

    /* Step Section */
    .step-section {
      background: white;
      border-radius: 12px;
      padding: 2rem;
      margin-bottom: 2rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .step-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #e0e0e0;
    }

    .step-number {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 1.2rem;
    }

    /* Template Grid */
    .template-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .template-card {
      border: 1px solid #e0e0e0;
      border-radius: 12px;
      padding: 1.25rem;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      text-align: left;
      background: #ffffff;
      display: flex;
      flex-direction: column;
      height: 100%;
      position: relative;
      overflow: hidden;
    }

    .template-card:hover {
      border-color: #667eea;
      transform: translateY(-4px);
      box-shadow: 0 12px 24px -10px rgba(102, 126, 234, 0.2);
    }

    .template-card.selected {
      border-color: #667eea;
      background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
      border-width: 3px;
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .template-icon {
      font-size: 2rem;
      background: #f1f5f9;
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
    }

    .badge {
      font-size: 0.75rem;
      font-weight: 600;
      color: #64748b;
      background: #f8fafc;
      padding: 4px 10px;
      border-radius: 20px;
      border: 1px solid #e2e8f0;
    }

    .template-card h3 {
      font-size: 1.15rem;
      margin: 0 0 0.5rem 0;
      color: #2c3e50;
      font-weight: 700;
    }

    .template-desc {
      color: #7f8c8d;
      font-size: 0.875rem;
      margin-bottom: 1rem;
      line-height: 1.4;
    }
    
    .template-features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      margin-bottom: 1rem;
      padding: 0.75rem;
      background: #f8fafc;
      border-radius: 8px;
    }
    
    .feature-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
    }
    
    .feature-icon {
      font-size: 1rem;
    }
    
    .feature-text {
      color: #64748b;
      font-weight: 500;
    }

    .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid #f1f5f9;
      padding-top: 0.75rem;
      margin-top: auto;
      gap: 0.75rem;
    }
    
    .btn-select {
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: white;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }
    
    .btn-select:hover {
      transform: scale(1.05);
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }

    .meta-item {
      font-size: 0.8rem;
      font-weight: 500;
      color: #475569;
    }

    /* Difficulty Visualization (Inspired by Library) */
    .difficulty-viz {
      display: flex;
      width: 100px;
      height: 6px;
      border-radius: 3px;
      overflow: hidden;
      background: #e2e8f0;
    }

    .difficulty-viz .bar {
      height: 100%;
      transition: width 0.3s ease;
    }

    .bar-easy {
      background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
    }

    .bar-medium {
      background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
    }

    .bar-hard {
      background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%);
    }

    /* Loading State */
    .loading-state {
      text-align: center;
      padding: 3rem;
      color: #7f8c8d;
    }

    .spinner {
      border: 4px solid #f3f3f3;
      border-top: 4px solid #667eea;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      animation: spin 1s linear infinite;
      margin: 0 auto 1rem;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .error-state {
      text-align: center;
      padding: 3rem;
      color: #e74c3c;
    }

    .btn-retry {
      margin-top: 1rem;
      padding: 0.75rem 1.5rem;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      font-size: 1rem;
    }

    .btn-retry:hover {
      background: #5568d3;
    }

    /* Filters Panel */
    .filters-panel {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: flex-end;
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      min-width: 150px;
    }

    .filter-group label {
      font-weight: 600;
      color: #2c3e50;
      font-size: 0.9rem;
    }

    .filter-group select,
    .filter-group input {
      padding: 0.5rem;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 0.95rem;
    }

    .btn-filter-reset {
      padding: 0.5rem 1rem;
      background: #e74c3c;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
    }

    /* Problem Stats */
    .problem-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .stat-label {
      font-size: 0.9rem;
      color: #7f8c8d;
      font-weight: 600;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      color: #667eea;
    }

    .stat-recommended {
      font-size: 0.9rem;
      color: #95a5a6;
    }

    .difficulty-bar {
      display: flex;
      height: 30px;
      border-radius: 6px;
      overflow: hidden;
      background: #ecf0f1;
    }

    .diff-easy,
    .diff-medium,
    .diff-hard {
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      font-size: 0.85rem;
      transition: width 0.3s ease;
    }

    .diff-easy { background: #27ae60; }
    .diff-medium { background: #f39c12; }
    .diff-hard { background: #e74c3c; }

    /* Problems Grid */
    .problems-container {
      margin-bottom: 2rem;
    }

    .problems-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1rem;
      max-height: 600px;
      overflow-y: auto;
      padding: 1rem;
      background: #f8f9fa;
      border-radius: 8px;
    }

    /* Selected Problems */
    .selected-problems-container {
      margin-bottom: 2rem;
    }

    .selected-problems-list {
      min-height: 200px;
      background: #f8f9fa;
      border-radius: 8px;
      padding: 1rem;
    }

    .empty-state {
      text-align: center;
      color: #95a5a6;
      font-style: italic;
      padding: 3rem;
    }

    /* Form Elements */
    .worksheet-meta-form {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .form-group label {
      font-weight: 600;
      color: #2c3e50;
    }

    .form-group input,
    .form-group select {
      padding: 0.75rem;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 1rem;
    }

    .checkbox-group {
      display: flex;
      align-items: center;
    }

    .checkbox-group label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    }

    /* Preview */
    .worksheet-preview {
      background: white;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .preview-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e0e0e0;
    }

    .preview-content {
      background: white;
      padding: 2rem;
      min-height: 400px;
      border: 1px solid #e0e0e0;
      border-radius: 4px;
    }

    /* Action Buttons */
    .action-buttons {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding-top: 2rem;
      border-top: 2px solid #e0e0e0;
    }

    .btn-secondary,
    .btn-primary,
    .btn-success,
    .btn-refresh {
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-secondary {
      background: #95a5a6;
      color: white;
    }

    .btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }

    .btn-success {
      background: #27ae60;
      color: white;
    }

    .btn-refresh {
      background: #3498db;
      color: white;
      padding: 0.5rem 1rem;
      font-size: 0.9rem;
    }

    .btn-primary:disabled {
      background: #bdc3c7;
      cursor: not-allowed;
    }

    .btn-secondary:hover { background: #7f8c8d; }
    .btn-primary:hover:not(:disabled) { opacity: 0.9; }
    .btn-success:hover { background: #229954; }
    .btn-refresh:hover { background: #2980b9; }
    
    /* Problem Cards */
    .problem-card-mini {
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      padding: 1rem;
      cursor: pointer;
      transition: all 0.2s ease;
      background: white;
    }

    .problem-card-mini:hover {
      border-color: #667eea;
      transform: translateY(-2px);
      box-shadow: 0 2px 8px rgba(102, 126, 234, 0.2);
    }

    .problem-card-mini.selected {
      border-color: #27ae60;
      background: #27ae6010;
    }

    .problem-header {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }

    .badge {
