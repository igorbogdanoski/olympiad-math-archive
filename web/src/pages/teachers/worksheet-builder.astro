  <!-- Pass templates to inline script via window object -->
  <script define:vars={{ templates: WORKSHEET_TEMPLATES }}>
    window.WORKSHEET_TEMPLATES = templates;
  </script>

  <script is:inline>
    // ==========================================================================
    // WORKSHEET BUILDER - COMPLETE JAVASCRIPT LOGIC
    // Version: 2.0 with Drag & Drop, Export Modal, and Easter Eggs
    // ==========================================================================

    // --- GLOBAL STATE ---
    let currentProblems = []; // Problems in the worksheet (with order preserved)
    let selectedProblems = []; // For backward compatibility
    let allProblems = [];
    let currentTemplate = null;
    let worksheetTemplates = {
      weekly_test: {
        name: "Неделен тест",
        icon: "📝",
        description: "Кратка провера за завршена тема",
        problems: 5,
