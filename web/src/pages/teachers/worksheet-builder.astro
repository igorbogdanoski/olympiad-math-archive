    async function loadProblems() {
      console.log('[loadProblems] Starting to load problems...');
      try {
        // Fetch all problems with filters
        if (problemRenderer) {
          console.log('[loadProblems] Fetching from API...');
          const response = await problemRenderer.fetchProblems([], {
            limit: 1000,  // Get up to 1000 problems
            min_difficulty: 1,
            max_difficulty: 10
          });
          console.log('[loadProblems] API response:', response);
          
          // Normalize problem IDs (_id → id for MongoDB compatibility)
          allProblems = response.map(p => ({
            ...p,
            id: p._id || p.id || p.problem_id
          }));
          filteredProblems = [...allProblems];
          
          console.log(`[loadProblems] ✅ Loaded ${allProblems.length} problems from API`);
          updateProblemCount();
        } else {
          console.error('[loadProblems] ❌ problemRenderer is null!');
        }
      } catch (error) {
        console.warn('[loadProblems] ⚠️ API not available, loading from JSON fallback', error);
        // Fallback to JSON file
        try {
          const res = await fetch('/data/problems.json');
          const data = await res.json();
          allProblems = data.problems || [];
          filteredProblems = [...allProblems];
          console.log(`[loadProblems] ✅ Loaded ${allProblems.length} problems from JSON fallback`);
          updateProblemCount();
        } catch (fallbackError) {
          console.error('[loadProblems] ❌ Failed to load problems from fallback:', fallbackError);
          allProblems = [];
          filteredProblems = [];
        }
      }
    }

    function updateProblemCount() {
      const countElement = document.querySelector('.problem-count');
      if (countElement) {
        countElement.textContent = filteredProblems.length;
      }
      console.log(`[updateProblemCount] Updated count to ${filteredProblems.length}`);
    }

    // Step 1: Template Selection
    window.selectTemplate = function(templateId, element) {
      // Remove previous selection
      document.querySelectorAll('.template-card').forEach(card => {
        card.classList.remove('selected');
      });
      
      // Select new template
      element.classList.add('selected');
      selectedTemplate = templateId;
      
      // Get template details
      const template = worksheetTemplates[templateId];
      console.log('[selectTemplate] Selected template:', templateId, template);
      
      // Show problem selection after short delay
      setTimeout(() => {
