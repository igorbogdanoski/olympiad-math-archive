    // --- GROUP MANAGEMENT (Група А / Група Б) ---
    window.groups = {
      A: [],
      B: []
    };
    window.activeGroup = 'A';

    // Switch between Group A and Group B
    window.switchGroup = (group) => {
      console.log(`[switchGroup] Switching to Group ${group}`);
      window.activeGroup = group;
      
      // UI Update: Active Tab
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.group === group);
      });
      
      // Render the selected group
      currentProblems = window.groups[group];
      window.renderProblemList(currentProblems);
      
      // Update export button text
      const exportBtn = document.querySelector('.btn-success');
      if (exportBtn) {
        exportBtn.innerHTML = `🚀 Експортирај Група ${group} (${currentProblems.length})`;
      }
    };

    // Generate Group B (Variant Generator)
    window.generateGroupB = async () => {
      const btn = document.getElementById('btn-gen-variant');
      const originalText = btn.innerHTML;
      
      // Validation: Check if Group A has problems
      if (!window.groups.A || window.groups.A.length === 0) {
        alert("⚠️ Прво додајте задачи во Група А!");
        return;
      }

      // Loading State
      btn.innerHTML = '⚙️ Се генерира...';
      btn.disabled = true;
      
      // Show skeleton while generating
      document.getElementById('skeleton-loader').style.display = 'block';
      document.getElementById('worksheet-preview').style.display = 'none';

      try {
        console.log('[generateGroupB] Starting variant generation');
        
        // Strategy: 70% shuffled + 30% replaced with new random problems
        const groupA = window.groups.A;
        const totalCount = groupA.length;
        const replaceCount = Math.floor(totalCount * 0.3); // Replace 30%
        const keepCount = totalCount - replaceCount;
        
        // Shuffle Group A
        const shuffled = [...groupA].sort(() => Math.random() - 0.5);
        
        // Keep 70% of shuffled problems
        const kept = shuffled.slice(0, keepCount);
        
        // Replace 30% with new random problems (similar grade + difficulty)
        const replaced = [];
        for (let i = 0; i < replaceCount; i++) {
          const original = shuffled[keepCount + i];
          
          // Filter allProblems by similar criteria
          const candidates = allProblems.filter(p => 
            p.id !== original.id && // Different problem
            (p.grade || p.target_grade || 7) === (original.grade || original.target_grade || 7) && // Same grade
            (p.difficulty || 2) === (original.difficulty || 2) // Same difficulty
          );
          
          if (candidates.length > 0) {
            const randomPick = candidates[Math.floor(Math.random() * candidates.length)];
            replaced.push(randomPick);
          } else {
            // Fallback: Use the shuffled problem if no candidates found
            replaced.push(shuffled[keepCount + i]);
          }
        }
        
        // Combine and shuffle final list
        window.groups.B = [...kept, ...replaced].sort(() => Math.random() - 0.5);
        
        console.log(`[generateGroupB] Generated Group B: ${window.groups.B.length} problems (${kept.length} shuffled + ${replaced.length} replaced)`);
        
        // Hide skeleton, show results
        document.getElementById('skeleton-loader').style.display = 'none';
        document.getElementById('worksheet-preview').style.display = 'block';
        
        // Auto-switch to Group B
        window.switchGroup('B');
        
        // Success notification (mini confetti)
        if (window.confetti) {
          confetti({ 
            particleCount: 50, 
            origin: { x: 0.8, y: 0.2 },
            colors: ['#6366f1', '#8b5cf6', '#ec4899']
          });
        }
        
        // Auto-save Group B
        saveWorksheetDraft();
        
      } catch (error) {
        console.error('[generateGroupB] Error:', error);
        alert("❌ Грешка при генерирање на варијантата. Обидете се повторно.");
        
        // Hide skeleton
        document.getElementById('skeleton-loader').style.display = 'none';
        document.getElementById('worksheet-preview').style.display = 'block';
        
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    };

    // --- AUTO-SAVE DRAFTS ---
    let autoSaveTimeout;
    
    function saveWorksheetDraft() {
      const draft = {
        groups: window.groups,
        activeGroup: window.activeGroup,
        template: selectedTemplate,
        timestamp: new Date().toISOString(),
        metadata: {
          title: document.getElementById('worksheet-title')?.value || '',
          school: document.getElementById('school-name')?.value || '',
          teacher: document.getElementById('teacher-name')?.value || '',
          grade: document.getElementById('grade-select')?.value || ''
        }
      };
      
      localStorage.setItem('worksheet_draft', JSON.stringify(draft));
      
      // Show indicator briefly
      const indicator = document.getElementById('draft-indicator');
      if (indicator) {
        indicator.style.display = 'inline-block';
        
        // Hide after 2 seconds
        clearTimeout(autoSaveTimeout);
        autoSaveTimeout = setTimeout(() => {
          indicator.style.display = 'none';
        }, 2000);
      }
      
      console.log('[saveWorksheetDraft] Draft saved to localStorage');
    }
    
    function loadWorksheetDraft() {
      const draftStr = localStorage.getItem('worksheet_draft');
      if (!draftStr) return false;
      
      try {
        const draft = JSON.parse(draftStr);
        const draftDate = new Date(draft.timestamp);
        const hoursSince = (Date.now() - draftDate.getTime()) / (1000 * 60 * 60);
        
        // Only restore if draft is < 24 hours old
        if (hoursSince > 24) {
          localStorage.removeItem('worksheet_draft');
          return false;
        }
        
        // Ask user if they want to restore
        const lastSaved = draftDate.toLocaleString('mk-MK', {
          day: 'numeric',
          month: 'short',
          hour: '2-digit',
          minute: '2-digit'
        });
        
        const shouldRestore = confirm(
          `💾 Пронајдовме незавршен тест од ${lastSaved}.\n\n` +
          `Сакате ли да го вратите?`
        );
        
        if (!shouldRestore) {
          localStorage.removeItem('worksheet_draft');
          return false;
        }
        
        // Restore state
        window.groups = draft.groups || { A: [], B: [] };
        window.activeGroup = draft.activeGroup || 'A';
        selectedTemplate = draft.template;
        
        // Restore metadata
        if (draft.metadata) {
          if (draft.metadata.title) document.getElementById('worksheet-title').value = draft.metadata.title;
          if (draft.metadata.school) document.getElementById('school-name').value = draft.metadata.school;
          if (draft.metadata.teacher) document.getElementById('teacher-name').value = draft.metadata.teacher;
          if (draft.metadata.grade) document.getElementById('grade-select').value = draft.metadata.grade;
        }
        
        // Render restored group
        currentProblems = window.groups[window.activeGroup];
        window.renderProblemList(currentProblems);
        window.switchGroup(window.activeGroup);
        
        console.log('[loadWorksheetDraft] Draft restored successfully');
        return true;
        
      } catch (error) {
        console.error('[loadWorksheetDraft] Error restoring draft:', error);
        localStorage.removeItem('worksheet_draft');
        return false;
      }
    }
    
    // Auto-save on any problem list change
    function triggerAutoSave() {
      clearTimeout(autoSaveTimeout);
      autoSaveTimeout = setTimeout(() => {
        saveWorksheetDraft();
      }, 1000); // Save 1 second after last change
    }

    // --- FILTER INTEGRATION LOGIC ---
    
    // Collect all active filter values
    window.getFilters = () => {
      const gradeEl = document.getElementById('filter-grade');
      const topicEl = document.getElementById('filter-topic');
      const searchEl = document.getElementById('filter-search');
      const broEl = document.getElementById('filter-bro');
      const diffCheckboxes = document.querySelectorAll('.diff-chk:checked');
      
      return {
        grade: gradeEl ? parseInt(gradeEl.value) : null,
        topic: topicEl ? topicEl.value : '',
        search: searchEl ? searchEl.value.toLowerCase().trim() : '',
        bro_code: broEl ? broEl.value.trim() : '',
        difficulties: Array.from(diffCheckboxes).map(cb => parseInt(cb.value))
      };
    };

    // Apply filters to problem list (client-side filtering)
    window.applyFilters = (problems) => {
      if (!problems || !Array.isArray(problems)) {
        console.warn('[applyFilters] Invalid problems array:', problems);
        return [];
      }
      
      const filters = window.getFilters();
      let filtered = [...problems];
      
      // Filter by grade
      if (filters.grade) {
        filtered = filtered.filter(p => {
          const pGrade = p.grade || p.target_grade || 7; // Default to 7
          return pGrade === filters.grade;
        });
      }
      
      // Filter by topic
      if (filters.topic) {
        filtered = filtered.filter(p => {
          const pTopic = (p.topic || p.subject || '').toLowerCase();
          return pTopic.includes(filters.topic.toLowerCase());
        });
      }
      
      // Filter by search keyword (text content)
      if (filters.search) {
        filtered = filtered.filter(p => {
          const text = (p.text || p.content || '').toLowerCase();
          return text.includes(filters.search);
        });
      }
      
      // Filter by БРО code
      if (filters.bro_code) {
        filtered = filtered.filter(p => {
          const pBro = (p.bro_standard || p.bro || '').toUpperCase();
          return pBro.includes(filters.bro_code.toUpperCase());
        });
      }
      
      // Filter by difficulty
      if (filters.difficulties.length > 0 && filters.difficulties.length < 3) {
        filtered = filtered.filter(p => {
          const pDiff = p.difficulty || 2; // Default to medium
          return filters.difficulties.includes(pDiff);
        });
      }
      
      // Update filter summary
      updateFilterSummary(filtered.length, problems.length);
      
      return filtered;
    };

    // Update filter summary text
    function updateFilterSummary(filteredCount, totalCount) {
      const summaryEl = document.getElementById('filter-summary');
      if (!summaryEl) return;
      
      const summaryText = summaryEl.querySelector('.summary-text');
      if (!summaryText) return;
      
      if (filteredCount === totalCount) {
        summaryText.textContent = 'Се прикажуваат сите задачи';
      } else {
        summaryText.textContent = `Прикажани ${filteredCount} од ${totalCount} задачи`;
      }
    }

    // Debounced filter update (for search input)
    let filterTimeout;
    window.debounceFilterUpdate = () => {
      clearTimeout(filterTimeout);
      filterTimeout = setTimeout(() => {
        window.triggerFilterUpdate();
      }, 500); // Wait 500ms after typing stops
    };

    // Trigger filter update (immediate)
    window.triggerFilterUpdate = () => {
      console.log('[Filter] Triggering filter update');
      
      // If we have allProblems loaded, re-filter and render
      if (allProblems && allProblems.length > 0) {
        const filtered = window.applyFilters(allProblems);
        filteredProblems = filtered;
        renderProblems();
      }
      
      // If we have a template selected, re-run template selection with new filters
      if (selectedTemplate) {
        selectProblemsByTemplate(selectedTemplate);
      }
    };

    // Reset all filters to default
    window.resetFilters = () => {
      // Reset grade to 7
      const gradeInput = document.getElementById('filter-grade');
      if (gradeInput) gradeInput.value = '7';
      document.querySelectorAll('.grade-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.val === '7');
      });
      
      // Reset topic
      const topicEl = document.getElementById('filter-topic');
      if (topicEl) topicEl.value = '';
      
      // Reset search
      const searchEl = document.getElementById('filter-search');
      if (searchEl) searchEl.value = '';
      
      // Reset БРО
      const broEl = document.getElementById('filter-bro');
      if (broEl) broEl.value = '';
      
      // Check all difficulty checkboxes
      document.querySelectorAll('.diff-chk').forEach(chk => {
        chk.checked = true;
      });
      
      // Trigger update
      window.triggerFilterUpdate();
      
      console.log('[Filter] Reset all filters');
    };

    // --- TEMPLATE-BASED PROBLEM SELECTION WITH FILTERS ---
    
    // Select problems based on template + active filters
    function selectProblemsByTemplate(templateId) {
      const template = worksheetTemplates[templateId];
      if (!template) {
        console.error('[selectProblemsByTemplate] Template not found:', templateId);
        return;
      }
      
      console.log('[selectProblemsByTemplate] Selecting for template:', templateId, template);
      
      // Show skeleton while loading
      const skeletonLoader = document.getElementById('skeleton-loader');
      const worksheetPreview = document.getElementById('worksheet-preview');
      if (skeletonLoader) skeletonLoader.style.display = 'block';
      if (worksheetPreview) worksheetPreview.style.display = 'none';
      
      // Simulate a small delay for better UX (skeleton visibility)
      setTimeout(() => {
        // Apply filters first
        const filteredPool = window.applyFilters(allProblems);
        
        if (filteredPool.length === 0) {
          // Hide skeleton
          if (skeletonLoader) skeletonLoader.style.display = 'none';
          if (worksheetPreview) worksheetPreview.style.display = 'block';
          
          alert('⚠️ Нема задачи кои одговараат на филтрите. Обидете се со помалку филтри.');
          return;
        }
        
        // Calculate counts per difficulty
        const targetCount = template.problems;
      const easyCount = Math.floor(targetCount * template.difficulty.easy);
      const mediumCount = Math.floor(targetCount * template.difficulty.medium);
      const hardCount = targetCount - easyCount - mediumCount;
      
      // Categorize problems by difficulty
      const easy = filteredPool.filter(p => (p.difficulty || 2) <= 1);
      const medium = filteredPool.filter(p => (p.difficulty || 2) === 2);
      const hard = filteredPool.filter(p => (p.difficulty || 2) >= 3);
      
      // Shuffle and select
      const shuffle = arr => arr.sort(() => Math.random() - 0.5);
      
      const selectedEasy = shuffle([...easy]).slice(0, Math.min(easyCount, easy.length));
      const selectedMedium = shuffle([...medium]).slice(0, Math.min(mediumCount, medium.length));
      const selectedHard = shuffle([...hard]).slice(0, Math.min(hardCount, hard.length));
      
      // Combine and shuffle final list
      const selected = shuffle([...selectedEasy, ...selectedMedium, ...selectedHard]);
      
      console.log(`[selectProblemsByTemplate] Selected ${selected.length} problems (E:${selectedEasy.length} M:${selectedMedium.length} H:${selectedHard.length})`);
      
        // Hide skeleton, show results
        if (skeletonLoader) skeletonLoader.style.display = 'none';
        if (worksheetPreview) worksheetPreview.style.display = 'block';
        
        // Render the problem list
        window.renderProblemList(selected);
      }, 300); // 300ms delay for skeleton visibility
    }

    // --- 1. PROBLEM LIST RENDERING WITH DRAG & DROP ---
    window.renderProblemList = (problems) => {
      currentProblems = problems;
      selectedProblems = problems; // Keep for backward compatibility
      
      // Update active group in state
      window.groups[window.activeGroup] = problems;
      
      const container = document.getElementById('worksheet-preview');
      const countBadge = document.getElementById('problem-count-badge');
      const totalPointsDisplay = document.getElementById('total-points-display');
      
      if (!container) return;
      
      // Update count
      if (countBadge) countBadge.textContent = problems.length;
      
      // Update total points
      const totalPoints = problems.reduce((sum, p) => sum + (p.points || 5), 0);
      if (totalPointsDisplay) totalPointsDisplay.textContent = totalPoints;
      
      // Check for Perfect 100 Easter Egg
      checkPerfectScore(problems);

      // Update export button text (include group indicator)
      const exportBtn = document.querySelector('.btn-success');
      if (exportBtn) {
        exportBtn.innerHTML = `🚀 Експортирај Група ${window.activeGroup} (${problems.length})`;
      }

      // Auto-save draft
      triggerAutoSave();

      // Clear container
      container.innerHTML = '';

      if (problems.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <div class="empty-icon">📋</div>
            <p>Изберете темплејт за да генерирате задачи</p>
          </div>
        `;
        return;
      }

      // Generate HTML for each problem
      problems.forEach((problem, index) => {
        const difficulty = problem.difficulty || 2;
        const difficultyLabels = ['Лесно', 'Лесно', 'Средно', 'Тешко', 'Олимписко'];
        const difficultyClasses = ['easy', 'easy', 'medium', 'hard', 'hard'];
        const difficultyLabel = difficultyLabels[difficulty] || 'Средно';
        const difficultyClass = difficultyClasses[difficulty] || 'medium';

        const div = document.createElement('div');
        div.className = 'problem-card';
        div.dataset.id = problem.id;
        
        // Extract text from various sources
        let displayText = '';
        if (problem.content_markdown) {
          // Remove markdown headers and extract first paragraph
          displayText = problem.content_markdown
            .split('\n\n')[1] || problem.content_markdown.split('\n')[0];
          displayText = displayText.replace(/^#+\s*/g, '').replace(/\*\*/g, '').substring(0, 150);
        } else if (problem.statement) {
          displayText = problem.statement.substring(0, 150);
        } else if (problem.text) {
          displayText = problem.text.substring(0, 150);
        } else if (problem.content) {
          displayText = problem.content.substring(0, 150);
        } else {
          displayText = problem.title || `Задача ${problem.problem_id || problem.id}`;
        }
        
        div.innerHTML = `
          <div class="drag-handle" title="Премести">⋮⋮</div>
          <div class="problem-content">
            <div class="problem-text">${displayText}${displayText.length >= 150 ? '...' : ''}</div>
            <div class="problem-meta">
              <span class="tag ${difficultyClass}">${difficultyLabel}</span>
              <span class="tag">📝 ${problem.topic || problem.subject || problem.tags?.[0] || 'Алгебра'}</span>
              <span class="tag points">${problem.points || 5} поени</span>
            </div>
          </div>
          <div class="problem-actions">
            <button class="action-btn" onclick="window.replaceProblem(${problem.id})" title="Замени со друга">🔄</button>
            <button class="action-btn delete" onclick="window.removeProblem(${problem.id})" title="Избриши">🗑️</button>
          </div>
        `;
        container.appendChild(div);
      });

      // Initialize SortableJS
      initSortable();
    };

    // --- 2. DRAG & DROP INITIALIZATION ---
    function initSortable() {
      const el = document.getElementById('worksheet-preview');
      if (!el) return;

      // Kill old instance if exists (to avoid memory leaks)
      if (window.sortableInstance) {
        try {
          window.sortableInstance.destroy();
        } catch (e) {
          console.warn('Failed to destroy old Sortable instance:', e);
        }
      }

      window.sortableInstance = new Sortable(el, {
        animation: 150,
        handle: '.drag-handle',
        ghostClass: 'sortable-ghost',
        onEnd: function (evt) {
          // Update internal array order after drag
          const item = currentProblems.splice(evt.oldIndex, 1)[0];
          currentProblems.splice(evt.newIndex, 0, item);
          selectedProblems = currentProblems; // Keep synced
          console.log('Нов редослед:', currentProblems.map(p => p.id));
        },
      });
    }

    // --- 3. PROBLEM ACTIONS: REMOVE & REPLACE ---
    window.removeProblem = (id) => {
      currentProblems = currentProblems.filter(p => p.id !== id);
      selectedProblems = currentProblems;
      window.renderProblemList(currentProblems);
    };

    window.replaceProblem = async (id) => {
      // Find the problem to replace
      const oldProblem = currentProblems.find(p => p.id === id);
      if (!oldProblem) return;

      const btn = document.querySelector(`[data-id="${id}"] .action-btn`);
      if (btn) btn.innerHTML = '⏳';

      try {
        // Filter problems with same difficulty and different ID
        const candidates = allProblems.filter(p => 
          p.id !== id && 
          p.difficulty === oldProblem.difficulty &&
          !currentProblems.find(cp => cp.id === p.id) // Not already selected
        );

        if (candidates.length === 0) {
          alert('Нема други задачи со иста тежина.');
          if (btn) btn.innerHTML = '🔄';
          return;
        }

        // Pick random candidate
        const newProblem = candidates[Math.floor(Math.random() * candidates.length)];

        // Replace in array
        const index = currentProblems.findIndex(p => p.id === id);
        currentProblems[index] = newProblem;
        selectedProblems = currentProblems;
        
        // Re-render
        window.renderProblemList(currentProblems);
      } catch (e) {
        console.error('Replace error:', e);
        alert("Не можев да најдам замена во моментов.");
        if (btn) btn.innerHTML = '🔄';
      }
    };

    // --- 4. EXPORT MODAL CONTROL ---
    window.openExportModal = () => {
      if (currentProblems.length === 0) {
        alert('⚠️ Изберете барем еден проблем пред да експортирате!');
        return;
      }
      
      // Calculate and display total points
      const total = currentProblems.reduce((sum, p) => sum + (p.points || 5), 0);
      const display = document.getElementById('total-points-display');
      if (display) display.innerText = total;
      
      const modal = document.getElementById('export-modal');
      if (modal) modal.classList.remove('hidden');
    };

    window.closeExportModal = () => {
      const modal = document.getElementById('export-modal');
      if (modal) modal.classList.add('hidden');
    };

    // --- 5. FINAL PDF GENERATION ---
    window.generateFinalPDF = async () => {
      const btn = document.querySelector('.btn-primary.large');
      const status = document.getElementById('export-status');
      const btnText = btn?.querySelector('.btn-text');
      const btnLoader = btn?.querySelector('.btn-loader');
      
      if (!btn) return;
      
      const originalHtml = btn.innerHTML;

      // UI Loading State
      btn.disabled = true;
      if (btnText) btnText.classList.add('hidden');
      if (btnLoader) btnLoader.classList.remove('hidden');
      if (status) status.innerText = "Подготовка на податоци...";

      try {
        // Gather data
        const titleInput = document.getElementById('worksheet-title');
        const payload = {
          title: titleInput?.value || 'Работен Лист по Математика',
          tasks: currentProblems.map((p, idx) => ({
            id: p.id,
            number: idx + 1,
            text: p.text || p.content || 'No content',
            image: p.image_url || p.image || null,
            points: p.points || 5,
            bro_standard: p.bro_standard || ""
          })),
          options: {
            solutions: document.getElementById('opt-solutions')?.checked || false,
            workspace: document.getElementById('opt-space')?.checked || true,
            bro_codes: document.getElementById('opt-bro')?.checked || false,
            qr_code: document.getElementById('opt-qr')?.checked || false
          },
          labels: {
            school: "Училиште:",
            teacher: "Наставник:",
            grade: "Одделение:",
            student: "Ученик:",
            date: "Датум:"
          }
        };

        if (status) status.innerText = "Испраќање до сервер...";

        // API Call
        const API_BASE = window.location.hostname === 'localhost' 
          ? 'http://localhost:8000/api'
          : '/api';
          
        const response = await fetch(`${API_BASE}/worksheet/generate-pdf`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          const errorText = await response.text();
          throw new Error(`Server error: ${response.status} - ${errorText}`);
        }

        if (status) status.innerText = "Преземање...";

        // Handle PDF Blob (Download)
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Worksheet_${new Date().toISOString().slice(0,10)}.pdf`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        a.remove();

        // Success State
        if (status) status.innerText = "✅ Успешно!";
        setTimeout(() => window.closeExportModal(), 1500);

      } catch (error) {
        console.error('PDF Generation Error:', error);
        if (status) status.innerText = "❌ Грешка при генерирање.";
        alert(`Грешка: ${error.message}\n\nПроверете ја конзолата за детали.`);
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      }
    };

