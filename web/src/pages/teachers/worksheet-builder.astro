---
// Worksheet Builder Page
// Created: February 2, 2026
// Purpose: Teacher interface for creating custom worksheets
import Layout from '../../layouts/Layout.astro';
import { WORKSHEET_TEMPLATES } from '../../data/worksheet_templates';

// Load problems data for filtering
import problemsData from '../../data/problems.json';
const problems = problemsData.problems || [];

// Calculate statistics
const geometryProblems = problems.filter(p => p.topic?.toLowerCase().includes('geometry') || p.subject === 'geometry');
const algebraProblems = problems.filter(p => p.topic?.toLowerCase().includes('algebra') || p.subject === 'algebra');
const totalProblems = problems.length;
---

<Layout 
  title="Креирај работен лист | Olympiad Math Archive"
  description="Креирај персонализиран работен лист за твојот час"
>
  <!-- KaTeX CSS for math rendering -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
  
  <!-- Problem Renderer Script -->
  <script is:inline src="/src/scripts/worksheet-problem-renderer.js"></script>
  
  <!-- KaTeX Scripts -->
  <script defer is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script defer is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
  
  <!-- Sortable.js for drag-and-drop -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

  <div class="worksheet-builder">
    <!-- Hero Section -->
    <section class="hero">
      <h1>📄 Worksheet Builder</h1>
      <p class="subtitle">Креирај професионален работен лист за 5 минути</p>
    </section>

    <!-- Step 1: Template Selection -->
    <section class="step-section">
      <div class="step-header">
        <span class="step-number">1</span>
        <h2>Избери template</h2>
      </div>
      
      <div class="template-grid">
        {WORKSHEET_TEMPLATES.map((template) => (
          <div 
            class="template-card" 
            data-template-id={template.id}
            onclick="selectTemplate(this)"
          >
            <div class="template-icon">
              {template.id === 'test' && '📝'}
              {template.id === 'quiz' && '❓'}
              {template.id === 'homework' && '📚'}
              {template.id === 'practice' && '✏️'}
              {template.id === 'warm_up' && '🔥'}
              {template.id === 'review' && '🔄'}
              {template.id === 'challenge' && '🏆'}
              {template.id === 'exam' && '📋'}
              {template.id === 'diagnostic' && '🔍'}
              {template.id === 'formative' && '📊'}
              {template.id === 'summative' && '✅'}
              {template.id === 'project' && '🎯'}
              {template.id === 'investigation' && '🔬'}
              {template.id === 'exploration' && '🗺️'}
              {template.id === 'mixed' && '🎲'}
            </div>
            <h3>{template.name_mk}</h3>
            <p class="template-desc">{template.description_mk}</p>
            <div class="template-meta">
              <span class="meta-item">
                <strong>{template.recommended_problems}</strong> задачи
              </span>
              <span class="meta-item">
                <strong>{template.recommended_time_minutes}</strong> мин
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Step 2: Problem Selection -->
    <section class="step-section" id="problem-selection" style="display: none;">
      <div class="step-header">
        <span class="step-number">2</span>
        <h2>Избери задачи</h2>
      </div>

      <!-- Filters -->
      <div class="filters-panel">
        <div class="filter-group">
          <label>Предмет:</label>
          <select id="filter-subject" onchange="applyFilters()">
            <option value="">Сите</option>
            <option value="geometry">Геометрија ({geometryProblems.length})</option>
            <option value="algebra">Алгебра ({algebraProblems.length})</option>
            <option value="number_theory">Теорија на броеви</option>
            <option value="combinatorics">Комбинаторика</option>
          </select>
        </div>

        <div class="filter-group">
          <label>Одделение:</label>
          <select id="filter-grade" onchange="applyFilters()">
            <option value="">Сите</option>
            <option value="6">6 одд.</option>
            <option value="7">7 одд.</option>
            <option value="8">8 одд.</option>
            <option value="9">9 одд.</option>
          </select>
        </div>

        <div class="filter-group">
          <label>Тежина:</label>
          <select id="filter-difficulty" onchange="applyFilters()">
            <option value="">Сите</option>
            <option value="easy">Лесно</option>
            <option value="medium">Средно</option>
            <option value="hard">Тешко</option>
          </select>
        </div>

        <div class="filter-group">
          <label>БРО Стандард:</label>
          <input 
            type="text" 
            id="filter-bro" 
            placeholder="М.6.2.1"
            onkeyup="applyFilters()"
          />
        </div>

        <button class="btn-filter-reset" onclick="resetFilters()">
          Reset филтри
        </button>
      </div>

      <!-- Problem Count and Balance -->
      <div class="problem-stats">
        <div class="stat-card">
          <span class="stat-label">Избрани задачи:</span>
          <span class="stat-value" id="selected-count">0</span>
          <span class="stat-recommended">/ <span id="recommended-count">0</span> препорачани</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Тежина баланс:</span>
          <div class="difficulty-bar" id="difficulty-balance">
            <div class="diff-easy" style="width: 0%">0</div>
            <div class="diff-medium" style="width: 0%">0</div>
            <div class="diff-hard" style="width: 0%">0</div>
          </div>
        </div>
        <div class="stat-card">
          <span class="stat-label">Вкупно поени:</span>
          <span class="stat-value" id="total-points">0</span>
        </div>
      </div>

      <!-- Available Problems Grid -->
      <div class="problems-container">
        <h3>Достапни задачи (<span id="available-count">{totalProblems}</span>)</h3>
        <div class="problems-grid" id="problems-grid">
          <!-- Problems will be populated by JavaScript -->
        </div>
      </div>

      <!-- Selected Problems -->
      <div class="selected-problems-container">
        <h3>Избрани задачи за worksheet (<span id="selected-problems-count">0</span>)</h3>
        <div class="selected-problems-list" id="selected-problems-list">
          <p class="empty-state">Избери задачи од листата погоре...</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="action-buttons">
        <button class="btn-secondary" onclick="goBackToTemplates()">
          ← Назад кон templates
        </button>
        <button class="btn-primary" onclick="proceedToPreview()" id="btn-preview" disabled>
          Преглед → 
        </button>
      </div>
    </section>

    <!-- Step 3: Preview & Customize -->
    <section class="step-section" id="preview-section" style="display: none;">
      <div class="step-header">
        <span class="step-number">3</span>
        <h2>Преглед и приспособување</h2>
      </div>

      <!-- Worksheet Metadata -->
      <div class="worksheet-meta-form">
        <div class="form-row">
          <div class="form-group">
            <label for="worksheet-title">Наслов на worksheet:</label>
            <input 
              type="text" 
              id="worksheet-title" 
              placeholder="пр. Тест 1 - Триаголници"
              value=""
            />
          </div>
          <div class="form-group">
            <label for="worksheet-grade">Одделение:</label>
            <select id="worksheet-grade">
              <option value="6">6 одд.</option>
              <option value="7">7 одд.</option>
              <option value="8">8 одд.</option>
              <option value="9">9 одд.</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="teacher-name">Име на наставник:</label>
            <input 
              type="text" 
              id="teacher-name" 
              placeholder="Твое име"
              value=""
            />
          </div>
          <div class="form-group">
            <label for="time-limit">Време (минути):</label>
            <input 
              type="number" 
              id="time-limit" 
              min="5"
              max="180"
              value="45"
            />
          </div>
        </div>

        <div class="form-row">
          <div class="checkbox-group">
            <label>
              <input type="checkbox" id="include-answer-key" checked />
              Вклучи одговорен лист
            </label>
          </div>
          <div class="checkbox-group">
            <label>
              <input type="checkbox" id="show-work-space" checked />
              Прикажи простор за работа
            </label>
          </div>
          <div class="checkbox-group">
            <label>
              <input type="checkbox" id="show-bro-standards" />
              Прикажи БРО стандарди
            </label>
          </div>
        </div>
      </div>

      <!-- Preview -->
      <div class="worksheet-preview" id="worksheet-preview">
        <div class="preview-header">
          <h3>👀 Преглед на worksheet</h3>
          <button class="btn-refresh" onclick="refreshPreview()">🔄 Освежи</button>
        </div>
        <div class="preview-content" id="preview-content">
          <!-- Preview will be rendered here -->
        </div>
      </div>

      <!-- Export Buttons -->
      <div class="action-buttons">
        <button class="btn-secondary" onclick="goBackToProblems()">
          ← Назад кон задачи
        </button>
        <button class="btn-primary" onclick="generatePDF()">
          📥 Генерирај PDF
        </button>
        <button class="btn-success" onclick="saveWorksheet()">
          💾 Зачувај worksheet
        </button>
      </div>
    </section>
  </div>

  <style>
    .worksheet-builder {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
    }

    .hero {
      text-align: center;
      padding: 3rem 0;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 16px;
      color: white;
      margin-bottom: 3rem;
    }

    .hero h1 {
      font-size: 3rem;
      margin-bottom: 0.5rem;
    }

    .subtitle {
      font-size: 1.3rem;
      opacity: 0.95;
    }

    /* Step Section */
    .step-section {
      background: white;
      border-radius: 12px;
      padding: 2rem;
      margin-bottom: 2rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .step-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #e0e0e0;
    }

    .step-number {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 1.2rem;
    }

    /* Template Grid */
    .template-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .template-card {
      border: 2px solid #e0e0e0;
      border-radius: 12px;
      padding: 1.5rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-align: center;
    }

    .template-card:hover {
      border-color: #667eea;
      transform: translateY(-4px);
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.2);
    }

    .template-card.selected {
      border-color: #667eea;
      background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
      border-width: 3px;
    }

    .template-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .template-card h3 {
      font-size: 1.3rem;
      margin-bottom: 0.5rem;
      color: #2c3e50;
    }

    .template-desc {
      color: #7f8c8d;
      font-size: 0.9rem;
      margin-bottom: 1rem;
    }

    .template-meta {
      display: flex;
      justify-content: space-around;
      padding-top: 1rem;
      border-top: 1px solid #e0e0e0;
    }

    .meta-item {
      font-size: 0.85rem;
      color: #34495e;
    }

    /* Filters Panel */
    .filters-panel {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: flex-end;
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      min-width: 150px;
    }

    .filter-group label {
      font-weight: 600;
      color: #2c3e50;
      font-size: 0.9rem;
    }

    .filter-group select,
    .filter-group input {
      padding: 0.5rem;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 0.95rem;
    }

    .btn-filter-reset {
      padding: 0.5rem 1rem;
      background: #e74c3c;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
    }

    /* Problem Stats */
    .problem-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .stat-label {
      font-size: 0.9rem;
      color: #7f8c8d;
      font-weight: 600;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      color: #667eea;
    }

    .stat-recommended {
      font-size: 0.9rem;
      color: #95a5a6;
    }

    .difficulty-bar {
      display: flex;
      height: 30px;
      border-radius: 6px;
      overflow: hidden;
      background: #ecf0f1;
    }

    .diff-easy,
    .diff-medium,
    .diff-hard {
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      font-size: 0.85rem;
      transition: width 0.3s ease;
    }

    .diff-easy { background: #27ae60; }
    .diff-medium { background: #f39c12; }
    .diff-hard { background: #e74c3c; }

    /* Problems Grid */
    .problems-container {
      margin-bottom: 2rem;
    }

    .problems-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1rem;
      max-height: 600px;
      overflow-y: auto;
      padding: 1rem;
      background: #f8f9fa;
      border-radius: 8px;
    }

    /* Selected Problems */
    .selected-problems-container {
      margin-bottom: 2rem;
    }

    .selected-problems-list {
      min-height: 200px;
      background: #f8f9fa;
      border-radius: 8px;
      padding: 1rem;
    }

    .empty-state {
      text-align: center;
      color: #95a5a6;
      font-style: italic;
      padding: 3rem;
    }

    /* Form Elements */
    .worksheet-meta-form {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .form-group label {
      font-weight: 600;
      color: #2c3e50;
    }

    .form-group input,
    .form-group select {
      padding: 0.75rem;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 1rem;
    }

    .checkbox-group {
      display: flex;
      align-items: center;
    }

    .checkbox-group label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    }

    /* Preview */
    .worksheet-preview {
      background: white;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .preview-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e0e0e0;
    }

    .preview-content {
      background: white;
      padding: 2rem;
      min-height: 400px;
      border: 1px solid #e0e0e0;
      border-radius: 4px;
    }

    /* Action Buttons */
    .action-buttons {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding-top: 2rem;
      border-top: 2px solid #e0e0e0;
    }

    .btn-secondary,
    .btn-primary,
    .btn-success,
    .btn-refresh {
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-secondary {
      background: #95a5a6;
      color: white;
    }

    .btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }

    .btn-success {
      background: #27ae60;
      color: white;
    }

    .btn-refresh {
      background: #3498db;
      color: white;
      padding: 0.5rem 1rem;
      font-size: 0.9rem;
    }

    .btn-primary:disabled {
      background: #bdc3c7;
      cursor: not-allowed;
    }

    .btn-secondary:hover { background: #7f8c8d; }
    .btn-primary:hover:not(:disabled) { opacity: 0.9; }
    .btn-success:hover { background: #229954; }
    .btn-refresh:hover { background: #2980b9; }
    
    /* Problem Cards */
    .problem-card-mini {
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      padding: 1rem;
      cursor: pointer;
      transition: all 0.2s ease;
      background: white;
    }

    .problem-card-mini:hover {
      border-color: #667eea;
      transform: translateY(-2px);
      box-shadow: 0 2px 8px rgba(102, 126, 234, 0.2);
    }

    .problem-card-mini.selected {
      border-color: #27ae60;
      background: #27ae6010;
    }

    .problem-header {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }

    .badge {
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .badge-easy { background: #27ae60; color: white; }
    .badge-medium { background: #f39c12; color: white; }
    .badge-hard { background: #e74c3c; color: white; }
    .badge-grade { background: #3498db; color: white; }

    .problem-title {
      font-size: 0.9rem;
      color: #2c3e50;
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }

    .problem-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.75rem;
      color: #7f8c8d;
    }

    .bro-tag,
    .points-tag {
      padding: 0.2rem 0.4rem;
      background: #ecf0f1;
      border-radius: 3px;
    }

    /* Problem Card (Full - for selected problems) */
    .problem-card {
      /* Styles handled by renderer */
    }

    .drag-handle {
      cursor: move !important;
    }

    .math-inline {
      display: inline-block;
    }

    .math-display {
      display: block;
      text-align: center;
      margin: 1rem 0;
    }
  </style>

  <script>
    // Global state
    let selectedTemplate = null;
    let selectedProblems = [];
    let allProblems = [];
    let filteredProblems = [];
    let problemRenderer = null;

    // Initialize problem renderer
    document.addEventListener('DOMContentLoaded', () => {
      const apiBase = window.location.hostname === 'localhost' 
        ? 'http://localhost:8000'
        : ''; // Use nginx proxy in production
      
      problemRenderer = new WorksheetProblemRenderer(apiBase);
      
      // Load problems data (fallback to JSON if API not available)
      loadProblems();
    });

    async function loadProblems() {
      try {
        // Try to fetch from API first
        if (problemRenderer) {
          const response = await problemRenderer.fetchProblems([]);
          allProblems = response;
          filteredProblems = [...allProblems];
        }
      } catch (error) {
        console.warn('API not available, loading from JSON fallback');
        // Fallback to JSON file
        fetch('/data/problems.json')
          .then(res => res.json())
          .then(data => {
            allProblems = data.problems || [];
            filteredProblems = [...allProblems];
          });
      }
    }

    // Step 1: Template Selection
    function selectTemplate(element) {
      // Remove previous selection
      document.querySelectorAll('.template-card').forEach(card => {
        card.classList.remove('selected');
      });
      
      // Select new template
      element.classList.add('selected');
      selectedTemplate = element.dataset.templateId;
      
      // Show problem selection after short delay
      setTimeout(() => {
        document.getElementById('problem-selection').style.display = 'block';
        document.getElementById('problem-selection').scrollIntoView({ behavior: 'smooth' });
        
        // Update recommended count
        const template = WORKSHEET_TEMPLATES.find(t => t.id === selectedTemplate);
        if (template) {
          document.getElementById('recommended-count').textContent = template.recommended_problems;
        }
        
        // Load problems
        renderProblems();
      }, 300);
    }

    // Step 2: Problem Selection and Filtering
    function applyFilters() {
      const subject = document.getElementById('filter-subject').value;
      const grade = document.getElementById('filter-grade').value;
      const difficulty = document.getElementById('filter-difficulty').value;
      const bro = document.getElementById('filter-bro').value.toLowerCase();

      filteredProblems = allProblems.filter(problem => {
        if (subject && problem.subject !== subject) return false;
        if (grade && !problem.grade_range?.includes(parseInt(grade))) return false;
        if (difficulty && problem.difficulty !== difficulty) return false;
        if (bro && !problem.bro_standards?.some(s => s.toLowerCase().includes(bro))) return false;
        return true;
      });

      renderProblems();
    }

    function resetFilters() {
      document.getElementById('filter-subject').value = '';
      document.getElementById('filter-grade').value = '';
      document.getElementById('filter-difficulty').value = '';
      document.getElementById('filter-bro').value = '';
      filteredProblems = [...allProblems];
      renderProblems();
    }

    function renderProblems() {
      const grid = document.getElementById('problems-grid');
      document.getElementById('available-count').textContent = filteredProblems.length;
      
      if (!problemRenderer || filteredProblems.length === 0) {
        grid.innerHTML = '<p style="padding: 2rem; text-align: center; color: #95a5a6;">Нема достапни задачи...</p>';
        return;
      }
      
      // Render problem cards (simplified version for selection)
      grid.innerHTML = filteredProblems.slice(0, 50).map(problem => `
        <div class="problem-card-mini" onclick="addProblem(${problem.id})">
          <div class="problem-header">
            <span class="badge badge-${problem.difficulty}">${problem.difficulty || 'medium'}</span>
            <span class="badge badge-grade">Одд. ${problem.grade || 'N/A'}</span>
          </div>
          <div class="problem-title">${problem.title || problem.content?.substring(0, 60) + '...' || 'Задача #' + problem.id}</div>
          <div class="problem-meta">
            ${problem.primary_skill ? `<span class="bro-tag">${problem.primary_skill.substring(0, 8)}</span>` : ''}
            <span class="points-tag">${problem.points || 3} поени</span>
          </div>
        </div>
      `).join('');
      
      // Highlight already selected problems
      selectedProblems.forEach(p => {
        const card = grid.querySelector(`[onclick="addProblem(${p.id})"]`);
        if (card) card.classList.add('selected');
      });
    }

    function addProblem(problemId) {
      const problem = filteredProblems.find(p => p.id === problemId);
      if (!problem) return;
      
      // Check if already added
      if (selectedProblems.find(p => p.id === problemId)) {
        removeProblem(problemId);
        return;
      }
      
      selectedProblems.push(problem);
      updateSelectedProblems();
      renderProblems(); // Re-render to update selection state
    }

    function removeProblem(problemId) {
      selectedProblems = selectedProblems.filter(p => p.id !== problemId);
      updateSelectedProblems();
      renderProblems();
    }

    function updateSelectedProblems() {
      const container = document.getElementById('selected-problems-list');
      const countSpan = document.getElementById('selected-problems-count');
      const selectedCountSpan = document.getElementById('selected-count');
      
      countSpan.textContent = selectedProblems.length;
      selectedCountSpan.textContent = selectedProblems.length;
      
      if (selectedProblems.length === 0) {
        container.innerHTML = '<p class="empty-state">Избери задачи од листата погоре...</p>';
        document.getElementById('btn-preview').disabled = true;
        return;
      }
      
      // Render selected problems using renderer
      if (problemRenderer) {
        problemRenderer.renderProblems('selected-problems-list', selectedProblems);
        
        // Initialize drag-and-drop
        initializeSortable();
        
        // Update statistics
        updateStatistics();
      }
      
      document.getElementById('btn-preview').disabled = false;
    }

    function initializeSortable() {
      const container = document.getElementById('selected-problems-list');
      if (container && typeof Sortable !== 'undefined') {
        Sortable.create(container, {
          animation: 150,
          handle: '.drag-handle',
          onEnd: function(evt) {
            // Reorder problems array
            const movedProblem = selectedProblems[evt.oldIndex];
            selectedProblems.splice(evt.oldIndex, 1);
            selectedProblems.splice(evt.newIndex, 0, movedProblem);
            
            // Re-render with new order
            updateSelectedProblems();
          }
        });
      }
    }

    function updateStatistics() {
      if (!problemRenderer) return;
      
      const stats = problemRenderer.calculateStats(selectedProblems);
      
      // Update points
      document.getElementById('total-points').textContent = stats.totalPoints;
      
      // Update difficulty balance
      const total = stats.count;
      const easyPercent = (stats.difficulty.easy / total * 100) || 0;
      const mediumPercent = (stats.difficulty.medium / total * 100) || 0;
      const hardPercent = (stats.difficulty.hard / total * 100) || 0;
      
      const difficultyBar = document.getElementById('difficulty-balance');
      difficultyBar.innerHTML = `
        <div class="diff-easy" style="width: ${easyPercent}%">${stats.difficulty.easy}</div>
        <div class="diff-medium" style="width: ${mediumPercent}%">${stats.difficulty.medium}</div>
        <div class="diff-hard" style="width: ${hardPercent}%">${stats.difficulty.hard}</div>
      `;
    }

    // Make removeProblem globally accessible
    window.removeProblem = removeProblem;

    function goBackToTemplates() {
      document.getElementById('problem-selection').style.display = 'none';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function proceedToPreview() {
      document.getElementById('preview-section').style.display = 'block';
      document.getElementById('preview-section').scrollIntoView({ behavior: 'smooth' });
      refreshPreview();
    }

    function goBackToProblems() {
      document.getElementById('preview-section').style.display = 'none';
      document.getElementById('problem-selection').scrollIntoView({ behavior: 'smooth' });
    }

    function refreshPreview() {
      const previewContent = document.getElementById('preview-content');
      previewContent.innerHTML = '<p style="text-align: center; color: #95a5a6; padding: 3rem;">Preview rendering coming next...</p>';
    }

    function generatePDF() {
      alert('PDF generation coming next! 🎉');
    }

    function saveWorksheet() {
      alert('Worksheet save functionality coming next! 💾');
    }
  </script>
</Layout>
