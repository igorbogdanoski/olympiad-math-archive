---
import Layout from '../../layouts/Layout.astro';
import QuizGeneratorContainer from '../../components/QuizGeneratorContainer.svelte';
import curriculumData from '../../data/curriculum_standards_processed.json';

const pageTitle = "Генератор на Квизови | МатАрхива";
const pageDescription = "Создавајте професионални квизови со повеќе формати, автоматско балансирање на тежина и решенија.";
---

<Layout title={pageTitle}>
	<meta name="description" content={pageDescription} />

	<div class="max-w-6xl mx-auto px-4 py-12">
		<!-- Hero Section -->
		<div class="text-center mb-16 space-y-4">
			<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 text-xs font-black uppercase tracking-widest border border-purple-500/20 backdrop-blur-md">
				<span class="relative flex h-2 w-2">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
				</span>
				Quiz Generator Pro
			</div>
			
			<h1 class="text-4xl md:text-6xl font-black text-slate-900 dark:text-white leading-tight">
				Креирајте <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-pink-600">Квизови</span> за Секунди
			</h1>
			
			<p class="text-slate-500 dark:text-slate-400 text-xl max-w-3xl mx-auto font-medium">
				Повеќекратен избор, Точно/Неточно, Кратки одговори и Есеј формати. Автоматско балансирање на тежина и решенија.
			</p>
		</div>

		<!-- Main Tool Container -->
		<QuizGeneratorContainer curriculumData={curriculumData} client:load />

		<!-- Features Grid -->
		<div class="mt-24 grid grid-cols-1 md:grid-cols-4 gap-6">
			<div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-800">
				<div class="w-10 h-10 bg-purple-100 dark:bg-purple-900/30 rounded-xl flex items-center justify-center text-xl mb-4">
					🔘
				</div>
				<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Повеќе Формати</h3>
				<p class="text-slate-500 dark:text-slate-400 text-sm">
					MC, T/F, Short Answer, Essay
				</p>
			</div>

			<div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-800">
				<div class="w-10 h-10 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center text-xl mb-4">
					⚖️
				</div>
				<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Auto Баланс</h3>
				<p class="text-slate-500 dark:text-slate-400 text-sm">
					Тежина автоматски
				</p>
			</div>

			<div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-800">
				<div class="w-10 h-10 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center text-xl mb-4">
					✅
				</div>
				<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Решенија</h3>
				<p class="text-slate-500 dark:text-slate-400 text-sm">
					Автоматски клуч за поени
				</p>
			</div>

			<div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-800">
				<div class="w-10 h-10 bg-orange-100 dark:bg-orange-900/30 rounded-xl flex items-center justify-center text-xl mb-4">
					📄
				</div>
				<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">PDF Export</h3>
				<p class="text-slate-500 dark:text-slate-400 text-sm">
					Принт-ready формат
				</p>
			</div>
		</div>

		<!-- Footer Note -->
		<div class="mt-24 text-center p-12 rounded-[3rem] bg-gradient-to-br from-purple-600 to-pink-700 text-white">
			<h2 class="text-3xl font-black mb-6">Заштедете Време, Зголемете Квалитет</h2>
			<p class="text-purple-100 text-lg mb-8 max-w-2xl mx-auto">
				Автоматски генерирајте професионални квизови во неколку кликови. Фокусирајте се на подучување, не на администрација.
			</p>
			<div class="flex flex-wrap justify-center gap-4">
				<a href="/teachers" class="bg-white text-purple-600 font-bold py-4 px-8 rounded-2xl hover:bg-purple-50 transition-all shadow-xl">
					Сите Алати
				</a>
			</div>
		</div>
	</div>
</Layout>
