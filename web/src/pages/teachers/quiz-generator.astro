---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Генератор на Квизови и Тестови | TeacherOS">
    <main class="max-w-4xl mx-auto py-12 px-4">
        <div class="mb-12 text-center">
            <h1 class="text-4xl font-black text-slate-900 dark:text-white mb-4">📝 Паметен Генератор на Тестови</h1>
            <p class="text-slate-500 dark:text-slate-400">Креирајте професионални тестови со Група А и Група Б базирани на официјалните стандарди.</p>
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl p-8 md:p-12 border border-slate-100 dark:border-slate-800">
            <form id="generator-form" class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-2">
                    <label class="block text-sm font-black uppercase tracking-widest text-slate-400">Одделение</label>
                    <select name="grade" class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl p-4 font-bold focus:ring-2 focus:ring-blue-500 transition-all">
                        <option value="6">6. одделение</option>
                        <option value="7">7. одделение</option>
                        <option value="8">8. одделение</option>
                        <option value="9" selected>9. одделение</option>
                        <option value="10">10. одделение</option>
                        <option value="11">11. одделение</option>
                        <option value="12">12. одделение</option>
                    </select>
                </div>

                <div class="space-y-2">
                    <label class="block text-sm font-black uppercase tracking-widest text-slate-400">Област / Тема</label>
                    <select name="field" class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl p-4 font-bold focus:ring-2 focus:ring-blue-500 transition-all">
                        <option value="all">Сите области</option>
                        <option value="algebra">Алгебра</option>
                        <option value="geometry">Геометрија</option>
                        <option value="number_theory">Теорија на броеви</option>
                        <option value="combinatorics">Комбинаторика</option>
                    </select>
                </div>

                <div class="space-y-2">
                    <label class="block text-sm font-black uppercase tracking-widest text-slate-400">Број на задачи</label>
                    <input type="number" name="count" value="5" min="1" max="20" class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl p-4 font-bold focus:ring-2 focus:ring-blue-500 transition-all" />
                </div>

                <div class="space-y-2">
                    <label class="block text-sm font-black uppercase tracking-widest text-slate-400">Тежина</label>
                    <select name="difficulty" class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl p-4 font-bold focus:ring-2 focus:ring-blue-500 transition-all">
                        <option value="easy">Почетно</option>
                        <option value="medium" selected>Средно</option>
                        <option value="hard">Олимписко</option>
                    </select>
                </div>

                <button type="submit" class="md:col-span-2 bg-blue-600 hover:bg-blue-700 text-white font-black py-5 rounded-2xl shadow-xl shadow-blue-500/20 transition-all transform hover:scale-[1.02] flex items-center justify-center gap-3 text-lg">
                    <span id="btn-icon">⚡</span>
                    <span id="btn-text">ГЕНЕРИРАЈ ТЕСТ</span>
                </button>
            </form>

            <div id="loading" class="hidden mt-12 text-center py-10">
                <div class="animate-spin w-12 h-12 border-4 border-blue-600 border-t-transparent rounded-full mx-auto mb-4"></div>
                <p class="font-bold text-slate-600 dark:text-slate-400">Се подготвуваат документите...</p>
            </div>

            <div id="results" class="hidden mt-12 space-y-6">
                <h3 class="text-xl font-black text-slate-900 dark:text-white mb-6 flex items-center gap-2">
                    <span class="text-emerald-500">✅</span> Тестот е подготвен!
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <button id="view-student" class="flex items-center justify-between p-6 bg-slate-50 dark:bg-slate-800 rounded-2xl hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all group">
                        <div class="flex items-center gap-4">
                            <span class="text-3xl">👨‍🎓</span>
                            <div class="text-left">
                                <p class="font-black text-slate-900 dark:text-white">Работен лист за ученици</p>
                                <p class="text-xs text-slate-400 font-bold uppercase tracking-widest">Подготвен за печатење</p>
                            </div>
                        </div>
                        <span class="opacity-0 group-hover:opacity-100 transition-opacity">👁️</span>
                    </button>

                    <button id="view-teacher" class="flex items-center justify-between p-6 bg-slate-50 dark:bg-slate-800 rounded-2xl hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-all group">
                        <div class="flex items-center gap-4">
                            <span class="text-3xl">🔑</span>
                            <div class="text-left">
                                <p class="font-black text-slate-900 dark:text-white">Клуч со решенија</p>
                                <p class="text-xs text-slate-400 font-bold uppercase tracking-widest">Само за наставници</p>
                            </div>
                        </div>
                        <span class="opacity-0 group-hover:opacity-100 transition-opacity">👁️</span>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <div id="preview-modal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm p-4 md:p-10 flex flex-col">
        <div class="flex justify-between items-center mb-4 text-white">
            <h2 id="modal-title" class="text-2xl font-black">Преглед на документ</h2>
            <button id="close-modal" class="p-2 hover:bg-white/10 rounded-full text-3xl">&times;</button>
        </div>
        <div class="bg-white rounded-2xl flex-1 overflow-hidden shadow-2xl relative">
            <iframe id="preview-iframe" class="w-full h-full border-none"></iframe>
            <div id="iframe-loading" class="absolute inset-0 flex items-center justify-center bg-white">
                <div class="animate-spin w-8 h-8 border-4 border-blue-600 border-t-transparent rounded-full"></div>
            </div>
        </div>
    </div>
</Layout>

<script>
    const form = document.getElementById('generator-form');
    const loading = document.getElementById('loading');
    const results = document.getElementById('results');
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    
    const modal = document.getElementById('preview-modal');
    const iframe = document.getElementById('preview-iframe');
    const iframeLoading = document.getElementById('iframe-loading');
    const closeModal = document.getElementById('close-modal');
    
    let generatedData = null;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        loading.classList.remove('hidden');
        results.classList.add('hidden');
        form.classList.add('opacity-50', 'pointer-events-none');
        
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        try {
            const response = await fetch('/api/generate-test', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) throw new Error('Failed to generate');
            
            generatedData = await response.json();
            results.classList.remove('hidden');
        } catch (err) {
            alert('Грешка при генерирање на тестот. Проверете дали имате доволно задачи за оваа област.');
        } finally {
            loading.classList.add('hidden');
            form.classList.remove('opacity-50', 'pointer-events-none');
        }
    });

    document.getElementById('view-student').addEventListener('click', () => {
        if (!generatedData) return;
        showModal('Работен лист за ученици', generatedData.studentHtml);
    });

    document.getElementById('view-teacher').addEventListener('click', () => {
        if (!generatedData) return;
        showModal('Клуч со решенија (Наставници)', generatedData.teacherHtml);
    });

    function showModal(title, html) {
        document.getElementById('modal-title').innerText = title;
        modal.classList.remove('hidden');
        iframeLoading.classList.remove('hidden');
        
        const blob = new Blob([html], { type: 'text/html' });
        const url = URL.createObjectURL(blob);
        
        iframe.src = url;
        iframe.onload = () => iframeLoading.classList.add('hidden');
    }

    closeModal.addEventListener('click', () => {
        modal.classList.add('hidden');
        iframe.src = 'about:blank';
    });
</script>
