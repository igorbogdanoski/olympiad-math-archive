---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Live Quiz Monitor | МатАрхива";
---

<Layout title={pageTitle}>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<div class="dashboard-wrapper">
    <div class="dashboard-container">
        
        <!-- HEADER -->
        <header class="dashboard-header">
            <div class="code-display">
                <small>КОД ЗА ПРИСТАП</small>
                <h1 id="access-code" class="access-code">------</h1>
                <div class="url-display" id="quiz-url">
                    app.mismath.net/student/quiz
                </div>
            </div>
            
            <div class="qr-section">
                <canvas id="qr-canvas"></canvas>
                <span>Скенирај со телефон</span>
            </div>
            
            <div class="stats-display">
                <div class="stat-card">
                    <span class="stat-icon">👥</span>
                    <strong id="count-joined" class="stat-number">0</strong>
                    <small>Приклучени</small>
                </div>
                <div class="stat-card">
                    <span class="stat-icon">✅</span>
                    <strong id="count-finished" class="stat-number">0</strong>
                    <small>Завршени</small>
                </div>
                <div class="stat-card">
                    <span class="stat-icon">📊</span>
                    <strong id="avg-score" class="stat-number">0%</strong>
                    <small>Просек</small>
                </div>
            </div>
        </header>

        <!-- TITLE -->
        <div class="quiz-title-bar">
            <h2 id="quiz-title">Математика - Live Test</h2>
        </div>

        <!-- STUDENT GRID -->
        <main class="student-grid" id="student-grid">
            <div class="waiting-message">
                <div class="waiting-icon">⏳</div>
                <p>Чекам ученици да се приклучат...</p>
                <small>Споделете го кодот погоре</small>
            </div>
        </main>

        <!-- FOOTER CONTROLS -->
        <footer class="dashboard-footer">
            <button onclick="dashboard.endQuiz()" class="btn-danger">
                ⛔ Затвори Квиз
            </button>
            
            <div class="sync-indicator">
                <span class="dot"></span>
                <span>Live Sync</span>
            </div>
            
            <button onclick="dashboard.exportResults()" class="btn-secondary">
                📊 Извези Резултати
            </button>
        </footer>

    </div>
</div>

<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    color: white;
    min-height: 100vh;
}

.dashboard-wrapper {
    padding: 2rem;
    max-width: 1400px;
    margin: 0 auto;
}

.dashboard-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-height: calc(100vh - 4rem);
}

/* HEADER */
.dashboard-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    padding: 2rem;
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    align-items: center;
}

.code-display {
    text-align: center;
}

.code-display small {
    color: #94a3b8;
    font-weight: 700;
    letter-spacing: 2px;
    font-size: 0.75rem;
}

.access-code {
    font-size: 5rem;
    font-family: 'Monaco', monospace;
    color: #38bdf8;
    letter-spacing: 8px;
    margin: 0.5rem 0;
    text-shadow: 0 0 20px rgba(56, 189, 248, 0.5);
    animation: glow 2s infinite alternate;
}

@keyframes glow {
    from { text-shadow: 0 0 20px rgba(56, 189, 248, 0.5); }
    to { text-shadow: 0 0 40px rgba(56, 189, 248, 0.8); }
}

.url-display {
    color: #64748b;
    font-size: 0.9rem;
    font-family: monospace;
}

.qr-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    background: white;
    padding: 1rem;
    border-radius: 16px;
}

.qr-section span {
    color: #1e293b;
    font-size: 0.8rem;
    font-weight: 700;
}

#qr-canvas {
    width: 140px;
    height: 140px;
}

.stats-display {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
}

.stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem;
    background: rgba(255,255,255,0.05);
    border-radius: 12px;
    min-width: 100px;
}

.stat-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
}

.stat-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: #38bdf8;
}

.stat-card small {
    color: #94a3b8;
    font-size: 0.8rem;
}

/* TITLE */
.quiz-title-bar {
    background: rgba(255,255,255,0.05);
    padding: 1.25rem 2rem;
    border-radius: 16px;
    text-align: center;
}

.quiz-title-bar h2 {
    font-size: 1.5rem;
    color: #e2e8f0;
}

/* GRID */
.student-grid {
    flex-grow: 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
    padding: 1rem;
    background: rgba(255,255,255,0.03);
    border-radius: 20px;
    min-height: 400px;
    align-content: start;
}

.waiting-message {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 2rem;
}

.waiting-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    animation: rotate 2s linear infinite;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.waiting-message p {
    font-size: 1.5rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
}

.waiting-message small {
    color: #64748b;
}

/* STUDENT CARDS */
.student-card {
    background: linear-gradient(135deg, #334155 0%, #1e293b 100%);
    padding: 1.5rem;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    border: 2px solid transparent;
    transition: all 0.3s;
    min-height: 160px;
}

.student-card.working {
    border-color: #fbbf24;
    animation: pulse-border 2s infinite;
}

@keyframes pulse-border {
    0%, 100% { box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.4); }
    50% { box-shadow: 0 0 0 12px rgba(251, 191, 36, 0); }
}

.student-card.finished {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    border-color: #059669;
    transform: scale(1.05);
    box-shadow: 0 10px 30px rgba(16, 185, 129, 0.4);
}

.student-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    text-align: center;
}

.student-status {
    font-size: 0.85rem;
    padding: 0.35rem 0.75rem;
    border-radius: 20px;
    background: rgba(0,0,0,0.2);
    font-weight: 600;
}

.student-score {
    font-size: 2.5rem;
    font-weight: 800;
    margin-top: 0.75rem;
    color: white;
}

.student-percentage {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.8);
}

/* FOOTER */
.dashboard-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    background: rgba(255,255,255,0.05);
    border-radius: 16px;
}

button {
    cursor: pointer;
    border: none;
    padding: 0.9rem 2rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.2s;
}

.btn-danger {
    background: #ef4444;
    color: white;
}

.btn-danger:hover {
    background: #dc2626;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(239, 68, 68, 0.4);
}

.btn-secondary {
    background: #64748b;
    color: white;
}

.btn-secondary:hover {
    background: #475569;
}

.sync-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #10b981;
    font-weight: 700;
}

.dot {
    width: 10px;
    height: 10px;
    background: #10b981;
    border-radius: 50%;
    animation: blink 1.5s infinite;
}

@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}

/* RESPONSIVE */
@media (max-width: 1200px) {
    .dashboard-header {
        grid-template-columns: 1fr;
        text-align: center;
    }
    
    .stats-display {
        justify-content: center;
    }
    
    .access-code {
        font-size: 4rem;
    }
}

@media (max-width: 768px) {
    .student-grid {
        grid-template-columns: 1fr;
    }
    
    .dashboard-footer {
        flex-direction: column;
        gap: 1rem;
    }
    
    button {
        width: 100%;
    }
}
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>

<script is:inline>
const API_BASE = window.location.origin;

const dashboard = {
    quizId: null,
    intervalId: null,

    init() {
        // Get quiz ID from URL query (?id=...)
        const params = new URLSearchParams(window.location.search);
        this.quizId = params.get('id');

        if (!this.quizId) {
            alert("Грешка: Нема Quiz ID во URL. Додај ?id=YOUR_QUIZ_ID");
            return;
        }

        // Start polling
        this.fetchLiveStats();
        this.intervalId = setInterval(() => this.fetchLiveStats(), 3000);
    },

    async fetchLiveStats() {
        try {
            const res = await fetch(`${API_BASE}/api/quiz-generator/live/${this.quizId}/stats`);
            
            if (!res.ok) throw new Error('Failed to fetch');
            
            const data = await res.json();
            this.updateDashboard(data);
        } catch (e) {
            console.error('Sync error:', e);
        }
    },

    updateDashboard(data) {
        // Header
        const codeEl = document.getElementById('access-code');
        if (codeEl.textContent === '------') {
            codeEl.textContent = data.access_code;
            this.generateQR(data.access_code);
        }

        document.getElementById('quiz-title').textContent = data.title;
        document.getElementById('count-joined').textContent = data.total_participants;
        document.getElementById('count-finished').textContent = data.finished_count;
        
        const avgPct = data.finished_count > 0 ? Math.round(data.avg_score / data.students.filter(s => s.status === 'finished')[0]?.max_score * 100) : 0;
        document.getElementById('avg-score').textContent = (data.finished_count > 0 ? avgPct : 0) + '%';

        // Grid
        const grid = document.getElementById('student-grid');
        
        if (data.students.length === 0) {
            grid.innerHTML = `
                <div class="waiting-message">
                    <div class="waiting-icon">⏳</div>
                    <p>Чекам ученици да се приклучат...</p>
                    <small>Споделете го кодот погоре</small>
                </div>
            `;
            return;
        }

        grid.innerHTML = '';

        data.students.forEach(student => {
            const card = document.createElement('div');
            const isFinished = student.status === 'finished';
            
            card.className = `student-card ${student.status}`;
            card.innerHTML = `
                <div class="student-name">${student.name}</div>
                <div class="student-status">
                    ${isFinished ? '🏁 ЗАВРШИЛ' : '✍️ РАБОТИ...'}
                </div>
                ${isFinished ? `
                    <div class="student-score">${student.score}</div>
                    <div class="student-percentage">${student.percentage}%</div>
                ` : ''}
            `;
            
            grid.appendChild(card);
        });
    },

    generateQR(code) {
        const url = `${API_BASE}/student/quiz?code=${code}`;
        QRCode.toCanvas(document.getElementById('qr-canvas'), url, {
            width: 140,
            margin: 1,
            color: {
                dark: '#1e293b',
                light: '#ffffff'
            }
        }, (error) => {
            if (error) console.error('QR Error:', error);
        });
    },

    endQuiz() {
        if (!confirm("Дали сте сигурни? Ова ќе го затвори квизот.")) return;
        
        clearInterval(this.intervalId);
        alert("Квизот е затворен! (За сега само симулација)");
        // TODO: Implement close quiz endpoint
    },

    exportResults() {
        alert("Извоз на резултати (TODO: Генерирај Excel/PDF)");
        // TODO: Implement export functionality
    }
};

// Auto-start
document.addEventListener('DOMContentLoaded', () => {
    dashboard.init();
});

window.dashboard = dashboard;
</script>
</Layout>
