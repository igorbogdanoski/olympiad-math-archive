---
import Layout from '../../layouts/Layout.astro';
import GeoGebraReviewPanel from '../../components/GeoGebraReviewPanel.svelte';

// Load mock data for testing (will be replaced with real API)
const mockMatches = [
	{
		id: "match_001",
		problem_id: "geo_7_001",
		problem_text: "Еден триаголник има страни со должини 3 cm, 4 cm и 5 cm. Дали е тоа правоаголен триаголник?",
		problem_grade: 7,
		problem_topic: "Геометрија",
		material_id: "mp67pxtz",
		material_title: "Triangle Altitudes Interactive",
		material_title_mk: "Интерактивни височини во триаголник",
		confidence: 0.85,
		reason: "Perfect match for triangle properties and Pythagorean theorem exploration",
		status: "pending", // pending, approved, rejected
		alternatives: ["rjqh8u9a", "zyf8qk3m"]
	},
	{
		id: "match_002",
		problem_id: "geo_8_045",
		problem_text: "Кружница има центар во точката O(0,0) и радиус 5. Која е растојанието од центарот до точката A(3,4)?",
		problem_grade: 8,
		problem_topic: "Аналитичка геометрија",
		material_id: "k3mp5x2n",
		material_title: "Circle Tangent Line Explorer",
		material_title_mk: "Истражувач на тангенти на кружница",
		confidence: 0.78,
		reason: "Good match for circle properties and distance calculations",
		status: "pending",
		alternatives: []
	},
	{
		id: "match_003",
		problem_id: "alg_9_012",
		problem_text: "Нацртајте ја графиката на функцијата y = 2x + 3 за x во интервалот [-5, 5].",
		problem_grade: 9,
		problem_topic: "Линеарни функции",
		material_id: "f2hp9vwq",
		material_title: "Linear Function Grapher",
		material_title_mk: "График на линеарна функција",
		confidence: 0.92,
		reason: "Excellent match - direct visualization of linear functions",
		status: "pending",
		alternatives: ["xw7tk2qm"]
	}
];
---

<Layout title="GeoGebra Matcher - Review | МатАрхива">
	<div class="min-h-screen bg-gradient-to-br from-slate-50 via-emerald-50/30 to-teal-50 dark:from-slate-900 dark:via-emerald-900/10 dark:to-teal-900/10">
		{/* Header */}
		<div class="bg-gradient-to-r from-emerald-600 to-teal-600 text-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-4">
						<div class="w-14 h-14 bg-white/10 rounded-xl flex items-center justify-center backdrop-blur-sm">
							<span class="text-3xl">🎯</span>
						</div>
						<div>
							<h1 class="text-3xl font-black">GeoGebra Auto-Matcher</h1>
							<p class="text-emerald-100 font-medium">Одобри AI-генерирани GeoGebra визуелизации</p>
						</div>
					</div>
					
					<a 
						href="/teachers" 
						class="px-4 py-2 bg-white/10 hover:bg-white/20 rounded-lg backdrop-blur-sm border border-white/20 transition-all font-medium"
					>
						← Назад
					</a>
				</div>

				{/* Stats */}
				<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-6">
					<div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 border border-white/20">
						<div class="text-2xl font-black">{mockMatches.length}</div>
						<div class="text-emerald-100 text-sm">Вкупно matches</div>
					</div>
					<div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 border border-white/20">
						<div class="text-2xl font-black">{mockMatches.filter(m => m.status === 'pending').length}</div>
						<div class="text-emerald-100 text-sm">На чекање</div>
					</div>
					<div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 border border-white/20">
						<div class="text-2xl font-black">{mockMatches.filter(m => m.confidence >= 0.8).length}</div>
						<div class="text-emerald-100 text-sm">Висока доверба (≥0.8)</div>
					</div>
					<div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 border border-white/20">
						<div class="text-2xl font-black">0%</div>
						<div class="text-emerald-100 text-sm">Одобрени</div>
					</div>
				</div>
			</div>
		</div>

		{/* Main Content */}
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			{/* Info Card */}
			<div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-6 mb-8">
				<div class="flex items-start gap-4">
					<div class="text-3xl">ℹ️</div>
					<div class="flex-1">
						<h3 class="text-lg font-bold text-blue-900 dark:text-blue-100 mb-2">Како работи системот?</h3>
						<ul class="text-sm text-blue-800 dark:text-blue-200 space-y-2">
							<li><strong>1. AI Matching</strong> - Gemini анализира проблеми и ги мапира на GeoGebra материјали</li>
							<li><strong>2. Review</strong> - Наставниците одобруваат или одбиваат предлози (на оваа страница)</li>
							<li><strong>3. Auto-update</strong> - Одобрените matches автоматски се додаваат во problems.json</li>
							<li><strong>4. Live</strong> - Учениците веднаш добиваат интерактивни GeoGebra аплети на проблемите</li>
						</ul>
						<div class="mt-4 flex gap-3">
							<span class="px-3 py-1 bg-green-100 dark:bg-green-900/40 text-green-800 dark:text-green-200 text-xs font-medium rounded-full">
								✓ Висока доверба (≥0.8): Безбедно за одобрување
							</span>
							<span class="px-3 py-1 bg-yellow-100 dark:bg-yellow-900/40 text-yellow-800 dark:text-yellow-200 text-xs font-medium rounded-full">
								⚠ Средна доверба (0.6-0.8): Проверете внимателно
							</span>
						</div>
					</div>
				</div>
			</div>

			{/* Review Panel */}
			<GeoGebraReviewPanel client:load matches={mockMatches} />
		</div>
	</div>
</Layout>

<style>
	/* Custom scrollbar for preview */
	:global(.geogebra-preview-scroll::-webkit-scrollbar) {
		width: 6px;
		height: 6px;
	}
	:global(.geogebra-preview-scroll::-webkit-scrollbar-track) {
		background: transparent;
	}
	:global(.geogebra-preview-scroll::-webkit-scrollbar-thumb) {
		background: #cbd5e1;
		border-radius: 3px;
	}
	:global(.geogebra-preview-scroll::-webkit-scrollbar-thumb:hover) {
		background: #94a3b8;
	}
</style>
