---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Квиз Портал | МатАрхива";
---

<Layout title={pageTitle}>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<div class="quiz-app">
    
    <!-- View 1: CODE ENTRY -->
    <div id="view-login" class="view active">
        <div class="logo-area">
            <div class="emoji-bounce">🎓</div>
            <h2>Влези во Квиз</h2>
            <p>Внеси го кодот од твојот професор</p>
        </div>
        
        <div class="input-group">
            <input 
                type="text" 
                id="access-code" 
                placeholder="КОД (пр. XK92A7)" 
                maxlength="6" 
                autocapitalize="characters"
                autocomplete="off"
            />
            <button onclick="quizApp.verifyCode()" class="btn-primary pulse">
                🚀 Продолжи
            </button>
        </div>
        
        <p class="error-msg" id="login-error"></p>
        
        <div class="help-text">
            <small>💡 Кодот е 6-значен (букви и броеви)</small>
        </div>
    </div>

    <!-- View 2: LOBBY (Name Entry) -->
    <div id="view-lobby" class="view">
        <div class="quiz-preview-card">
            <div class="badge">📝 Квиз</div>
            <h3 id="quiz-title-display">Математика - Тест</h3>
            
            <div class="quiz-meta">
                <span class="meta-item">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span id="time-limit-display">45</span> мин
                </span>
                <span class="meta-item">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span id="question-count-display">10</span> прашања
                </span>
            </div>
        </div>
        
        <div class="input-group">
            <label>Твоето име и презиме</label>
            <input 
                type="text" 
                id="student-name" 
                placeholder="пр. Марко Марковски"
                autocomplete="name"
            />
        </div>
        
        <button onclick="quizApp.startQuiz()" class="btn-success large pulse">
            ✍️ ЗАПОЧНИ КВИЗ
        </button>
        
        <button onclick="quizApp.switchView('view-login')" class="btn-text">
            ← Назад
        </button>
    </div>

    <!-- View 3: QUIZ IN PROGRESS -->
    <div id="view-quiz" class="view">
        <div class="quiz-header">
            <div class="timer" id="timer">45:00</div>
            <div class="progress-bar">
                <div class="fill" id="progress-fill"></div>
            </div>
            <div class="q-counter">
                <span id="q-current">1</span>/<span id="q-total">10</span>
            </div>
        </div>

        <div class="question-container" id="question-container">
            <div class="q-badge">
                Прашање <span id="q-num-badge">1</span>
            </div>
            
            <div id="q-image-container" class="q-image hidden">
                <img id="q-image" alt="Слика за прашањето" />
            </div>
            
            <div id="q-text" class="q-text">
                Текст на прашањето...
            </div>
            
            <div id="options-container" class="options-grid">
                <!-- Options inserted by JS -->
            </div>
        </div>

        <div class="quiz-footer">
            <button id="btn-prev" class="btn-nav" onclick="quizApp.prevQuestion()" disabled>
                ← Назад
            </button>
            <button id="btn-next" class="btn-nav" onclick="quizApp.nextQuestion()">
                Следно →
            </button>
            <button id="btn-submit" class="btn-finish hidden" onclick="quizApp.submitQuiz()">
                🏁 Предај Тест
            </button>
        </div>
    </div>

    <!-- View 4: RESULTS -->
    <div id="view-results" class="view">
        <div class="result-card">
            <div class="success-icon">🎉</div>
            
            <div class="score-display">
                <div class="score-main">
                    <span id="final-score">85</span>
                    <small>/ <span id="final-max">100</span></small>
                </div>
                <div class="score-label">поени</div>
            </div>
            
            <h3 id="result-title">Одличен резултат!</h3>
            <p id="result-feedback" class="result-feedback">
                Го завршивте тестот успешно.
            </p>
            
            <div class="result-stats">
                <div class="stat-box">
                    <div class="stat-icon">✅</div>
                    <div class="stat-value" id="stat-correct">8/10</div>
                    <div class="stat-label">Точни</div>
                </div>
                
                <div class="stat-box">
                    <div class="stat-icon">📊</div>
                    <div class="stat-value" id="stat-percentage">80%</div>
                    <div class="stat-label">Успешност</div>
                </div>
            </div>
            
            <button onclick="location.reload()" class="btn-secondary large">
                🔄 Нов Квиз
            </button>
        </div>
    </div>

</div>

<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}

.quiz-app {
    width: 100%;
    max-width: 500px;
    min-height: 600px;
    background: white;
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    overflow: hidden;
    position: relative;
}

/* VIEWS */
.view {
    display: none;
    padding: 2rem;
    min-height: 600px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.4s ease;
}

.view.active { display: flex; }

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

/* LOGIN VIEW */
.logo-area {
    text-align: center;
    margin-bottom: 3rem;
}

.emoji-bounce {
    font-size: 5rem;
    animation: bounce 2s infinite;
    display: inline-block;
}

@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

.logo-area h2 {
    font-size: 2rem;
    color: #1e293b;
    margin: 1rem 0 0.5rem 0;
}

.logo-area p {
    color: #64748b;
    font-size: 0.95rem;
}

.input-group {
    width: 100%;
    margin-bottom: 1.5rem;
}

.input-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: #475569;
    font-weight: 600;
    font-size: 0.9rem;
}

input {
    width: 100%;
    padding: 1rem 1.25rem;
    font-size: 1.1rem;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    text-align: center;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: all 0.2s;
    background: #f8fafc;
}

input:focus {
    border-color: #667eea;
    outline: none;
    background: white;
    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
}

button {
    cursor: pointer;
    border: none;
    font-weight: 700;
    border-radius: 12px;
    transition: all 0.2s;
    font-size: 1rem;
}

.btn-primary, .btn-success, .btn-secondary {
    width: 100%;
    padding: 1rem;
    color: white;
}

.btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.btn-success {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.btn-secondary {
    background: #64748b;
}

.btn-primary:hover, .btn-success:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
}

.btn-text {
    background: none;
    color: #64748b;
    padding: 0.5rem;
    margin-top: 1rem;
}

.pulse {
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.4); }
    50% { box-shadow: 0 0 0 12px rgba(102, 126, 234, 0); }
}

.error-msg {
    color: #ef4444;
    font-size: 0.9rem;
    margin-top: 1rem;
    font-weight: 600;
    text-align: center;
}

.help-text {
    text-align: center;
    margin-top: 1.5rem;
    color: #94a3b8;
}

/* LOBBY */
.quiz-preview-card {
    width: 100%;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    padding: 2rem;
    border-radius: 16px;
    margin-bottom: 2rem;
    text-align: center;
}

.badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: white;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #667eea;
    margin-bottom: 1rem;
}

.quiz-meta {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 1.5rem;
}

.meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #64748b;
    font-weight: 600;
}

.icon {
    width: 20px;
    height: 20px;
}

/* QUIZ VIEW */
#view-quiz {
    padding: 1rem;
    justify-content: flex-start;
}

.quiz-header {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: #f8fafc;
    border-radius: 12px;
    margin-bottom: 1.5rem;
}

.timer {
    font-family: 'Monaco', monospace;
    font-size: 1.2rem;
    font-weight: 700;
    color: #ef4444;
    background: white;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    white-space: nowrap;
}

.progress-bar {
    flex-grow: 1;
    height: 8px;
    background: #e2e8f0;
    border-radius: 4px;
    overflow: hidden;
}

.fill {
    height: 100%;
    background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
    transition: width 0.3s ease;
}

.q-counter {
    font-weight: 700;
    color: #64748b;
    white-space: nowrap;
}

.question-container {
    flex-grow: 1;
    width: 100%;
    overflow-y: auto;
    padding: 0.5rem;
}

.q-badge {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #64748b;
    font-weight: 700;
    margin-bottom: 1rem;
}

.q-text {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.6;
    color: #1e293b;
    margin-bottom: 2rem;
}

.q-image {
    max-width: 100%;
    border-radius: 12px;
    margin-bottom: 1.5rem;
}

.q-image.hidden { display: none; }

.options-grid {
    display: grid;
    gap: 0.75rem;
}

.opt-btn {
    background: white;
    border: 2px solid #e2e8f0;
    padding: 1rem;
    border-radius: 12px;
    text-align: left;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s;
    color: #1e293b;
    font-weight: 500;
}

.opt-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
}

.opt-btn.selected {
    border-color: #667eea;
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
    color: #1e40af;
    font-weight: 700;
}

.quiz-footer {
    width: 100%;
    display: flex;
    gap: 0.75rem;
    padding: 1rem;
    background: white;
}

.btn-nav, .btn-finish {
    flex: 1;
    padding: 0.9rem;
    font-size: 0.95rem;
}

.btn-nav {
    background: #f1f5f9;
    color: #475569;
}

.btn-nav:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.btn-finish {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
}

/* RESULTS */
.result-card {
    text-align: center;
    width: 100%;
}

.success-icon {
    font-size: 5rem;
    margin-bottom: 1rem;
    animation: bounce 1s ease;
}

.score-display {
    margin: 2rem 0;
}

.score-main {
    font-size: 4rem;
    font-weight: 800;
    color: #667eea;
    line-height: 1;
}

.score-main small {
    font-size: 2rem;
    color: #94a3b8;
}

.score-label {
    color: #64748b;
    font-size: 0.9rem;
    margin-top: 0.5rem;
}

.result-feedback {
    color: #64748b;
    font-size: 1.1rem;
    margin: 1.5rem 0;
}

.result-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2rem 0;
}

.stat-box {
    background: #f8fafc;
    padding: 1.5rem;
    border-radius: 16px;
}

.stat-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
}

.stat-value {
    font-size: 1.8rem;
    font-weight: 700;
    color: #1e293b;
}

.stat-label {
    color: #64748b;
    font-size: 0.85rem;
    margin-top: 0.25rem;
}

.large {
    padding: 1.25rem;
    font-size: 1.1rem;
}

.hidden { display: none !important; }
</style>

<script is:inline>
const API_BASE = window.location.origin;

const quizApp = {
    data: {
        quiz: null,
        answers: {},
        currentIdx: 0,
        startTime: null,
        timerInterval: null,
        accessCode: ''
    },

    async verifyCode() {
        const code = document.getElementById('access-code').value.trim().toUpperCase();
        if (code.length < 4) {
            document.getElementById('login-error').textContent = "Внеси валиден код";
            return;
        }

        const btn = document.querySelector('#view-login button');
        btn.innerHTML = '⏳ Проверка...';
        btn.disabled = true;

        try {
            const res = await fetch(`${API_BASE}/api/quiz-generator/live/access/${code}`);
            
            if (!res.ok) {
                throw new Error('Невалиден код');
            }

            this.data.quiz = await res.json();
            this.data.accessCode = code;

            document.getElementById('quiz-title-display').textContent = this.data.quiz.title;
            document.getElementById('time-limit-display').textContent = this.data.quiz.time_limit;
            document.getElementById('question-count-display').textContent = this.data.quiz.question_count;

            this.switchView('view-lobby');
        } catch (e) {
            document.getElementById('login-error').textContent = "❌ Невалиден код. Обиди се повторно.";
        } finally {
            btn.innerHTML = '🚀 Продолжи';
            btn.disabled = false;
        }
    },

    async startQuiz() {
        const name = document.getElementById('student-name').value.trim();
        if (!name) {
            alert("Внеси го твоето име!");
            return;
        }

        this.data.studentName = name;
        this.data.startTime = Date.now();

        // Join lobby
        try {
            await fetch(`${API_BASE}/api/quiz-generator/live/join`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    access_code: this.data.accessCode,
                    student_name: name
                })
            });
        } catch (e) {
            console.error('Join error:', e);
        }

        this.startTimer(this.data.quiz.time_limit * 60);
        this.renderQuestion();
        this.switchView('view-quiz');
    },

    renderQuestion() {
        const q = this.data.quiz.questions[this.data.currentIdx];

        document.getElementById('q-current').textContent = this.data.currentIdx + 1;
        document.getElementById('q-total').textContent = this.data.quiz.question_count;
        document.getElementById('q-num-badge').textContent = q.question_number;
        document.getElementById('q-text').textContent = q.question_text;

        // Progress
        const pct = ((this.data.currentIdx + 1) / this.data.quiz.question_count) * 100;
        document.getElementById('progress-fill').style.width = pct + '%';

        // Image
        const imgContainer = document.getElementById('q-image-container');
        if (q.image_url) {
            document.getElementById('q-image').src = q.image_url;
            imgContainer.classList.remove('hidden');
        } else {
            imgContainer.classList.add('hidden');
        }

        // Options
        const container = document.getElementById('options-container');
        container.innerHTML = '';

        const options = q.options || [];
        options.forEach(opt => {
            const btn = document.createElement('div');
            btn.className = 'opt-btn';
            btn.textContent = opt;

            if (this.data.answers[q.id] === opt) {
                btn.classList.add('selected');
            }

            btn.onclick = () => {
                document.querySelectorAll('.opt-btn').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                this.data.answers[q.id] = opt;
            };

            container.appendChild(btn);
        });

        // Navigation
        document.getElementById('btn-prev').disabled = this.data.currentIdx === 0;

        if (this.data.currentIdx === this.data.quiz.question_count - 1) {
            document.getElementById('btn-next').classList.add('hidden');
            document.getElementById('btn-submit').classList.remove('hidden');
        } else {
            document.getElementById('btn-next').classList.remove('hidden');
            document.getElementById('btn-submit').classList.add('hidden');
        }
    },

    nextQuestion() {
        if (this.data.currentIdx < this.data.quiz.question_count - 1) {
            this.data.currentIdx++;
            this.renderQuestion();
        }
    },

    prevQuestion() {
        if (this.data.currentIdx > 0) {
            this.data.currentIdx--;
            this.renderQuestion();
        }
    },

    async submitQuiz() {
        if (!confirm("Дали си сигурен дека сакаш да предадеш?")) return;

        clearInterval(this.data.timerInterval);

        const answers = this.data.quiz.questions.map(q => ({
            problem_id: q.id,
            selected_option: this.data.answers[q.id] || "",
            time_spent: 0
        }));

        try {
            const res = await fetch(`${API_BASE}/api/quiz-generator/live/submit`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    access_code: this.data.accessCode,
                    student_name: this.data.studentName,
                    answers: answers
                })
            });

            const result = await res.json();

            document.getElementById('final-score').textContent = result.score;
            document.getElementById('final-max').textContent = result.max_score;
            document.getElementById('stat-correct').textContent = `${result.correct_count}/${result.total_questions}`;
            document.getElementById('stat-percentage').textContent = result.percentage + '%';
            document.getElementById('result-feedback').textContent = result.feedback;

            this.switchView('view-results');

            // Confetti
            if (typeof confetti !== 'undefined') {
                confetti({ particleCount: 150, spread: 70, origin: { y: 0.6 } });
            }
        } catch (e) {
            alert("Грешка при испраќање. Провери интернет.");
        }
    },

    switchView(id) {
        document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
        document.getElementById(id).classList.add('active');
    },

    startTimer(seconds) {
        const display = document.getElementById('timer');
        let remaining = seconds;

        this.data.timerInterval = setInterval(() => {
            remaining--;
            const m = Math.floor(remaining / 60);
            const s = remaining % 60;
            display.textContent = `${m}:${s < 10 ? '0' : ''}${s}`;

            if (remaining <= 0) {
                alert("Времето истече!");
                this.submitQuiz();
            }
        }, 1000);
    }
};

window.quizApp = quizApp;
</script>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
</Layout>
