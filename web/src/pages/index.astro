---
import Layout from '../layouts/Layout.astro';
import { API_BASE_URL } from '../utils/config';
---

<Layout title="TeacherOS | Командна Табла">
	<div class="space-y-10">
		<!-- Hero Section -->
		<header class="flex flex-col md:flex-row md:items-end justify-between gap-6 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-3xl p-8 md:p-12 text-white shadow-2xl shadow-blue-500/20 relative overflow-hidden">
			<div class="relative z-10">
				<h1 class="text-4xl md:text-5xl font-black tracking-tight mb-3">Добредојде, Наставник 👋</h1>
				<p class="text-blue-100 text-lg font-medium opacity-90 max-w-xl">Вашиот дигитален асистент за математика. Креирајте, инспирирајте и следете го напредокот на вашите ученици.</p>
			</div>
			<div class="flex flex-wrap gap-4 relative z-10">
				<a href="/curriculum-planner" class="bg-white text-blue-700 hover:bg-blue-50 px-6 py-3.5 rounded-2xl font-bold transition-all hover:scale-105 shadow-xl flex items-center gap-2">
					<span class="text-xl">➕</span> Нов Работен Лист
				</a>
			</div>
			<!-- Decorative elements -->
			<div class="absolute -right-20 -bottom-20 w-80 h-80 bg-white/10 rounded-full blur-3xl"></div>
			<div class="absolute -left-10 -top-10 w-40 h-40 bg-blue-400/20 rounded-full blur-2xl"></div>
		</header>

		<!-- Stats Grid -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="stats-grid">
            <!-- AI Recommendation Card (New) -->
            <div id="ai-doctor-card" class="md:col-span-3 hidden bg-gradient-to-r from-orange-50 to-orange-100 dark:from-orange-950/20 dark:to-orange-900/10 border border-orange-200 dark:border-orange-800/50 rounded-3xl p-6 relative overflow-hidden">
                <div class="absolute -right-6 -top-6 text-8xl opacity-10 grayscale group-hover:grayscale-0 transition-all">🤖</div>
                <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div>
                        <h3 class="text-orange-800 dark:text-orange-400 font-black text-xs uppercase tracking-[0.2em] mb-2 flex items-center gap-2">
                            <span class="w-2 h-2 bg-orange-500 rounded-full animate-ping"></span>
                            AI Curriculum Doctor
                        </h3>
                        <p class="text-slate-700 dark:text-slate-300 font-medium mb-1">Забележав дека недостасува материјал за:</p>
                        <p class="text-xl font-black text-slate-900 dark:text-white" id="rec-topic">...</p>
                        <p class="text-xs text-orange-700 dark:text-orange-500 font-bold mt-1" id="rec-code"></p>
                    </div>
                    <button id="fix-gap-btn" class="bg-orange-600 hover:bg-orange-500 text-white px-8 py-4 rounded-2xl font-black shadow-lg shadow-orange-500/20 transition-all hover:scale-105 flex items-center gap-3 whitespace-nowrap">
                        <span class="text-xl">⚡</span> Пополни ја дупката
                    </button>
                </div>
            </div>

			<div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-5">
				<div class="w-14 h-14 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-2xl flex items-center justify-center text-2xl shadow-inner">📚</div>
				<div>
					<h3 class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Банка на Задачи</h3>
					<p class="text-3xl font-black text-slate-900 dark:text-white counter" id="problems-count">0</p>
				</div>
			</div>

			<div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-5">
				<div class="w-14 h-14 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded-2xl flex items-center justify-center text-2xl shadow-inner">📝</div>
				<div>
					<h3 class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Креирани Тестови</h3>
					<p class="text-3xl font-black text-slate-900 dark:text-white counter" id="tests-count">0</p>
				</div>
			</div>

			<div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-5">
				<div class="w-14 h-14 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-2xl flex items-center justify-center text-2xl shadow-inner">🎯</div>
				<div class="flex-grow">
					<h3 class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Покриеност</h3>
					<div class="flex items-end gap-2 mb-2">
						<p class="text-3xl font-black text-slate-900 dark:text-white" id="coverage-percent">0%</p>
					</div>
					<div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2">
						<div id="coverage-bar" class="bg-green-500 h-2 rounded-full transition-all duration-1000" style="width: 0%"></div>
					</div>
				</div>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
			<!-- Recent Activity -->
			<div class="lg:col-span-2 space-y-6">
				<div class="flex items-center justify-between px-2">
					<h2 class="text-2xl font-black text-slate-900 dark:text-white flex items-center gap-3">
						<span class="w-2 h-8 bg-blue-600 rounded-full"></span>
						Неодамнешни Активности
					</h2>
					<a href="/worksheet-library" class="text-blue-600 dark:text-blue-400 text-sm font-bold hover:underline uppercase tracking-widest">Сите Тестови</a>
				</div>
				
				<div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm" id="activity-list">
					<!-- Activity items will be loaded here -->
					<div class="p-12 text-center text-slate-400 font-medium">
						<div class="animate-spin w-8 h-8 border-4 border-blue-600 border-t-transparent rounded-full mx-auto mb-4"></div>
						Се вчитуваат активностите...
					</div>
				</div>
			</div>

			<!-- Sidebar Tools -->
			<div class="space-y-8">
				<div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-3xl p-8 text-white shadow-xl relative overflow-hidden group">
					<h2 class="text-2xl font-black mb-3">💼 Портфолио</h2>
					<p class="text-slate-400 text-sm mb-6 leading-relaxed">Автоматски генериран извештај за вашиот професионален развој и покриеност на програмата.</p>
					<button class="w-full bg-blue-600 hover:bg-blue-500 text-white py-4 rounded-2xl font-bold transition-all shadow-lg flex items-center justify-center gap-2 group-hover:scale-105">
						<span>🖨️</span> Експортирај (PDF)
					</button>
					<div class="absolute -right-10 -top-10 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl"></div>
				</div>

				<div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-8 shadow-sm">
					<h3 class="text-slate-400 text-[10px] font-black uppercase tracking-[0.2em] mb-6">Брзи Алатки</h3>
					<div class="space-y-4">
						<a href="/curriculum-planner" class="flex items-center gap-4 p-4 rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group">
							<div class="w-10 h-10 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-400 rounded-xl flex items-center justify-center font-black group-hover:scale-110 transition-transform">AI</div>
							<div>
								<p class="font-bold text-slate-900 dark:text-white text-sm">Генерирај Задачи</p>
								<p class="text-xs text-slate-500">Со помош на Gemini AI</p>
							</div>
						</a>
						<a href="/teachers" class="flex items-center gap-4 p-4 rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group">
							<div class="w-10 h-10 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-xl flex items-center justify-center font-black group-hover:scale-110 transition-transform">QR</div>
							<div>
								<p class="font-bold text-slate-900 dark:text-white text-sm">Скенирај Тест</p>
								<p class="text-xs text-slate-500">Дигитални решенија</p>
							</div>
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script is:inline>
		async function loadDashboard() {
			try {
                // Динамичко одредување на API URL за да работи и на локална мрежа
                const apiBase = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
                    ? 'http://localhost:8000'
                    : `http://${window.location.hostname}:8000`;

				const response = await fetch(`${apiBase}/api/dashboard/stats`);
				if (!response.ok) throw new Error('Failed to fetch');
				
				const data = await response.json();
				
				// Update counters
				document.getElementById('problems-count').textContent = data.stats.problems_count;
				document.getElementById('tests-count').textContent = data.stats.tests_created;
				document.getElementById('coverage-percent').textContent = `${data.stats.coverage_percent}%`;
				document.getElementById('coverage-bar').style.width = `${data.stats.coverage_percent}%`;
				
				// Update activity list
				const list = document.getElementById('activity-list');
				if (data.recent_activity.length === 0) {
					list.innerHTML = `
						<div class="p-16 text-center">
							<div class="text-5xl mb-4">📭</div>
							<p class="text-slate-400 font-bold uppercase tracking-widest text-xs">Сеуште немате активности</p>
							<a href="/curriculum-planner" class="text-blue-600 text-sm font-bold mt-2 block hover:underline">Креирај го првиот тест →</a>
						</div>
					`;
				} else {
					list.innerHTML = data.recent_activity.map(test => `
						<div class="p-5 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors flex items-center justify-between border-b border-slate-50 dark:border-slate-800 last:border-0 group">
							<div class="flex items-center gap-4">
								<div class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-black h-12 w-12 rounded-2xl flex items-center justify-center text-sm shadow-sm">
									${test.grade}
								</div>
								<div>
									<p class="font-bold text-slate-900 dark:text-white group-hover:text-blue-600 transition-colors">${test.topic}</p>
									<p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">ID: ${test.id} • ${test.date}</p>
								</div>
							</div>
							<div class="flex gap-2">
								<a href="/check/${test.id}" class="w-10 h-10 rounded-xl bg-slate-50 dark:bg-slate-800 flex items-center justify-center hover:bg-blue-100 dark:hover:bg-blue-900/40 text-slate-400 hover:text-blue-600 transition-all">
									🔑
								</a>
							</div>
						</div>
					`).join('');
				}
				
			} catch (err) {
				console.error('Dashboard Error:', err);
				document.getElementById('activity-list').innerHTML = `
					<div class="p-12 text-center text-red-500">
						<p class="font-bold">Грешка при вчитување на податоците.</p>
						<p class="text-xs opacity-70">Проверете дали серверот е вклучен.</p>
					</div>
				`;
			}
		}

		loadDashboard();

        // --- AI Recommendation Logic ---
        let currentRecommendation = null;

        async function checkRecommendation() {
			const apiBase = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
				? 'http://localhost:8000'
				: `http://${window.location.hostname}:8000`;

            try {
                const res = await fetch(`${apiBase}/api/dashboard/recommendation`);
                const data = await res.json();
                
                if (data.status === 'pending') {
                    currentRecommendation = data.standard;
                    document.getElementById('rec-topic').textContent = data.standard.description;
                    document.getElementById('rec-code').textContent = `${data.standard.topic} • ${data.standard.code}`;
                    document.getElementById('ai-doctor-card').classList.remove('hidden');
                }
            } catch (err) {
                console.error("Rec error:", err);
            }
        }

        document.getElementById('fix-gap-btn').addEventListener('click', async () => {
            if (!currentRecommendation) return;
            
			const apiBase = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
				? 'http://localhost:8000'
				: `http://${window.location.hostname}:8000`;

            const btn = document.getElementById('fix-gap-btn');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<span class="animate-spin text-xl">⚙️</span> Генерирам задачи...`;
            
            try {
                const res = await fetch(`${apiBase}/api/dashboard/fix-gap`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(currentRecommendation)
                });
                
                if (res.ok) {
                    alert(`Успешно генерирани нови задачи за ${currentRecommendation.code}! Процентот на покриеност ќе се зголеми при следното вчитување.`);
                    document.getElementById('ai-doctor-card').classList.add('hidden');
                    loadDashboard(); // Освежи статистики
                }
            } catch (err) {
                alert("Грешка при генерирање");
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        });

        checkRecommendation();
	</script>
</Layout>

<style>
	.counter {
		font-variant-numeric: tabular-nums;
	}
</style>
