    // Highlight topics with selected standard
    function highlightTopicsWithStandard(standardCode) {
      // Remove previous highlights
      document.querySelectorAll('.topic-card').forEach(card => {
        card.classList.remove('ring-2', 'ring-blue-500', 'bg-blue-50');
      });

      // Find topics with this standard
      if (window.currentGradeData && window.currentGradeData.themes) {
        window.currentGradeData.themes.forEach((theme, index) => {
          if (theme.standards && theme.standards.includes(standardCode)) {
            const topicCard = document.querySelector(`.topic-card:nth-child(${index + 1})`);
            if (topicCard) {
              topicCard.classList.add('ring-2', 'ring-blue-500', 'bg-blue-50');
              topicCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }
        });
      }
    }

