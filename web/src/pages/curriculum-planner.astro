---
import Layout from '../layouts/Layout.astro';
import { API_BASE_URL, AI_API_BASE_URL } from '../utils/config';
import MathFormulaEditorEnhanced from '../components/MathFormulaEditorEnhanced.astro';
import curriculumData from '../data/curriculum_standards_processed.json';
import nationalStandards from '../data/national_standards.json';
import standardsMapping from '../data/standards_mapping.json';
---

<Layout title="Планирање на Настава">
  <main class="max-w-7xl mx-auto px-4 py-8">
    <header class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Планирање на Настава со Олимписки Задачи</h1>
      <p class="text-lg text-gray-600">Создавајте настава според официјалната наставна програма и олимписките задачи, градејќи математичко мајсторство низ годините</p>

      <div class="mt-6 max-w-2xl mx-auto bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex items-center mb-2">
          <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="font-semibold text-blue-800">Официјални Наставни Програми</span>
        </div>
        <p class="text-sm text-blue-700">
          Податоците се преземени директно од веб-страницата на Министерството за образование и наука на Република Македонија
          (<a href="https://bro.gov.mk" class="underline hover:text-blue-900" target="_blank">bro.gov.mk</a>)
        </p>
      </div>

      <!-- Enhanced Search and Grade Selection -->
      <div class="mt-8 space-y-6">
        <!-- Semantic Search Bar -->
        <div class="max-w-2xl mx-auto">
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <input type="text" id="semanticSearch" class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none transition-all duration-200" placeholder="Пребарај стандарди, проблеми или теми... (пр. 'прости броеви', 'триаголник', 'квадратни равенки')">
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
              <button id="clearSearch" class="text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 rounded p-1 hidden" aria-label="Исчисти пребарување">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          </div>
          <div id="searchSuggestions" class="mt-2 hidden">
            <div class="bg-white border border-gray-200 rounded-lg shadow-lg p-3">
              <div class="text-sm text-gray-600 mb-2">Предлог за пребарување:</div>
              <div class="flex flex-wrap gap-2" id="suggestionTags">
                <!-- Search suggestions will be populated here -->
              </div>
            </div>
          </div>
        </div>

        <!-- Grade Selection and Create Button -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <select id="gradeSelect" class="px-6 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none transition-all duration-200 hover:border-indigo-400" aria-label="Изберете одделение" role="combobox">
            <option value="">Изберете одделение</option>
          </select>
          <button id="createLessonBtn" class="px-8 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-all duration-200 hover:scale-105 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100" aria-describedby="createLessonHelp">
            <span class="flex items-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              Создај Настава
            </span>
          </button>
        </div>

        <!-- Personalized Recommendations -->
        <div id="recommendationsSection" class="max-w-4xl mx-auto hidden">
          <div class="bg-gradient-to-r from-indigo-50 to-purple-50 border border-indigo-200 rounded-lg p-6">
            <div class="flex items-center mb-4">
              <svg class="w-6 h-6 text-indigo-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              <h3 class="text-lg font-semibold text-indigo-800">Персонализирани препораки</h3>
            </div>
            <div id="recommendationsContent" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              <!-- Recommendations will be populated here -->
            </div>
          </div>
        </div>
      </div>

      <div id="createLessonHelp" class="sr-only">Изберете одделение за да креирате настава според официјалната програма</div>
    </header>

    <!-- Curriculum Standards Display -->
    <section id="curriculumSection" class="mb-16 hidden">
      <h2 class="text-2xl font-bold mb-6 flex items-center">
        <span class="bg-green-600 text-white w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm">📚</span>
        Наставна Програма
      </h2>

      <div id="curriculumContainer">
        <!-- Curriculum module will be loaded here -->
      </div>
    </section>

    <!-- National Standards Section -->
    <section id="standardsSection" class="mb-16 hidden">
      <h2 class="text-2xl font-bold mb-6 flex items-center">
        <span class="bg-blue-600 text-white w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm">📋</span>
        Национални Стандарди за Математика
      </h2>

      <div id="standardsContainer">
        <!-- National standards will be loaded here -->
      </div>
    </section>

    <!-- Lesson Planning Form -->
    <section id="lessonFormSection" class="mb-16 hidden">
      <h2 class="text-2xl font-bold mb-6 flex items-center">
        <span class="bg-blue-600 text-white w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm">📝</span>
        Планирање на Настава
      </h2>

      <div class="bg-white p-8 rounded-xl border shadow-sm">
        <form id="lessonForm" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Тема на настава</label>
              <input type="text" id="lessonTopic" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="пр. Множење на двоцифрени броеви">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Продолжителност</label>
              <select id="lessonDuration" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                <option value="45">45 минути</option>
                <option value="90">90 минути</option>
                <option value="135">135 минути</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Цели на учење</label>
            <textarea id="learningObjectives" rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Што треба да научат учениците..."></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Планирана содржина</label>
            <textarea id="lessonContent" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Опишете ја содржината на настава..."></textarea>
          </div>

           <div>
             <label class="block text-sm font-medium text-gray-700 mb-2">Математички формули (опционално)</label>
             <div class="mb-2">
               <MathFormulaEditorEnhanced
                 placeholder="Внесете LaTeX формули за настава"
                 className="w-full"
                 standardsIntegration={true}
                 olympiadContext="Наставен план"
               />
             </div>
             <p class="text-xs text-gray-500">
               Користите LaTeX за креирање на убави математички формули. Поддржани се MathJax и MathML стандарди.
             </p>
           </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Домашна задача (опционално)</label>
            <textarea id="homework" rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Опишете домашна задача..."></textarea>
          </div>

          <div class="flex gap-4 flex-wrap">
            <button type="button" id="generateAILessonBtn" class="px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
              AI Генерирај Настава
            </button>
            <button type="button" id="generateAnimationBtn" class="px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              Создај Анимација
            </button>
            <button type="button" id="generateVideoBtn" class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.586a1 1 0 01.707.293l.707.707A1 1 0 0112.414 11H15m-3 7.5A9.5 9.5 0 1121.5 12 9.5 9.5 0 0112 2.5z"></path>
              </svg>
              Генерирај Видео
            </button>
            <button type="button" id="generateHomeworkBtn" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              Генерирај Задачи
            </button>
            <button type="submit" class="px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors">
              Зачувај Настава
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- Generated Content Display -->
    <section id="generatedContentSection" class="mb-16 hidden">
      <h2 class="text-2xl font-bold mb-6 flex items-center">
        <span class="bg-purple-600 text-white w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm">🎬</span>
        Генерирани Ресурси
      </h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div id="videoContainer" class="bg-white p-6 rounded-xl border shadow-sm">
          <h3 class="text-lg font-semibold mb-4">Образовни Видеа</h3>
          <div id="videoList" class="space-y-3">
            <!-- Videos will be populated here -->
          </div>
        </div>

        <div id="homeworkContainer" class="bg-white p-6 rounded-xl border shadow-sm">
          <h3 class="text-lg font-semibold mb-4">Домашни Задачи</h3>
          <div id="homeworkList" class="space-y-3">
            <!-- Homework will be populated here -->
          </div>
        </div>
      </div>
    </section>

    <!-- Оценување на учениците -->
    <section id="assessmentSection" class="mb-16 hidden">
      <h2 class="text-2xl font-bold mb-6 flex items-center">
        <span class="bg-green-600 text-white w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm">📊</span>
        Оценување на учениците
      </h2>

      <div class="p-6 bg-blue-50 border border-blue-200 rounded-lg text-center">
        <p class="text-blue-800">Функционалноста за оценување на учениците е оптимизирана и ќе биде достапна во следната верзија.</p>
      </div>
    </section>

     <!-- Assessment Dashboard Section -->
     <section id="dashboardSection" class="mb-16 hidden">
       <div class="p-6 bg-blue-50 border border-blue-200 rounded-lg text-center">
         <p class="text-blue-800">Dashboard функционалноста ќе биде достапна наскоро.</p>
       </div>
     </section>
     <!-- Manim Template Suggestions Modal -->
    <div id="manimModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
      <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-xl max-w-4xl w-full max-h-96 overflow-hidden">
          <div class="p-6 border-b">
            <div class="flex justify-between items-center">
              <h3 class="text-xl font-semibold">Предложени Manim Анимации</h3>
              <button id="closeManimModal" class="text-gray-500 hover:text-gray-700">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          </div>
          <div id="manimTemplatesList" class="p-6 max-h-80 overflow-y-auto">
            <!-- Templates will be loaded here -->
          </div>
          <div class="p-6 border-t bg-gray-50">
            <div class="flex justify-between">
              <button id="openManimEditor" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">
                Отвори Manim Editor
              </button>
              <button id="cancelManimModal" class="px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400">
                Откажи
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Standard Details Modal -->
    <div id="standardModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50" role="dialog" aria-modal="true" aria-labelledby="standardModalTitle">
      <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-xl max-w-4xl w-full max-h-96 overflow-hidden shadow-2xl transition-all duration-300 ease-out transform scale-95 opacity-0" id="modalContent">
          <div class="p-6 border-b">
            <div class="flex justify-between items-center">
              <h3 id="standardModalTitle" class="text-xl font-semibold">Детали за Стандард</h3>
              <button id="closeStandardModal" class="text-gray-500 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 rounded p-1 transition-colors duration-200" aria-label="Затвори модал">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          </div>
          <div id="standardModalContent" class="p-6 max-h-80 overflow-y-auto" role="document">
            <!-- Content will be loaded here -->
          </div>
          <div class="p-6 border-t bg-gray-50">
            <button id="closeStandardModalBottom" class="px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-all duration-200 hover:scale-105 active:scale-95">
              Затвори
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script is:inline define:vars={{ API_BASE_URL, AI_API_BASE_URL }}>
    window.API_BASE_URL = API_BASE_URL;
    window.AI_API_BASE_URL = AI_API_BASE_URL;
  </script>

  <script define:vars={{ API_BASE_URL, AI_API_BASE_URL }}>
    // Curriculum data - passed from server
    let curriculaData = {};
    let selectedSubject = '';
    let curriculumData = {};

    // API URLs
    const API_URL = API_BASE_URL;
    const AI_API_URL = AI_API_BASE_URL; // AI services endpoint

    // Initialize when DOM is ready
    function initApp() {
      // DOM elements
      const subjectSelect = document.getElementById('subjectSelect');
      const gradeSelect = document.getElementById('gradeSelect');
      const createLessonBtn = document.getElementById('createLessonBtn');
      const curriculumSection = document.getElementById('curriculumSection');
      const lessonFormSection = document.getElementById('lessonFormSection');
      const generatedContentSection = document.getElementById('generatedContentSection');
      const curriculumContainer = document.getElementById('curriculumContainer');

      let grades = [];

      // Fetch grades from backend
      fetch(`${API_URL}/grades`)
        .then(response => response.json())
        .then(data => {
          grades = data.grades || [];
          populateGradeSelect();
        })
        .catch(error => {
          console.error('Failed to load grades:', error);
          // Fallback to hardcoded grades
          grades = ["grade_1","grade_2","grade_3","grade_4","grade_5","grade_6","grade_7","grade_8","grade_9","grade_10","grade_11","grade_12"];
          populateGradeSelect();
        });

      function populateGradeSelect() {
        gradeSelect.innerHTML = '<option value="">Изберете одделение</option>';

        // Elementary school (1-9): Basic education
        const elementaryGrades = grades.filter(g => {
          const num = parseInt(g.replace('grade_', ''));
          return num >= 1 && num <= 9;
        });

        // High school (10-12): Gymnasium
        const highSchoolGrades = grades.filter(g => {
          const num = parseInt(g.replace('grade_', ''));
          return num >= 10 && num <= 12;
        });

        // Add elementary grades with Roman numerals
        elementaryGrades.forEach(grade => {
          const num = parseInt(grade.replace('grade_', ''));
          const romanNumerals = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX'];
          const roman = romanNumerals[num - 1] || num.toString();

          const option = document.createElement('option');
          option.value = grade;
          option.textContent = `${roman} одделение`;
          gradeSelect.appendChild(option);
        });

        // Add high school grades with year names
        highSchoolGrades.forEach(grade => {
          const num = parseInt(grade.replace('grade_', ''));
          const yearNames = ['Прва', 'Втора', 'Трета'];
          const yearName = yearNames[num - 10] || `${num - 9}.`;

          const option = document.createElement('option');
          option.value = grade;
          option.textContent = `${yearName} година гимназија`;
          gradeSelect.appendChild(option);
        });
      }

      // Handle subject selection
      if (subjectSelect) {
      subjectSelect.addEventListener('change', (e) => {
      const subject = e.target.value;
      selectedSubject = subject;
      curriculumData = curriculaData[subject] || {};

      // Reset grade selection
      gradeSelect.innerHTML = '<option value="">Изберете одделение</option>';
      gradeSelect.disabled = !subject;

      if (subject && curriculumData.elementary) {
        const elementaryOptgroup = document.createElement('optgroup');
        elementaryOptgroup.label = 'Основно образование';

        Object.keys(curriculumData.elementary).forEach(grade => {
          const option = document.createElement('option');
          option.value = grade;
          option.textContent = `Одделение ${grade.replace('grade_', '')}`;
          elementaryOptgroup.appendChild(option);
        });

        gradeSelect.appendChild(elementaryOptgroup);
      }

      if (subject && curriculumData.gymnasium) {
        const gymnasiumOptgroup = document.createElement('optgroup');
        gymnasiumOptgroup.label = 'Средно образование';

        Object.keys(curriculumData.gymnasium).forEach(grade => {
          const option = document.createElement('option');
          option.value = grade;
          option.textContent = `Гимназија ${grade.replace('grade_', '')}. година`;
          gymnasiumOptgroup.appendChild(option);
        });

        gradeSelect.appendChild(gymnasiumOptgroup);
      }

      // Hide sections when subject changes
      curriculumSection.classList.add('hidden');
      lessonFormSection.classList.add('hidden');
      createLessonBtn.disabled = true;
      });
    }

    // Load curriculum for selected grade
    if (gradeSelect) {
      gradeSelect.addEventListener('change', (e) => {
      const grade = e.target.value;

      if (grade) {
        fetch(`${API_URL}/curriculum/${grade}`)
          .then(response => response.json())
          .then(data => {
            displayCurriculum(grade, data);
            curriculumSection.classList.remove('hidden');

            // Display national standards for the selected grade
            const gradeNum = parseInt(grade.replace('grade_', ''));
            displayNationalStandards(gradeNum);
            document.getElementById('standardsSection').classList.remove('hidden');

            createLessonBtn.disabled = false;
          })
          .catch(error => {
            console.error('Failed to load curriculum:', error);
            curriculumSection.classList.add('hidden');
            createLessonBtn.disabled = true;
          });
      } else {
        curriculumSection.classList.add('hidden');
        createLessonBtn.disabled = true;
      }
      });
    }

    function displayCurriculum(grade, gradeData) {
      // Store globally for highlighting
      window.currentGradeData = gradeData;

      const topics = (gradeData.themes || []).map((theme, index) => ({
        name: theme.name || theme.title,
        code: theme.code || `MAT-G${grade.split('_')[1]}-T${index+1}`,
        objectives: theme.objectives || [],
        standards: theme.standards_with_codes || theme.standards || [],
        activities: theme.activities || [],
        hours: theme.hours || ''
      }));

      // Clear existing content
      curriculumContainer.innerHTML = '';

      // Determine display name
      const num = parseInt(grade.replace('grade_', ''));
      let displayName;
