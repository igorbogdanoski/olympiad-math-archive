    // Phase 1: AI-Enhanced Semantic Search Implementation
    class AISemanticSearchEngine {
      constructor() {
        this.searchIndex = {};
        this.synonyms = {
          'прости': ['прости броеви', 'prime', 'прост'],
          'квадрати': ['квадратни', 'квадрат', 'square', 'квадратичен'],
          'триаголник': ['триаголник', 'triangle', 'триаголници'],
          'равенки': ['равенка', 'equation', 'equations'],
          'линеарни': ['линеарен', 'linear', 'linearen'],
          'системи': ['систем', 'system', 'системи равенки'],
          'геометрија': ['геометриски', 'geometry', 'геом'],
          'алгебра': ['алгебарски', 'algebra', 'алг'],
          'броеви': ['број', 'number', 'цифри'],
          'проценти': ['процент', 'percent', 'проценти'],
          'функции': ['функција', 'function', 'functions']
        };
        this.macedonianCorpus = this.loadMacedonianCorpus();
        this.buildSearchIndex();
      }

      // Load Macedonian mathematical corpus (Phase 1 data foundation)
      loadMacedonianCorpus() {
        return {
          standards: nationalStandards.национални_стандарди[0].знаења_и_вештини,
          curriculum: {
            algebra: ['линеарни равенки', 'квадратни равенки', 'системи равенки', 'функции'],
            geometry: ['триаголник', 'квадрат', 'правоаголник', 'круг', 'паралелограм'],
            arithmetic: ['прости броеви', 'делители', 'множители', 'проценти', 'размери'],
            olympiad: ['комбинаторика', 'теорија на броеви', 'нееднакости', 'геометриски трансформации']
          },
          teachingStrategies: {
            problemBased: 'Проблем-базирано учење со олимписки задачи',
            collaborative: 'Групна работа на комплексни проблеми',
            differentiated: 'Диференцирана инструкција според ниво'
          }
        };
      }

      // Build search index from curriculum and standards data
      buildSearchIndex() {
        // Index standards
        Object.values(nationalStandards.национални_стандарди[0].знаења_и_вештини).forEach(standard => {
          const text = `${standard.шифра} ${standard.опис}`.toLowerCase();
          this.addToIndex(text, { type: 'standard', id: standard.шифра, title: standard.опис });
        });

        // Index curriculum topics (would be populated from curriculum data)
        this.searchIndex['математика'] = { type: 'subject', title: 'Математика' };
        this.searchIndex['геометрија'] = { type: 'topic', title: 'Геометрија' };
        this.searchIndex['алгебра'] = { type: 'topic', title: 'Алгебра' };
      }

      addToIndex(text, item) {
        const words = text.split(/\s+/);
        words.forEach(word => {
          if (word.length > 2) {
            if (!this.searchIndex[word]) {
              this.searchIndex[word] = [];
            }
            this.searchIndex[word].push(item);
          }
        });
      }

      // Enhanced semantic search with Macedonian language processing
      search(query) {
        const queryLower = query.toLowerCase().trim();
        if (!queryLower) return { results: [], suggestions: [] };

        const queryWords = queryLower.split(/\s+/);
        const expandedWords = this.expandWithSynonyms(queryWords);
        const allWords = [...new Set([...queryWords, ...expandedWords])];

        let results = [];
        let scores = {};

        // Search through index
        allWords.forEach(word => {
          if (this.searchIndex[word]) {
            this.searchIndex[word].forEach(item => {
              const key = `${item.type}_${item.id || item.title}`;
              if (!scores[key]) {
                scores[key] = { item, score: 0, matches: [] };
              }
              scores[key].score += this.calculateRelevance(word, queryWords);
              scores[key].matches.push(word);
            });
          }
        });

        // Convert to results array
        Object.values(scores).forEach(({ item, score, matches }) => {
          results.push({
            ...item,
            relevanceScore: score,
            matchedTerms: matches,
            highlight: this.generateHighlight(item.title || item.опис, matches)
          });
        });

        // Sort by relevance
        results.sort((a, b) => b.relevanceScore - a.relevanceScore);

        // Generate suggestions
        const suggestions = this.generateSuggestions(queryWords);

        return {
          results: results.slice(0, 10),
          suggestions: suggestions
        };
      }

      expandWithSynonyms(words) {
        let expanded = [];
        words.forEach(word => {
          if (this.synonyms[word]) {
            expanded.push(...this.synonyms[word]);
          }
          // Add stem variations for Macedonian
          expanded.push(...this.generateStems(word));
        });
        return expanded;
      }

      generateStems(word) {
        const stems = [];
        // Basic Macedonian stemming
        if (word.endsWith('и')) stems.push(word.slice(0, -1));
        if (word.endsWith('а')) stems.push(word.slice(0, -1));
        if (word.endsWith('е')) stems.push(word.slice(0, -1));
        if (word.endsWith('ов')) stems.push(word.slice(0, -2));
        return stems;
      }

      calculateRelevance(word, queryWords) {
        let score = 1;
        if (queryWords.includes(word)) score += 3; // Exact match
        if (word.length > 5) score += 1; // Longer words more specific
        return score;
      }

      generateHighlight(text, matches) {
        let highlighted = text;
        matches.forEach(match => {
          const regex = new RegExp(`(${match})`, 'gi');
          highlighted = highlighted.replace(regex, '<mark class="bg-yellow-200">$1</mark>');
        });
        return highlighted;
      }

      generateSuggestions(queryWords) {
        const suggestions = [];
        const commonTerms = [
          'прости броеви', 'квадратни равенки', 'триаголник', 'геометрија',
          'алгебра', 'проценти', 'функции', 'систем равенки'
        ];

        queryWords.forEach(word => {
          commonTerms.forEach(term => {
            if (term.includes(word) && term !== word) {
              suggestions.push(term);
            }
          });
        });

        return [...new Set(suggestions)].slice(0, 5);
      }
    }

    // Recommendation Engine
    class RecommendationEngine {
      constructor() {
        this.userHistory = [];
        this.contentSimilarities = {};
      }

      // Build content similarity matrix
      buildSimilarityMatrix() {
        const standards = nationalStandards.национални_стандарди[0].знаења_и_вештини;
        const standardKeys = Object.keys(standards);

        standardKeys.forEach(key1 => {
          standardKeys.forEach(key2 => {
            if (key1 !== key2) {
              const similarity = this.calculateContentSimilarity(
                standards[key1].опис,
                standards[key2].опис
              );
              if (similarity > 0.3) { // Similarity threshold
                this.contentSimilarities[`${key1}_${key2}`] = similarity;
              }
            }
          });
        });
      }

      calculateContentSimilarity(text1, text2) {
        const words1 = new Set(text1.toLowerCase().split(/\s+/));
        const words2 = new Set(text2.toLowerCase().split(/\s+/));

        const intersection = new Set([...words1].filter(x => words2.has(x)));
        const union = new Set([...words1, ...words2]);

        return intersection.size / union.size;
      }

      // Generate recommendations based on selected items
      generateRecommendations(selectedItems, grade) {
        const recommendations = [];
        const gradeMappings = standardsMapping.основно_образование;

        // Find similar standards
        selectedItems.forEach(item => {
          Object.keys(this.contentSimilarities).forEach(key => {
            if (key.includes(item)) {
              const [std1, std2] = key.split('_');
              const similarStandard = std1 === item ? std2 : std1;

              if (!selectedItems.includes(similarStandard)) {
                const standard = nationalStandards.национални_стандарди[0].знаења_и_вештини[similarStandard];
                if (standard) {
                  recommendations.push({
                    type: 'standard',
                    id: similarStandard,
                    title: standard.опис.substring(0, 100) + '...',
                    reason: 'Сличен концепт',
                    similarity: Math.round(this.contentSimilarities[key] * 100)
                  });
                }
              }
            }
          });
        });

        // Add grade-appropriate Olympiad problems
        const gradeProblems = [
          { grade: 'grade_7', problems: ['sigma137_p1871', 'geom_triangles_01'] },
          { grade: 'grade_8', problems: ['sigma138_1873', 'algebra_quad_01'] },
          { grade: 'grade_9', problems: ['geometry_9_angles', 'algebra_systems_01'] }
        ];

        const gradeData = gradeProblems.find(g => g.grade === grade);
        if (gradeData) {
          gradeData.problems.forEach(problemId => {
            recommendations.push({
              type: 'olympiad',
              id: problemId,
              title: `Олимписки проблем ${problemId}`,
              reason: 'Применливо за овој одделение',
              difficulty: grade
            });
          });
        }

        return recommendations.slice(0, 6); // Limit to 6 recommendations
      }

      trackUserInteraction(itemId, action) {
        this.userHistory.push({
          itemId,
          action,
          timestamp: Date.now()
        });
      }
    }

    // Phase 1: Initialize AI-enhanced search and recommendation engines
    const searchEngine = new AISemanticSearchEngine();
    const recommendationEngine = new RecommendationEngine();
    recommendationEngine.buildSimilarityMatrix();

    // Search functionality
    const searchInput = document.getElementById('semanticSearch');
    const clearSearchBtn = document.getElementById('clearSearch');
    const searchSuggestions = document.getElementById('searchSuggestions');
    const suggestionTags = document.getElementById('suggestionTags');

    let searchTimeout;

    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.trim();

      if (query.length > 1) {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          performSearch(query);
        }, 300);
      } else {
        hideSearchSuggestions();
      }

      // Show/hide clear button
      clearSearchBtn.classList.toggle('hidden', query.length === 0);
    });

    // Phase 1: AI-powered search using transformer models
    async function performSearch(query) {
      try {
        // Show loading state
        searchInput.style.opacity = '0.7';

        const response = await fetch(`${AI_API_URL}/ai-search`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: query,
            context: {
              grade: gradeSelect.value,
              language: 'mk'
            }
          })
        });

        if (!response.ok) {
          throw new Error('AI search failed');
        }

        const aiResults = await response.json();

        // Show suggestions from AI
        if (aiResults.suggestions && aiResults.suggestions.length > 0) {
          showSearchSuggestions(aiResults.suggestions);
        } else {
          hideSearchSuggestions();
        }

        // Highlight matching standards/topics from AI results
        highlightSearchResults(aiResults.results || []);

        // Log AI performance
        console.log('AI Search completed:', {
          query,
          resultsCount: aiResults.results?.length || 0,
          processingTime: aiResults.processingTime,
          modelVersion: aiResults.modelVersion
        });

      } catch (error) {
        console.error('AI Search error:', error);
        // Fallback to local search engine
        const fallbackResults = searchEngine.search(query);

        if (fallbackResults.suggestions.length > 0) {
          showSearchSuggestions(fallbackResults.suggestions);
        } else {
          hideSearchSuggestions();
        }

        highlightSearchResults(fallbackResults.results);
      } finally {
        searchInput.style.opacity = '1';
      }
    }

    function showSearchSuggestions(suggestions) {
      suggestionTags.innerHTML = suggestions.map(suggestion =>
        `<button class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-sm hover:bg-indigo-200 transition-colors" onclick="applySuggestion('${suggestion}')">${suggestion}</button>`
      ).join('');
      searchSuggestions.classList.remove('hidden');
    }

    function hideSearchSuggestions() {
      searchSuggestions.classList.add('hidden');
    }

    function applySuggestion(suggestion) {
      searchInput.value = suggestion;
      hideSearchSuggestions();
      performSearch(suggestion);
    }

    clearSearchBtn.addEventListener('click', () => {
      searchInput.value = '';
      clearSearchBtn.classList.add('hidden');
      hideSearchSuggestions();
      clearSearchHighlights();
    });

    function highlightSearchResults(results) {
      // Remove previous highlights
      document.querySelectorAll('.search-highlight').forEach(el => {
        el.classList.remove('search-highlight', 'ring-2', 'ring-yellow-400');
      });

      // Highlight matching standards
      results.forEach(result => {
        if (result.type === 'standard') {
          const standardElement = document.querySelector(`[onclick*="${result.id}"]`);
          if (standardElement) {
            standardElement.classList.add('search-highlight', 'ring-2', 'ring-yellow-400');
            standardElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }
      });
    }

    function clearSearchHighlights() {
      document.querySelectorAll('.search-highlight').forEach(el => {
        el.classList.remove('search-highlight', 'ring-2', 'ring-yellow-400');
      });
    }

    // Phase 1: AI-powered recommendations using collaborative filtering
    async function showRecommendations(selectedItems, grade) {
      try {
        // Show loading state
        const recommendationsSection = document.getElementById('recommendationsSection');
        recommendationsSection.style.opacity = '0.7';

        const response = await fetch(`${AI_API_URL}/ai-recommend`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            selectedItems: selectedItems,
            context: {
              grade: grade,
              subject: 'matematika'
            },
            userId: 'teacher_demo', // Would be actual user ID in production
            preferences: {
              focus: 'mixed'
            }
          })
        });

        if (!response.ok) {
          throw new Error('AI recommendation failed');
        }

        const aiResponse = await response.json();
        const recommendations = aiResponse.recommendations || [];

        if (recommendations.length > 0) {
          const recommendationsContent = document.getElementById('recommendationsContent');
          recommendationsContent.innerHTML = recommendations.map(rec => `
            <div class="bg-white p-4 rounded-lg border border-gray-200 hover:shadow-md transition-all duration-200 cursor-pointer hover:scale-102" onclick="handleRecommendationClick('${rec.type}', '${rec.id}')">
              <div class="flex items-start justify-between mb-2">
                <div class="flex items-center">
                  <div class="w-2 h-2 rounded-full ${rec.type === 'standard' ? 'bg-blue-400' : rec.type === 'olympiad' ? 'bg-green-400' : 'bg-purple-400'} mr-2"></div>
                  <span class="text-xs font-medium ${rec.type === 'standard' ? 'text-blue-600' : rec.type === 'olympiad' ? 'text-green-600' : 'text-purple-600'}">
                    ${rec.type === 'standard' ? 'Стандард' : rec.type === 'olympiad' ? 'Олимписки проблем' : 'Наставна стратегија'}
                  </span>
                </div>
                <div class="flex items-center gap-1">
                  ${rec.confidence ? `<span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded">${Math.round(rec.confidence * 100)}% сигурност</span>` : ''}
                  ${rec.metadata?.similarity ? `<span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded">${rec.metadata.similarity}% сличност</span>` : ''}
                </div>
              </div>
              <h4 class="font-medium text-gray-800 text-sm mb-1">${rec.title}</h4>
              <p class="text-xs text-gray-600">${rec.reason}</p>
              ${rec.metadata?.grade ? `<p class="text-xs text-gray-500 mt-1">Одделение: ${rec.metadata.grade.replace('grade_', '')}</p>` : ''}
            </div>
          `).join('');

          recommendationsSection.classList.remove('hidden');

          // Show personalized insights if available
          if (aiResponse.personalizedInsights && aiResponse.personalizedInsights.length > 0) {
            const insightsHtml = aiResponse.personalizedInsights.map(insight =>
              `<div class="bg-blue-50 border-l-4 border-blue-400 p-3 mb-2">
                <p class="text-sm text-blue-700">${insight}</p>
              </div>`
            ).join('');

            recommendationsContent.insertAdjacentHTML('afterbegin', insightsHtml);
          }
        }

        // Log AI performance
        console.log('AI Recommendations completed:', {
          selectedItems: selectedItems.length,
          recommendationsCount: recommendations.length,
          processingTime: aiResponse.processingTime,
          modelVersion: aiResponse.modelVersion
        });

      } catch (error) {
        console.error('AI Recommendation error:', error);
        // Fallback to local recommendation engine
        const recommendations = recommendationEngine.generateRecommendations(selectedItems, grade);

        if (recommendations.length > 0) {
          const recommendationsContent = document.getElementById('recommendationsContent');
          recommendationsContent.innerHTML = recommendations.map(rec => `
            <div class="bg-white p-4 rounded-lg border border-gray-200 hover:shadow-md transition-shadow cursor-pointer" onclick="handleRecommendationClick('${rec.type}', '${rec.id}')">
              <div class="flex items-start justify-between mb-2">
                <div class="flex items-center">
                  <div class="w-2 h-2 rounded-full ${rec.type === 'standard' ? 'bg-blue-400' : 'bg-green-400'} mr-2"></div>
                  <span class="text-xs font-medium ${rec.type === 'standard' ? 'text-blue-600' : 'text-green-600'}">
                    ${rec.type === 'standard' ? 'Стандард' : 'Олимписки проблем'}
                  </span>
                </div>
                ${rec.similarity ? `<span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded">${rec.similarity}% сличност</span>` : ''}
              </div>
              <h4 class="font-medium text-gray-800 text-sm mb-1">${rec.title}</h4>
              <p class="text-xs text-gray-600">${rec.reason}</p>
            </div>
          `).join('');

          document.getElementById('recommendationsSection').classList.remove('hidden');
        }
      } finally {
        const recommendationsSection = document.getElementById('recommendationsSection');
        recommendationsSection.style.opacity = '1';
      }
    }

    function handleRecommendationClick(type, id) {
      if (type === 'standard') {
        // Find and click the corresponding standard
        const standardElement = document.querySelector(`[onclick*="${id}"]`);
        if (standardElement) {
          standardElement.click();
        }
      } else if (type === 'olympiad') {
        // Open Olympiad problem (would need implementation)
        console.log('Open Olympiad problem:', id);
      }

      // Track user interaction
      recommendationEngine.trackUserInteraction(id, 'clicked');
    }

    // Make functions globally available
    window.applySuggestion = applySuggestion;
    window.handleRecommendationClick = handleRecommendationClick;

    // Enhanced topic selection to show recommendations
    const originalSelectTopicForLesson = window.selectTopicForLesson;
    window.selectTopicForLesson = function(topic) {
      if (originalSelectTopicForLesson) {
        originalSelectTopicForLesson(topic);
      }

      // Show recommendations based on selected topic
      const selectedStandards = topic.standards || [];
      const currentGrade = gradeSelect.value;

      if (selectedStandards.length > 0) {
        setTimeout(() => {
          showRecommendations(selectedStandards, currentGrade);
        }, 100);
      }
    };

    // Add keyboard navigation for modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !document.getElementById('standardModal').classList.contains('hidden')) {
        closeStandardModal();
      }

      // Close search suggestions with Escape
      if (e.key === 'Escape' && !searchSuggestions.classList.contains('hidden')) {
        hideSearchSuggestions();
      }
    });
    }

    // Call initApp when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initApp);
    } else {
      initApp();
    }
  </script>
</Layout>
