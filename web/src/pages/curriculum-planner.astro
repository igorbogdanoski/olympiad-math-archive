      modal.classList.remove('hidden');
      templatesList.innerHTML = '<div class="text-center py-8"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-red-600 mx-auto mb-2"></div>Барање на предлози...</div>';

      try {
        const response = await fetch(`/api/manim-suggestions?topic=${encodeURIComponent(topic)}&grade=${encodeURIComponent(grade)}`);
        const data = await response.json();

        if (data.success && data.templates.length > 0) {
          templatesList.innerHTML = data.templates.map(template => `
            <div class="template-suggestion p-4 border border-gray-200 rounded-lg mb-3 hover:border-red-300 cursor-pointer"
                 onclick="selectManimTemplate('${template.id}')">
              <div class="flex justify-between items-start mb-2">
                <h4 class="font-medium text-gray-800">${template.title}</h4>
                <div class="flex items-center gap-2">
                  <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">Grade ${template.grade}</span>
                  <span class="text-xs bg-green-100 text-green-800 px-2 py-1 rounded">${template.category}</span>
                </div>
              </div>
              <p class="text-sm text-gray-600 mb-2">${template.description}</p>
              <div class="flex justify-between items-center text-xs text-gray-500">
                <span>Score: ${template.score}</span>
                <span>Keywords: ${template.keywords.slice(0, 3).join(', ')}</span>
              </div>
            </div>
          `).join('');
        } else {
          templatesList.innerHTML = `
            <div class="text-center py-8 text-gray-500">
              <div class="text-4xl mb-2">🎬</div>
              <div>Не се најдени специфични предлози за оваа тема.</div>
              <div class="text-sm mt-2">Можете директно да отворите Manim Editor за да создадете нова анимација.</div>
            </div>
          `;
        }
      } catch (error) {
