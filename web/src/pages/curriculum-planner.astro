    // Populate form with AI-generated lesson
    function populateFormWithAILesson(lessonPlan) {
      // Update title
      const titleElement = document.querySelector('h1');
      if (titleElement) {
        titleElement.textContent = lessonPlan.title;
      }

      // Populate learning objectives
      const objectivesTextarea = document.getElementById('learningObjectives');
      if (objectivesTextarea && lessonPlan.learningObjectives) {
        objectivesTextarea.value = lessonPlan.learningObjectives.join('\n');
      }

      // Populate lesson content with structured activities
      const contentTextarea = document.getElementById('lessonContent');
      if (contentTextarea && lessonPlan.lessonStructure) {
        const structure = lessonPlan.lessonStructure;
        let content = '';

        if (structure.introduction) {
          content += `ВОВЕД (${structure.introduction.duration} мин):\n`;
          content += structure.introduction.activities.map(act => `• ${act}`).join('\n');
          content += '\n\n';
        }

        if (structure.mainActivities) {
          content += `ГЛАВНИ АКТИВНОСТИ (${structure.mainActivities.duration} мин):\n`;
          content += structure.mainActivities.activities.map(act => `• ${act}`).join('\n');
          if (structure.mainActivities.assessment) {
            content += '\nОЦЕНУВАЊЕ:\n';
            content += structure.mainActivities.assessment.map(assess => `• ${assess}`).join('\n');
          }
          content += '\n\n';
        }

        if (structure.conclusion) {
          content += `ЗАКЛУЧОК (${structure.conclusion.duration} мин):\n`;
          content += structure.conclusion.activities.map(act => `• ${act}`).join('\n');
          if (structure.conclusion.reflection) {
            content += '\nРЕФЛЕКСИЈА:\n';
            content += structure.conclusion.reflection.map(ref => `• ${ref}`).join('\n');
          }
        }

        contentTextarea.value = content;
      }

      // Populate homework
      const homeworkTextarea = document.getElementById('homework');
      if (homeworkTextarea && lessonPlan.homework) {
        let homework = '';

        if (lessonPlan.homework.assignments) {
          homework += 'ДОМАШНА ЗАДАЧА:\n';
          homework += lessonPlan.homework.assignments.map(hw => `• ${hw}`).join('\n');
        }

        if (lessonPlan.homework.extensions) {
          homework += '\n\nПРОШИРУВАЊА ЗА НАПРЕДНИ:\n';
          homework += lessonPlan.homework.extensions.map(ext => `• ${ext}`).join('\n');
        }

        homeworkTextarea.value = homework;
      }

      // Show lesson form if not visible
      const lessonFormSection = document.getElementById('lessonFormSection');
      if (lessonFormSection && lessonFormSection.classList.contains('hidden')) {
        lessonFormSection.classList.remove('hidden');
        lessonFormSection.scrollIntoView({ behavior: 'smooth' });
      }

      // Log AI generation metadata
      console.log('AI Lesson Plan Generated:', {
        title: lessonPlan.title,
        pedagogical_approach: (lessonPlan.metadata && lessonPlan.metadata.pedagogical_approach),
        differentiation_level: (lessonPlan.metadata && lessonPlan.metadata.differentiation_level),
        manim_animations: (lessonPlan.manimAnimations && lessonPlan.manimAnimations.recommended && lessonPlan.manimAnimations.recommended.length) || 0
      });
    }

    // Display national standards for selected grade
    function displayNationalStandards(gradeNum) {
      const standardsContainer = document.getElementById('standardsContainer');
      if (!standardsContainer) return;

      let relevantStandards = [];
      let educationLevel = '';

      // Determine education level and get relevant standards
      if (gradeNum >= 1 && gradeNum <= 3) {
        educationLevel = 'Основно образование (1-3 одд)';
        relevantStandards = standardsMapping.основно_образование.одделение_1_3;
      } else if (gradeNum >= 4 && gradeNum <= 6) {
        educationLevel = 'Основно образование (4-6 одд)';
        relevantStandards = standardsMapping.основно_образование.одделение_4_6;
      } else if (gradeNum >= 7 && gradeNum <= 9) {
        educationLevel = 'Основно образование (7-9 одд)';
        relevantStandards = standardsMapping.основно_образование.одделение_7_9;
      } else if (gradeNum >= 10 && gradeNum <= 12) {
        educationLevel = 'Средно образование (10-12 одд)';
        relevantStandards = standardsMapping.средно_образование.одделение_10_12;
      }

      // Clear previous content
      standardsContainer.innerHTML = '';

      if (relevantStandards.length === 0) {
        standardsContainer.innerHTML = '<p class="text-gray-500">Нема достапни стандарди за ова одделение.</p>';
        return;
      }

      // Create standards display
      const standardsHTML = `
        <div class="mb-4">
          <h3 class="text-lg font-semibold text-gray-800 mb-3">${educationLevel}</h3>
        </div>
        <div class="space-y-3">
          ${relevantStandards.map(code => {
            const standard = nationalStandards.национални_стандарди[0].знаења_и_вештини.find(s => s.шифра === code);
            if (!standard) return '';
            return `
              <div class="border border-gray-200 rounded-lg p-4 hover:border-blue-300 transition-colors cursor-pointer" onclick="openStandardModal('${code}', '${standard.опис.replace(/'/g, '\\\'')}')">
                <div class="flex items-start gap-3">
                  <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm font-mono">${code}</span>
                  <div class="flex-1">
                    <p class="text-gray-800 text-sm leading-relaxed">${standard.опис}</p>
                  </div>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `;

      standardsContainer.innerHTML = standardsHTML;
    }

