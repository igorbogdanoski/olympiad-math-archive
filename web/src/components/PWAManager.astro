---
// PWA Manager Component for handling service worker and PWA functionality
---

<!-- PWA Manager Script -->
<script>
  class PWAManager {
    private deferredPrompt: any = null;
    private isOnline: boolean = navigator.onLine;
    private serviceWorkerRegistration: ServiceWorkerRegistration | null = null;

    constructor() {
      this.init();
    }

    private init() {
      this.setupServiceWorker();
      this.setupNetworkDetection();
      this.setupInstallPrompt();
      this.setupPeriodicSync();
      this.updateOnlineStatus();
    }

    private async setupServiceWorker() {
      if ('serviceWorker' in navigator) {
        try {
          console.log('[PWA] Registering service worker...');
          this.serviceWorkerRegistration = await navigator.serviceWorker.register('/sw.js', {
            scope: '/'
          });

          console.log('[PWA] Service worker registered successfully');

          // Handle updates
          this.serviceWorkerRegistration.addEventListener('updatefound', () => {
            const newWorker = this.serviceWorkerRegistration?.installing;
            if (newWorker) {
              newWorker.addEventListener('statechange', () => {
                if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                  this.showUpdateNotification();
                }
              });
            }
          });

          // Listen for messages from service worker
          navigator.serviceWorker.addEventListener('message', (event) => {
            this.handleServiceWorkerMessage(event);
          });

        } catch (error) {
          console.error('[PWA] Service worker registration failed:', error);
        }
      } else {
        console.warn('[PWA] Service workers not supported');
      }
    }

    private setupNetworkDetection() {
      window.addEventListener('online', () => {
        this.isOnline = true;
        this.updateOnlineStatus();
        this.syncOfflineData();
        this.showNotification('Интернет конекција обновена', 'success');
      });

      window.addEventListener('offline', () => {
        this.isOnline = false;
        this.updateOnlineStatus();
        this.showNotification('Нема интернет конекција', 'warning');
      });
    }

    private setupInstallPrompt() {
      window.addEventListener('beforeinstallprompt', (event) => {
        console.log('[PWA] Install prompt triggered');
        event.preventDefault();
        this.deferredPrompt = event;
        this.showInstallPrompt();
      });

      // Listen for successful installation
      window.addEventListener('appinstalled', () => {
        console.log('[PWA] App installed successfully');
        this.deferredPrompt = null;
        this.showNotification('Апликацијата е успешно инсталирана!', 'success');
      });
    }

    private setupPeriodicSync() {
      if (this.serviceWorkerRegistration && 'periodicSync' in this.serviceWorkerRegistration) {
        const registration = this.serviceWorkerRegistration as any;
        if (registration.periodicSync) {
          // Register periodic sync for content updates
          registration.periodicSync.register('content-update', {
            minInterval: 24 * 60 * 60 * 1000 // 24 hours
          }).catch((error: any) => {
            console.log('[PWA] Periodic sync registration failed:', error);
          });
        }
      }
    }

    private showInstallPrompt() {
      const installButton = document.getElementById('install-pwa-btn');
      if (installButton) {
        installButton.style.display = 'inline-flex';
        installButton.addEventListener('click', () => {
          this.installPWA();
        });
      }
    }

    private async installPWA() {
      if (!this.deferredPrompt) return;

      try {
        const result = await this.deferredPrompt.prompt();
        console.log('[PWA] Install prompt result:', result.outcome);

        if (result.outcome === 'accepted') {
          console.log('[PWA] User accepted install');
        } else {
          console.log('[PWA] User dismissed install');
        }

        this.deferredPrompt = null;
      } catch (error) {
        console.error('[PWA] Install prompt failed:', error);
      }
    }

    private showUpdateNotification() {
      const updateBanner = document.createElement('div');
      updateBanner.id = 'pwa-update-banner';
      updateBanner.className = 'fixed top-0 left-0 right-0 bg-blue-600 text-white px-4 py-3 shadow-lg z-50';
      updateBanner.innerHTML = `
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.864-.833-2.634 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
            <span>Нова верзија е достапна</span>
          </div>
          <div class="flex items-center gap-2">
            <button id="update-app-btn" class="px-3 py-1 bg-white text-blue-600 rounded hover:bg-blue-50 transition-colors text-sm">
              Ажурирај
            </button>
            <button id="dismiss-update-btn" class="px-3 py-1 bg-blue-700 text-white rounded hover:bg-blue-800 transition-colors text-sm">
              Игнорирај
            </button>
          </div>
        </div>
      `;

      document.body.appendChild(updateBanner);

      // Handle update button
      document.getElementById('update-app-btn')?.addEventListener('click', () => {
        this.updateApp();
        updateBanner.remove();
      });

      // Handle dismiss button
      document.getElementById('dismiss-update-btn')?.addEventListener('click', () => {
        updateBanner.remove();
      });
    }

    private async updateApp() {
      try {
        // Send message to service worker to skip waiting
        const registration = await navigator.serviceWorker.getRegistration();
        if (registration?.waiting) {
          registration.waiting.postMessage({ type: 'SKIP_WAITING' });
          // Reload after service worker activates
          registration.waiting.addEventListener('statechange', (event) => {
            if (event.target.state === 'activated') {
              window.location.reload();
            }
          });
        }
      } catch (error) {
        console.error('[PWA] Update failed:', error);
        // Fallback: reload anyway
        window.location.reload();
      }
    }

    private updateOnlineStatus() {
      const onlineIndicator = document.getElementById('online-status');
      if (onlineIndicator) {
        onlineIndicator.className = this.isOnline
          ? 'inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full'
          : 'inline-flex items-center gap-1 px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full';

        onlineIndicator.innerHTML = this.isOnline
          ? '<span class="w-2 h-2 bg-green-500 rounded-full"></span> Online'
          : '<span class="w-2 h-2 bg-red-500 rounded-full"></span> Offline';
      }
    }

    private async syncOfflineData() {
      if (!this.isOnline) return;

      try {
        // Trigger background sync for assessments
        if ('serviceWorker' in navigator && this.serviceWorkerRegistration) {
          await this.serviceWorkerRegistration.sync.register('assessment-sync');
        }

        console.log('[PWA] Offline data sync initiated');
      } catch (error) {
        console.error('[PWA] Sync failed:', error);
      }
    }

    private handleServiceWorkerMessage(event: MessageEvent) {
      const { type, data } = event.data;

      switch (type) {
        case 'CACHE_UPDATED':
          this.showNotification('Содржината е ажурирана', 'info');
          break;
        case 'SYNC_COMPLETE':
          this.showNotification('Податоците се синхронизирани', 'success');
          break;
        default:
          console.log('[PWA] Service worker message:', type, data);
      }
    }

    private showNotification(message: string, type: 'success' | 'error' | 'warning' | 'info' = 'info') {
      const colors = {
        success: 'bg-green-100 text-green-800 border-green-200',
        error: 'bg-red-100 text-red-800 border-red-200',
        warning: 'bg-yellow-100 text-yellow-800 border-yellow-200',
        info: 'bg-blue-100 text-blue-800 border-blue-200'
      };

      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 px-4 py-3 rounded-lg border ${colors[type]} shadow-lg z-50 max-w-sm`;
      notification.innerHTML = `
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0">
            ${type === 'success' ? '✅' : type === 'error' ? '❌' : type === 'warning' ? '⚠️' : 'ℹ️'}
          </div>
          <div class="flex-1 text-sm">${message}</div>
          <button class="flex-shrink-0 text-gray-400 hover:text-gray-600" onclick="this.parentElement.parentElement.remove()">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      `;

      document.body.appendChild(notification);

      setTimeout(() => {
        if (notification.parentElement) {
          notification.remove();
        }
      }, 4000);
    }

    // Public API methods
    public isOnlineStatus(): boolean {
      return this.isOnline;
    }

    public async requestNotificationPermission(): Promise<boolean> {
      if (!('Notification' in window)) {
        console.warn('[PWA] Notifications not supported');
        return false;
      }

      if (Notification.permission === 'granted') {
        return true;
      }

      if (Notification.permission === 'denied') {
        return false;
      }

      const permission = await Notification.requestPermission();
      return permission === 'granted';
    }

    public async sendTestNotification() {
      if (await this.requestNotificationPermission()) {
        const registration = await navigator.serviceWorker.getRegistration();
        if (registration) {
          registration.showNotification('Test Notification', {
            body: 'Ова е тест нотификација од Олимпијска Математика',
            icon: '/icons/icon-192x192.png',
            badge: '/icons/badge-72x72.png'
          });
        }
      }
    }

    public getCacheInfo(): Promise<any> {
      return navigator.serviceWorker.getRegistration().then(registration => {
        if (registration) {
          return registration.active?.postMessage({ type: 'GET_VERSION' });
        }
      });
    }
  }

  // Initialize PWA Manager when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    if (document.querySelector('[data-pwa-enabled]')) {
      console.log('[PWA] Initializing PWA Manager...');
      const pwaManager = new PWAManager();

      // Make globally available for debugging and manual control
      (window as any).pwaManager = pwaManager;

      console.log('[PWA] PWA Manager initialized successfully');
    }
  });

  // Export for use in other scripts
  (window as any).PWAManager = PWAManager;
</script>

<!-- PWA UI Elements -->
<div id="pwa-ui" class="fixed bottom-4 right-4 z-40">
  <!-- Install Button (hidden by default) -->
  <button
    id="install-pwa-btn"
    class="hidden inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors shadow-lg"
    style="display: none;"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
    </svg>
    Инсталирај апликација
  </button>

  <!-- Online Status Indicator -->
  <div id="online-status" class="inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full ml-2">
    <span class="w-2 h-2 bg-green-500 rounded-full"></span>
    Online
  </div>
</div>

<style>
  #pwa-ui {
    font-family: system-ui, sans-serif;
  }

  #install-pwa-btn {
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  /* Hide PWA UI on very small screens to avoid clutter */
  @media (max-width: 480px) {
    #pwa-ui {
      bottom: 1rem;
      right: 1rem;
    }

    #install-pwa-btn {
      font-size: 0.875rem;
      padding: 0.5rem 1rem;
    }
  }
</style>