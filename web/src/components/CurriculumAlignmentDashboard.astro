---
const { alignmentData } = Astro.props;
---

<div class="bg-white dark:bg-slate-900 rounded-3xl p-8 border border-slate-100 dark:border-slate-800 shadow-xl">
  <div class="flex items-center gap-3 mb-6">
    <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center">
      <span class="text-green-600 dark:text-green-400 text-xl">📊</span>
    </div>
    <div>
      <h3 class="text-xl font-bold text-slate-900 dark:text-white">Анализа на усогласеност со наставната програма</h3>
      <p class="text-slate-500 dark:text-slate-400 text-sm">Споредба помеѓу ученичкиот успех и стандардите</p>
    </div>
  </div>

  {alignmentData ? (
    <>
      <!-- Overall Alignment Score -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h4 class="text-lg font-semibold text-slate-900 dark:text-white">Вкупна усогласеност</h4>
          <div class="flex items-center gap-2">
            <div class="text-3xl font-bold {getScoreColor(alignmentData.overallAlignment.score)}">
              {Math.round(alignmentData.overallAlignment.score)}%
            </div>
            <span class="px-3 py-1 rounded-full text-sm font-medium {getLevelBadge(alignmentData.overallAlignment.level)}">
              {getLevelText(alignmentData.overallAlignment.level)}
            </span>
          </div>
        </div>
        <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-3">
          <div class={`h-3 rounded-full transition-all duration-500 ${getScoreColorBar(alignmentData.overallAlignment.score)}`}
               style={`width: ${alignmentData.overallAlignment.score}%`}></div>
        </div>
      </div>

      <!-- Subject Alignment -->
      {alignmentData.subjectAlignment && Object.keys(alignmentData.subjectAlignment).length > 0 && (
        <div class="mb-8">
          <h4 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Усогласеност по предмети</h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {Object.entries(alignmentData.subjectAlignment).map(([subject, analysis]: [string, any]) => (
              <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-4">
                <div class="flex items-center justify-between mb-2">
                  <h5 class="font-medium text-slate-900 dark:text-white">{getSubjectName(subject)}</h5>
                  <span class="text-lg font-bold {getScoreColor(analysis.score)}">
                    {Math.round(analysis.score)}%
                  </span>
                </div>
                <div class="text-sm text-slate-600 dark:text-slate-400 mb-2">
                  Покриеност: {Math.round(analysis.coverage)}%
                </div>
                <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2">
                  <div class={`h-2 rounded-full ${getScoreColorBar(analysis.score)}`}
                       style={`width: ${analysis.score}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Grade Level Alignment -->
      {alignmentData.gradeLevelAlignment && Object.keys(alignmentData.gradeLevelAlignment).length > 0 && (
        <div class="mb-8">
          <h4 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Усогласеност по одделенија</h4>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            {Object.entries(alignmentData.gradeLevelAlignment).map(([grade, analysis]: [string, any]) => (
              <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-4">
                <div class="flex items-center justify-between mb-3">
                  <h5 class="font-medium text-slate-900 dark:text-white">{grade}</h5>
                  <span class="text-lg font-bold {getScoreColor(analysis.score)}">
                    {Math.round(analysis.score)}%
                  </span>
                </div>

                {analysis.performanceIndicators && analysis.performanceIndicators.length > 0 && (
                  <div class="mb-3">
                    <div class="text-sm font-medium text-green-700 dark:text-green-400 mb-1">Силни страни:</div>
                    <ul class="text-sm text-slate-600 dark:text-slate-400 space-y-1">
                      {analysis.performanceIndicators.map((indicator: string) => (
                        <li class="flex items-center gap-2">
                          <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                          {indicator}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {analysis.gaps && analysis.gaps.length > 0 && (
                  <div class="mb-3">
                    <div class="text-sm font-medium text-orange-700 dark:text-orange-400 mb-1">Области за подобрување:</div>
                    <ul class="text-sm text-slate-600 dark:text-slate-400 space-y-1">
                      {analysis.gaps.map((gap: string) => (
                        <li class="flex items-center gap-2">
                          <span class="w-1.5 h-1.5 bg-orange-500 rounded-full"></span>
                          {gap}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                <div class="text-sm text-slate-500 dark:text-slate-500">
                  Теми во програмата: {analysis.curriculumCoverage}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Recommendations -->
      {alignmentData.recommendations && alignmentData.recommendations.length > 0 && (
        <div>
          <h4 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Препораки</h4>
          <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-4">
            <ul class="space-y-2">
              {alignmentData.recommendations.map((recommendation: string) => (
                <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
                  <span class="w-5 h-5 bg-blue-500 rounded-full flex items-center justify-center mt-0.5 flex-shrink-0">
                    <span class="text-white text-xs">💡</span>
                  </span>
                  {recommendation}
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
    </>
  ) : (
    <div class="text-center py-8">
      <div class="w-16 h-16 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="text-slate-400 text-2xl">📊</span>
      </div>
      <h4 class="text-lg font-medium text-slate-900 dark:text-white mb-2">Нема податоци за анализа</h4>
      <p class="text-slate-500 dark:text-slate-400">
        Анализата на усогласеност со наставната програма ќе биде достапна откако ќе се додадат податоци за стандардите.
      </p>
    </div>
  )}
</div>

<script>
  function getScoreColor(score: number): string {
    if (score >= 85) return 'text-green-600 dark:text-green-400';
    if (score >= 70) return 'text-blue-600 dark:text-blue-400';
    if (score >= 55) return 'text-yellow-600 dark:text-yellow-400';
    return 'text-red-600 dark:text-red-400';
  }

  function getScoreColorBar(score: number): string {
    if (score >= 85) return 'bg-green-500';
    if (score >= 70) return 'bg-blue-500';
    if (score >= 55) return 'bg-yellow-500';
    return 'bg-red-500';
  }

  function getLevelBadge(level: string): string {
    switch (level) {
      case 'excellent': return 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400';
      case 'good': return 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400';
      case 'adequate': return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400';
      case 'needs_improvement': return 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400';
      default: return 'bg-slate-100 text-slate-800 dark:bg-slate-700 dark:text-slate-400';
    }
  }

  function getLevelText(level: string): string {
    switch (level) {
      case 'excellent': return 'Одлично';
      case 'good': return 'Добро';
      case 'adequate': return 'Задоволително';
      case 'needs_improvement': return 'Потребно подобрување';
      default: return 'Непознато';
    }
  }

  function getSubjectName(subject: string): string {
    const subjectNames: { [key: string]: string } = {
      'mathematics': 'Математика',
      'language': 'Македонски јазик',
      'science': 'Природни науки',
      'history': 'Историја',
      'geography': 'Географија'
    };
    return subjectNames[subject] || subject;
  }
</script>