---
import { t } from '../utils/i18n';

export interface Props {
  initialValue?: string;
  placeholder?: string;
  className?: string;
  locale?: 'mk';
  standardsIntegration?: boolean;
  olympiadContext?: string;
}

const {
  initialValue = '',
  placeholder = t('math.latex_placeholder'),
  className = '',
  locale = 'mk',
  standardsIntegration = false,
  olympiadContext = ''
} = Astro.props;
---

<div class:list={["math-formula-editor-enhanced border border-gray-300 rounded-lg overflow-hidden bg-white", className]}>
  <div class="flex items-center justify-between p-3 bg-gray-50 border-b border-gray-200">
    <div class="flex items-center gap-2">
      <h3 class="text-sm font-medium text-gray-700" id="math-editor-title">{t('math.formula_editor')}</h3>
      <span class="text-xs text-gray-500 bg-gray-200 px-2 py-1 rounded">LaTeX</span>
      {standardsIntegration && olympiadContext && (
        <span class="text-xs text-blue-600 bg-blue-100 px-2 py-1 rounded">🏆 {olympiadContext}</span>
      )}
    </div>
    <div class="flex items-center gap-2">
      <button class="validate-btn text-xs px-2 py-1 bg-orange-100 text-orange-700 rounded hover:bg-orange-200" aria-label="Валидирај формула">
        Валидирај
      </button>
      <button class="history-btn text-xs px-2 py-1 bg-indigo-100 text-indigo-700 rounded hover:bg-indigo-200" aria-label="Историја на формули">
        Историја
      </button>
      <button class="export-btn text-xs px-2 py-1 bg-purple-100 text-purple-700 rounded hover:bg-purple-200" aria-label="Експортирај">
        {t('common.export')}
      </button>
      <button class="copy-btn text-xs px-2 py-1 bg-green-100 text-green-700 rounded hover:bg-green-200" aria-label={t('common.copy')}>
        {t('common.copy')}
      </button>
      <button class="preview-toggle text-xs px-2 py-1 bg-blue-100 text-blue-700 rounded hover:bg-blue-200" aria-pressed="false">
        {t('common.preview')}
      </button>
      <button class="help-btn text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200" aria-expanded="false" aria-controls="latex-help-guide">
        {t('common.help')}
      </button>
      <button class="handwriting-toggle relative z-20 text-xs px-2 py-1 bg-yellow-100 text-yellow-700 rounded hover:bg-yellow-200 flex items-center gap-1" aria-label="Режим за цртање">
        <span>✍️</span> Цртај
      </button>
    </div>
  </div>

  <div class="relative min-h-[14rem]">
    <label for="latex-editor-input" class="sr-only">{t('math.formula_editor')}</label>

    <textarea
      id="latex-editor-input"
      class="latex-input w-full h-48 p-3 font-mono text-sm border-0 resize-none focus:ring-0 focus:outline-none"
      placeholder={placeholder}
      spellcheck="false"
      aria-describedby="math-editor-title"
    >{initialValue}</textarea>

    <div class="handwriting-container absolute inset-0 bg-white hidden flex-col z-10">
        <canvas class="math-canvas w-full flex-grow border-b border-gray-200 cursor-crosshair touch-none"></canvas>

        <div class="flex items-center justify-between p-2 bg-gray-50 border-t text-xs">
            <span class="text-gray-500">Нацртај ја формулата...</span>
            <div class="flex gap-2">
                <button class="clear-canvas-btn px-2 py-1 bg-red-100 text-red-700 rounded hover:bg-red-200" aria-label="Избриши сè нацртано">
                    Избриши сè
                </button>
                <button class="recognize-btn px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 font-medium flex items-center gap-1" aria-label="Препознај ракопис">
                    <span class="recognize-icon">✨</span>
                    <span class="recognize-text">Претвори во LaTeX</span>
                </button>
            </div>
        </div>
        <div class="canvas-loading absolute inset-0 bg-white/80 hidden items-center justify-center flex-col">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mb-2"></div>
            <span class="text-xs text-blue-600 font-medium">AI Анализа...</span>
        </div>
    </div>

    <div class="math-preview absolute inset-0 p-6 opacity-0 transition-opacity bg-gradient-to-br from-blue-50 to-indigo-50 hidden overflow-y-auto overflow-x-hidden border border-blue-200 rounded pointer-events-none">
      <div class="preview-content text-xl leading-relaxed text-center py-8" aria-hidden="true"></div>
    </div>
  </div>

  <div class="border-t border-gray-200 bg-gray-50">
    <!-- Symbol Categories Tabs -->
    <div class="flex border-b border-gray-200 bg-white px-2 overflow-x-auto">
      <button class="tab-btn active px-3 py-2 text-xs font-medium border-b-2 border-blue-500 text-blue-600 whitespace-nowrap" data-tab="basic">Основни</button>
      <button class="tab-btn px-3 py-2 text-xs font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="geometry">Геометрија</button>
      <button class="tab-btn px-3 py-2 text-xs font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="algebra">Алгебра</button>
      <button class="tab-btn px-3 py-2 text-xs font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="calculus">Калкулус</button>
      <button class="tab-btn px-3 py-2 text-xs font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="logic">Логика</button>
      <button class="tab-btn px-3 py-2 text-xs font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="templates">Шаблони</button>
    </div>

    <!-- Basic Symbols -->
    <div class="symbol-tab active p-2" id="basic-tab">
      <div class="flex flex-wrap gap-1 text-xs" role="toolbar" aria-label="Основни математички симболи">
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="+" aria-label="Плус"> + </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="-" aria-label="Минус"> - </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\times" aria-label="Множење"> × </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\div" aria-label="Делење"> ÷ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="=" aria-label="Еднакво"> = </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\neq" aria-label="Не е еднакво"> ≠ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\sqrt{}" data-cursor-offset="-1" aria-label="Корен"> √ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\frac{}{}" data-cursor-offset="-3" aria-label="Дропка"> Frac </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="^{}" data-cursor-offset="-1" aria-label="Степен"> xʸ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="_{}" data-cursor-offset="-1" aria-label="Индекс"> xₙ </button>
      </div>
    </div>

    <!-- Geometry Symbols -->
    <div class="symbol-tab hidden p-2" id="geometry-tab">
      <div class="flex flex-wrap gap-1 text-xs" role="toolbar" aria-label="Геометриски симболи">
        <!-- Basic geometry -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\angle" aria-label="Агол"> ∠ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\Delta" aria-label="Триаголник"> Δ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\parallel" aria-label="Паралелно"> ∥ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\perp" aria-label="Перпендикуларно"> ⊥ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\cong" aria-label="Конгруентно"> ≅ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\sim" aria-label="Слично"> ∼ </button>

        <!-- Circles and arcs -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\bigcirc" aria-label="Круг"> ○ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\odot" aria-label="Круг со центар"> ⊙ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\bigodot" aria-label="Голем круг"> ⨀ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\measuredangle" aria-label="Измерен агол"> ∡ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\sphericalangle" aria-label="Сферичен агол"> ∢ </button>

        <!-- Lines and segments -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\overline{}" data-cursor-offset="-1" aria-label="Линија над"> AB </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\overrightarrow{}" data-cursor-offset="-1" aria-label="Вектор"> → </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\overleftrightarrow{}" data-cursor-offset="-1" aria-label="Линија"> ↔ </button>

        <!-- Shapes -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\square" aria-label="Квадрат"> □ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\triangle" aria-label="Триаголник"> △ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\diamond" aria-label="Ромб"> ◇ </button>
      </div>
    </div>

    <!-- Algebra Symbols -->
    <div class="symbol-tab hidden p-2" id="algebra-tab">
      <div class="flex flex-wrap gap-1 text-xs" role="toolbar" aria-label="Алгебарски симболи">
        <!-- Variables and constants -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="x" aria-label="x"> x </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="y" aria-label="y"> y </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="z" aria-label="z"> z </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="a" aria-label="a"> a </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="b" aria-label="b"> b </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="c" aria-label="c"> c </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="n" aria-label="n"> n </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="k" aria-label="k"> k </button>

        <!-- Functions -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="f(x)" aria-label="Функција"> f(x) </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="g(x)" aria-label="Функција g"> g(x) </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\log{}" data-cursor-offset="-1" aria-label="Логаритам"> log </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\ln{}" data-cursor-offset="-1" aria-label="Природен логаритам"> ln </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\exp{}" data-cursor-offset="-1" aria-label="Експоненцијална"> exp </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\sin{}" data-cursor-offset="-1" aria-label="Синус"> sin </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\cos{}" data-cursor-offset="-1" aria-label="Косинус"> cos </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\tan{}" data-cursor-offset="-1" aria-label="Тангенс"> tan </button>

        <!-- Operations -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\sum" aria-label="Сума"> ∑ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\prod" aria-label="Производ"> ∏ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\bigcup" aria-label="Унија"> ∪ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\bigcap" aria-label="Пресек"> ∩ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\emptyset" aria-label="Празно множество"> ∅ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\in" aria-label="Припаѓа"> ∈ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\notin" aria-label="Не припаѓа"> ∉ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\subset" aria-label="Подмножество"> ⊂ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\subseteq" aria-label="Подмножество еднакво"> ⊆ </button>

        <!-- Inequalities -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\approx" aria-label="Приближно"> ≈ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\equiv" aria-label="Еквивалентно"> ≡ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\propto" aria-label="Пропорционално"> ∝ </button>
      </div>
    </div>

    <!-- Calculus Symbols -->
    <div class="symbol-tab hidden p-2" id="calculus-tab">
      <div class="flex flex-wrap gap-1 text-xs" role="toolbar" aria-label="Калкулус симболи">
        <!-- Derivatives -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\frac{d}{dx}" aria-label="Дериват"> d/dx </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\partial" aria-label="Парцијален"> ∂ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\nabla" aria-label="Набла"> ∇ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="f'(x)" aria-label="Прва деривата"> f'(x) </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="f''(x)" aria-label="Втора деривата"> f''(x) </button>

        <!-- Integrals -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\int" aria-label="Интеграл"> ∫ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\iint" aria-label="Двоен интеграл"> ∬ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\iiint" aria-label="Троен интеграл"> ∭ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\oint" aria-label="Затворен интеграл"> ∮ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\int_{}^{}" data-cursor-offset="-4" aria-label="Дефинитен интеграл"> ∫ab </button>

        <!-- Limits -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\lim_{x \to }" data-cursor-offset="-1" aria-label="Лимес"> lim </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\infty" aria-label="Бесконечност"> ∞ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\to" aria-label="Стреличка"> → </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\Rightarrow" aria-label="Следува"> ⇒ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\Leftarrow" aria-label="Следува од"> ⇐ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\Leftrightarrow" aria-label="Еквивалентно"> ⇔ </button>
      </div>
    </div>

    <!-- Logic Symbols -->
    <div class="symbol-tab hidden p-2" id="logic-tab">
      <div class="flex flex-wrap gap-1 text-xs" role="toolbar" aria-label="Логички симболи">
        <!-- Logic operators -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\forall" aria-label="За секое"> ∀ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\exists" aria-label="Постоји"> ∃ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\neg" aria-label="Негација"> ¬ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\wedge" aria-label="И"> ∧ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\vee" aria-label="Или"> ∨ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\oplus" aria-label="Исклучно или"> ⊕ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\implies" aria-label="Следува"> ⟹ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\iff" aria-label="Еквивалентно"> ⟺ </button>

        <!-- Sets -->
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\mathbb{N}" aria-label="Природни броеви"> ℕ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\mathbb{Z}" aria-label="Цели броеви"> ℤ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\mathbb{Q}" aria-label="Рационални броеви"> ℚ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\mathbb{R}" aria-label="Реални броеви"> ℝ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\mathbb{C}" aria-label="Комплексни броеви"> ℂ </button>
        <button class="symbol-btn px-2 py-1 bg-white border border-gray-300 rounded hover:bg-blue-50" data-latex="\mathbb{P}" aria-label="Прим броеви"> ℙ </button>
      </div>
    </div>

    <!-- Templates -->
    <div class="symbol-tab hidden p-2" id="templates-tab">
      <div class="grid grid-cols-1 gap-2 text-xs">
        <!-- Algebraic equations -->
        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="x = \frac{-b \pm \sqrt{b^2 - 4ac}}{2a}">
          <div class="font-medium">Квадратна равенка</div>
          <div class="text-gray-500 text-xs">Решение на ax² + bx + c = 0</div>
        </button>
        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="a^2 + b^2 = c^2">
          <div class="font-medium">Питагора</div>
          <div class="text-gray-500 text-xs">a² + b² = c²</div>
        </button>

        <!-- Calculus -->
        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="\int_{a}^{b} f(x) \, dx = F(b) - F(a)">
          <div class="font-medium">Фундаментална теорема на калкулусот</div>
          <div class="text-gray-500 text-xs">∫f(x)dx = F(b) - F(a)</div>
        </button>
        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="\frac{d}{dx}[f(x) \cdot g(x)] = f'(x) \cdot g(x) + f(x) \cdot g'(x)">
          <div class="font-medium">Производно правило</div>
          <div class="text-gray-500 text-xs">(fg)' = f'g + fg'</div>
        </button>

        <!-- Geometry -->
        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="\sin^2 \theta + \cos^2 \theta = 1">
          <div class="font-medium">Основен тригонометриски идентитет</div>
          <div class="text-gray-500 text-xs">sin²θ + cos²θ = 1</div>
