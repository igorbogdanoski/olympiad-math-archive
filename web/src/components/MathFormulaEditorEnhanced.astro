        </button>
        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="S = \frac{a(r^n - 1)}{r - 1} \quad (r \neq 1)">
          <div class="font-medium">Геометриска прогресија</div>
