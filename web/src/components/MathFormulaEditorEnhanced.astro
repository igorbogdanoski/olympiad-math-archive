        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="S = \frac{1}{2}ab \sin C">
          <div class="font-medium">Плоштина на триаголник</div>
          <div class="text-gray-500 text-xs">S = (1/2)ab sin C</div>
        </button>

        <!-- Complex numbers -->
        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="z = a + bi">
          <div class="font-medium">Комплексен број</div>
          <div class="text-gray-500 text-xs">z = a + bi</div>
        </button>
        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="z_1 \cdot z_2 = (a_1a_2 - b_1b_2) + (a_1b_2 + a_2b_1)i">
          <div class="font-medium">Множење на комплексни броеви</div>
