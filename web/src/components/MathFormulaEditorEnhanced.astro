        <!-- Limits and analysis -->
        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="\lim_{x \to a} f(x) = L">
          <div class="font-medium">Дефиниција на лимес</div>
