</div>

<script>
  class MathFormulaEditorEnhanced {
    constructor(container) {
      this.container = container;
      this.textarea = container.querySelector('.latex-input');
      this.previewToggle = container.querySelector('.preview-toggle');
      this.copyBtn = container.querySelector('.copy-btn');
      this.validateBtn = container.querySelector('.validate-btn');
      this.historyBtn = container.querySelector('.history-btn');
      this.exportBtn = container.querySelector('.export-btn');
      this.helpBtn = container.querySelector('.help-btn');
      this.handwritingToggle = container.querySelector('.handwriting-toggle');
      this.handwritingContainer = container.querySelector('.handwriting-container');
      this.canvas = container.querySelector('.math-canvas');
      this.clearCanvasBtn = container.querySelector('.clear-canvas-btn');
      this.recognizeBtn = container.querySelector('.recognize-btn');
      this.canvasLoading = container.querySelector('.canvas-loading');
      this.ctx = this.canvas ? this.canvas.getContext('2d') : null;
      this.isDrawing = false;
      this.lastX = 0;
      this.lastY = 0;
      this.preview = container.querySelector('.math-preview');
      this.previewContent = container.querySelector('.preview-content');
      this.symbolBtns = container.querySelectorAll('.symbol-btn');
      this.templateBtns = container.querySelectorAll('.template-btn');
      this.tabBtns = container.querySelectorAll('.tab-btn');

      this.showPreview = false;
      this.formulaHistory = JSON.parse(localStorage.getItem('mathFormulaHistory') || '[]');

      // --- НОВО: Променливи за оптимизација на MathJax ---
      this.debounceTimer = null;
      this.isRendering = false;
      this.pendingText = null;
      this.checkMathJaxInterval = null;
      // ----------------------------------------------------

      this.init();
    }

    init() {
      this.bindEvents();
      this.loadHistory();
      
      // Додади listener за промена на големина на прозорецот за canvas-от
      window.addEventListener('resize', () => {
          if (!this.handwritingContainer.classList.contains('hidden')) {
              this.resizeCanvas();
          }
      });
    }

    bindEvents() {
      // Tab switching
      this.tabBtns.forEach(btn => {
        btn.addEventListener('click', () => this.switchTab(btn));
      });

      // Preview toggle
      this.previewToggle?.addEventListener('click', () => this.togglePreview());

      // Copy functionality
      this.copyBtn?.addEventListener('click', () => this.copyFormula());

      // Validation
      this.validateBtn?.addEventListener('click', () => this.validateFormula());

      // History
      this.historyBtn?.addEventListener('click', () => this.showHistory());

      // Export
      this.exportBtn?.addEventListener('click', () => this.showExportMenu());

      // Help
      this.helpBtn?.addEventListener('click', () => this.showHelpModal());

      // Handwriting
      this.handwritingToggle?.addEventListener('click', () => this.toggleHandwritingMode());
      this.clearCanvasBtn?.addEventListener('click', () => this.clearCanvas());
      this.recognizeBtn?.addEventListener('click', () => this.recognizeHandwriting());
      this.initCanvasEvents();

      // Symbol buttons
      this.symbolBtns.forEach(btn => {
        btn.addEventListener('click', (e) => this.insertSymbol(e, btn));
      });

      // Template buttons
      this.templateBtns.forEach(btn => {
        btn.addEventListener('click', (e) => this.insertTemplate(e, btn));
      });

      // ОПТИМИЗИРАН INPUT EVENT
      this.textarea?.addEventListener('input', () => {
        this.autoSaveToHistory();
        if (this.showPreview) {
          this.debouncedPreviewUpdate();
        }
      });
    }

    switchTab(activeBtn) {
      this.tabBtns.forEach(btn => {
        btn.classList.remove('active', 'border-b-2', 'border-blue-500', 'text-blue-600');
        btn.classList.add('text-gray-500');
      });

      activeBtn.classList.add('active', 'border-b-2', 'border-blue-500', 'text-blue-600');
      activeBtn.classList.remove('text-gray-500');

      const symbolTabs = this.container.querySelectorAll('.symbol-tab');
      symbolTabs.forEach(tab => tab.classList.add('hidden'));

      const tabId = activeBtn.getAttribute('data-tab') + '-tab';
      const activeTab = this.container.querySelector('#' + tabId);
      if (activeTab) {
        activeTab.classList.remove('hidden');
      }
    }

    togglePreview() {
      this.showPreview = !this.showPreview;
      this.textarea.classList.toggle('hidden', this.showPreview);
      this.preview.classList.toggle('hidden', !this.showPreview);
      this.preview.classList.toggle('opacity-0', !this.showPreview);
      this.preview.classList.toggle('opacity-100', this.showPreview);
      this.previewToggle.textContent = this.showPreview ? 'Уреди' : 'Преглед';
      this.previewToggle.setAttribute('aria-pressed', this.showPreview);

      if (this.showPreview && this.textarea.value) {
        // Почекај малку за да се прикаже елементот пред да рендерираш
        setTimeout(() => {
          this.safeRender();
        }, 100);
      }
    }

    // --- НОВА ФУНКЦИЈА: DEBOUNCE LOGIC ---
    debouncedPreviewUpdate() {
      // Ако корисникот куца, ресетирај го тајмерот
      if (this.debounceTimer) clearTimeout(this.debounceTimer);

      // Почекај 300ms откако ќе престане да куца, па рендерирај
      this.debounceTimer = setTimeout(() => {
        this.safeRender();
      }, 300);
    }

    // --- ПОПРАВЕНА ФУНКЦИЈА ЗА РЕНДЕРИРАЊЕ ---
    async safeRender() {
      let rawLatex = this.textarea.value.trim();

      // 1. АКО нема текст, исчисти го прегледот и излези
      if (!rawLatex) {
         this.previewContent.innerHTML = '';
         return;
      }

      // 2. ИТНО: Исчисти ги рачно внесените делимитери за да нема дуплирање
      rawLatex = rawLatex
          .replace(/^\\\[|\\\]$/g, '')
          .replace(/^\\\(|\\\)$/g, '')
          .replace(/^\$\$|\$\$/g, '')
          .replace(/^\$|\$/g, '');

      // 3. Проверка дали веќе се рендерира (Locking mechanism)
      if (this.isRendering) {
         this.pendingText = rawLatex;
         return;
      }

      this.isRendering = true;

      try {
         // 4. Постави содржина со делимитери
         // Ако веќе почнува со \begin{...}, не додавај \[ \]
         const isEnvironment = /^\s*\\begin\{/.test(rawLatex);
         this.previewContent.innerHTML = isEnvironment ? rawLatex : '\\[' + rawLatex + '\\]';

         // 5. Провери дали MathJax е навистина вчитан и спремен
         const isMathJaxReady = window.MathJax && (typeof window.MathJax.typesetPromise === 'function' || typeof window.MathJax.typeset === 'function');

         if (isMathJaxReady) {
            console.log('MathJax is ready, rendering...');

            if (window.MathJax.tex && window.MathJax.tex.reset) {
                window.MathJax.tex.reset();
            }

            if (typeof window.MathJax.typesetPromise === 'function') {
                await window.MathJax.typesetPromise([this.previewContent]);
            } else if (typeof window.MathJax.typeset === 'function') {
                window.MathJax.typeset([this.previewContent]);
            }
         } else {
            console.warn('MathJax is NOT ready yet');
            this.fallbackRender();
         }
      } catch (err) {
         console.warn('MathJax rendering error:', err);
         this.fallbackRender();
      } finally {
         this.isRendering = false;

         if (this.pendingText !== null) {
            this.pendingText = null;
            this.safeRender();
         }
      }
    }

    fallbackRender() {
      const escapedValue = this.textarea.value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

      const mj = window.MathJax;
      const isMissing = !mj || (!mj.typesetPromise && !mj.typeset);
      
      const statusMessage = isMissing 
        ? "Се вчитува MathJax рендерер..." 
        : "Грешка при рендерирање. Проверете ја LaTeX синтаксата.";

      this.previewContent.innerHTML = `
        <div class="text-center p-4 bg-blue-50 border border-blue-200 rounded">
          <div class="text-blue-800 font-semibold mb-2">📐 LaTeX Формула (Преглед)</div>
          <div class="font-mono text-sm bg-white p-3 rounded border whitespace-pre-wrap">\\[${escapedValue}\\]</div>
          <div class="text-xs text-blue-600 mt-2">${statusMessage}</div>
        </div>
      `;
      
      if (isMissing && !this.checkMathJaxInterval) {
          this.checkMathJaxInterval = setInterval(() => {
              const currentMj = window.MathJax;
              if (currentMj && (currentMj.typesetPromise || currentMj.typeset)) {
                  clearInterval(this.checkMathJaxInterval);
                  this.checkMathJaxInterval = null;
                  if (this.showPreview) this.safeRender();
              }
          }, 500);
          
          setTimeout(() => {
              if (this.checkMathJaxInterval) {
                  clearInterval(this.checkMathJaxInterval);
                  this.checkMathJaxInterval = null;
              }
          }, 10000);
      }
    }

    copyFormula() {
      if (this.textarea.value) {
        navigator.clipboard.writeText(this.textarea.value).then(() => {
          const originalText = this.copyBtn.textContent;
          this.copyBtn.textContent = 'Копирано!';
          setTimeout(() => {
            this.copyBtn.textContent = originalText;
          }, 2000);
        });
      }
    }

    validateFormula() {
      if (!this.textarea.value) return;

      const latex = this.textarea.value.trim();
      let isValid = true;
      let errorMessage = '';

      const openBraces = (latex.match(/\{/g) || []).length;
      const closeBraces = (latex.match(/\}/g) || []).length;
      if (openBraces !== closeBraces) {
        isValid = false;
        errorMessage = 'Небалансирани загради {}';
      }

      if (latex.includes('$$') && latex.split('$$').length % 2 === 0) {
        isValid = false;
        errorMessage = 'Невалидни $$ ознаки';
      }

      // Check for \begin and \end environments
      const beginMatches = latex.match(/\\begin\{([^}]+)\}/g) || [];
      const endMatches = latex.match(/\\end\{([^}]+)\}/g) || [];
      
      if (beginMatches.length !== endMatches.length) {
        isValid = false;
        errorMessage = 'Небалансирани \begin и \end';
      } else if (beginMatches.length > 0) {
        // Extract environment names and check if they match in order (LIFO)
        const stack = [];
        const envRegex = /\\(begin|end)\{([^}]+)\}/g;
        let match;
        while ((match = envRegex.exec(latex)) !== null) {
          const [_, type, name] = match;
          if (type === 'begin') {
            stack.push(name);
          } else {
            const last = stack.pop();
            if (last !== name) {
              isValid = false;
              errorMessage = `Грешка во околината: очекувано \end{${last}}, но најдено \end{${name}}`;
              break;
            }
          }
        }
      }

      if (isValid) {
        this.validateBtn.textContent = '✓ Валидна';
        this.validateBtn.classList.remove('bg-orange-100', 'text-orange-700');
        this.validateBtn.classList.add('bg-green-100', 'text-green-700');
        setTimeout(() => {
          this.validateBtn.textContent = 'Валидирај';
          this.validateBtn.classList.remove('bg-green-100', 'text-green-700');
          this.validateBtn.classList.add('bg-orange-100', 'text-orange-700');
        }, 3000);
      } else {
        this.validateBtn.textContent = '✗ ' + errorMessage;
        this.validateBtn.classList.remove('bg-orange-100', 'text-orange-700');
        this.validateBtn.classList.add('bg-red-100', 'text-red-700');
        setTimeout(() => {
          this.validateBtn.textContent = 'Валидирај';
          this.validateBtn.classList.remove('bg-red-100', 'text-red-700');
          this.validateBtn.classList.add('bg-orange-100', 'text-orange-700');
        }, 5000);
      }
    }

    showHelpModal() {
      const modal = this.container.querySelector('.latex-help-modal');
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.setAttribute('aria-hidden', 'false');

        // Add event listeners for closing
        const closeBtns = modal.querySelectorAll('.close-help-btn');
        closeBtns.forEach(btn => {
          btn.addEventListener('click', () => this.hideHelpModal());
        });

        // Close on background click
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            this.hideHelpModal();
          }
        });

        // Close on Escape key
        const handleEscape = (e) => {
          if (e.key === 'Escape') {
            this.hideHelpModal();
            document.removeEventListener('keydown', handleEscape);
          }
        };
        document.addEventListener('keydown', handleEscape);
      }
    }

    hideHelpModal() {
      const modal = this.container.querySelector('.latex-help-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.setAttribute('aria-hidden', 'true');
      }
    }

    showHistory() {
      if (this.formulaHistory.length === 0) {
        alert('Нема зачувани формули во историјата.');
        return;
      }

      const historyMenu = document.createElement('div');
      historyMenu.className = 'absolute top-full right-0 mt-1 bg-white border border-gray-300 rounded shadow-lg z-10 max-h-64 overflow-y-auto';
      historyMenu.style.width = '300px';

      historyMenu.innerHTML = `
        <div class="p-2 border-b border-gray-200">
          <h4 class="text-sm font-medium text-gray-900">Историја на формули</h4>
        </div>
        ${this.formulaHistory.map((formula) => `
          <button class="block w-full text-left px-3 py-2 text-sm hover:bg-gray-100 border-b border-gray-100 history-item" data-formula="${formula.replace(/"/g, '"')}">
            <div class="truncate font-mono text-xs">${formula}</div>
          </button>
        `).join('')}
        <div class="p-2 border-t border-gray-200">
          <button class="text-xs text-red-600 hover:text-red-800 clear-history-btn">Исчисти историја</button>
        </div>
      `;

      this.historyBtn.parentNode.appendChild(historyMenu);

      historyMenu.querySelectorAll('.history-item').forEach(btn => {
        btn.addEventListener('click', () => {
          const formula = btn.getAttribute('data-formula');
          this.textarea.value = formula;
          this.textarea.focus();
          if (this.showPreview) {
            this.safeRender();
          }
          historyMenu.remove();
        });
      });

      historyMenu.querySelector('.clear-history-btn').addEventListener('click', () => {
        if (confirm('Дали сте сигурни дека сакате да ја исчистите историјата?')) {
          this.formulaHistory = [];
          localStorage.removeItem('mathFormulaHistory');
          historyMenu.remove();
        }
      });

      const closeMenu = (e) => {
        if (!historyMenu.contains(e.target) && e.target !== this.historyBtn) {
          historyMenu.remove();
          document.removeEventListener('click', closeMenu);
        }
      };
      setTimeout(() => document.addEventListener('click', closeMenu), 0);
    }

    showExportMenu() {
      if (!this.textarea.value) return;

      const exportMenu = document.createElement('div');
      exportMenu.className = 'absolute top-full right-0 mt-1 bg-white border border-gray-300 rounded shadow-lg z-10 p-2';
      exportMenu.innerHTML = `
        <button class="block w-full text-left px-3 py-2 text-sm hover:bg-gray-100 export-latex-btn">LaTeX код</button>
        <button class="block w-full text-left px-3 py-2 text-sm hover:bg-gray-100 export-png-btn">PNG слика</button>
        <button class="block w-full text-left px-3 py-2 text-sm hover:bg-gray-100 export-svg-btn">SVG слика</button>
      `;

      this.exportBtn.parentNode.appendChild(exportMenu);

      exportMenu.querySelector('.export-latex-btn').addEventListener('click', () => {
        this.exportAsLatex(this.textarea.value);
        exportMenu.remove();
      });

      exportMenu.querySelector('.export-png-btn').addEventListener('click', () => {
        this.exportAsPNG(this.textarea.value);
        exportMenu.remove();
      });

      exportMenu.querySelector('.export-svg-btn').addEventListener('click', () => {
        this.exportAsSVG(this.textarea.value);
        exportMenu.remove();
      });

      const closeMenu = (e) => {
        if (!exportMenu.contains(e.target) && e.target !== this.exportBtn) {
          exportMenu.remove();
          document.removeEventListener('click', closeMenu);
        }
      };
      setTimeout(() => document.addEventListener('click', closeMenu), 0);
    }

    exportAsLatex(latex) {
      const blob = new Blob([latex], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'math-formula.tex';
      a.click();
      URL.revokeObjectURL(url);
    }

    exportAsPNG(latex) {
      const tempDiv = document.createElement('div');
      tempDiv.style.position = 'absolute';
      tempDiv.style.left = '-9999px';
      tempDiv.style.padding = '20px';
      tempDiv.style.background = 'white';
      tempDiv.style.fontSize = '24px'; // Make it larger for better quality
      tempDiv.innerHTML = '\\[' + latex + '\\]';
      document.body.appendChild(tempDiv);

      if (window.MathJax && window.MathJax.typesetPromise) {
        window.MathJax.typesetPromise([tempDiv]).then(() => {
          const mjxElement = tempDiv.querySelector('mjx-container');
          const svgElement = tempDiv.querySelector('svg');
          
          if (svgElement) {
            // Get original dimensions
            const bbox = svgElement.getBBox ? svgElement.getBBox() : { width: svgElement.clientWidth, height: svgElement.clientHeight };
            const svgData = new XMLSerializer().serializeToString(svgElement);
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            const img = new Image();

            img.onload = () => {
              // Scale up for better resolution
              const scale = 2;
              canvas.width = img.width * scale;
              canvas.height = img.height * scale;
              ctx.fillStyle = 'white';
              ctx.fillRect(0, 0, canvas.width, canvas.height);
              ctx.scale(scale, scale);
              ctx.drawImage(img, 0, 0);

              canvas.toBlob((blob) => {
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `math-${Date.now()}.png`;
                a.click();
                URL.revokeObjectURL(url);
              }, 'image/png');
            };

            img.src = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgData)));
          }
          document.body.removeChild(tempDiv);
        });
      }
    }

    exportAsSVG(latex) {
      const tempDiv = document.createElement('div');
      tempDiv.style.position = 'absolute';
      tempDiv.style.left = '-9999px';
      tempDiv.style.fontSize = '24px';
      tempDiv.innerHTML = '\\[' + latex + '\\]';
      document.body.appendChild(tempDiv);

      if (window.MathJax && window.MathJax.typesetPromise) {
        window.MathJax.typesetPromise([tempDiv]).then(() => {
          const svgElement = tempDiv.querySelector('svg');
          if (svgElement) {
            // Add XML namespace if missing
            if (!svgElement.getAttribute('xmlns')) {
              svgElement.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
            }
            const svgData = new XMLSerializer().serializeToString(svgElement);
            const blob = new Blob(['<?xml version="1.0" encoding="UTF-8" standalone="no"?>\n' + svgData], { type: 'image/svg+xml' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `math-${Date.now()}.svg`;
            a.click();
            URL.revokeObjectURL(url);
          }
          document.body.removeChild(tempDiv);
        });
      }
    }

    insertSymbol(e, btn) {
      e.preventDefault();

      // 1. Земи ги податоците од копчето
      const symbol = btn.getAttribute('data-latex');
      // Ако нема offset атрибут, сметај го за 0
      const offset = parseInt(btn.getAttribute('data-cursor-offset') || '0');

      // 2. Земи ја моменталната позиција и селекција
      const start = this.textarea.selectionStart;
      const end = this.textarea.selectionEnd;
      const selection = this.textarea.value.substring(start, end);
      const fullText = this.textarea.value;

      let textToInsert = symbol;
      let newCursorPos = 0;

      // --- ЕКСПЕРТСКА ЛОГИКА ЗА "WRAPPING" (Обвиткување) ---
      // Ако има селектиран текст и симболот содржи {}, стави го текстот внатре
      if (selection && symbol.includes('{}')) {
          // На пример: ако симболот е \sqrt{} а селекцијата е "5", станува \sqrt{5}
          // Replace го заменува само првото појавување на {}, што е точно тоа што ни треба
          textToInsert = symbol.replace('{}', `{${selection}}`);

          // Во овој случај, курсорот го ставаме на крајот од вметнатото
          newCursorPos = start + textToInsert.length;
      }
      else {
          // --- СТАНДАРДНА ЛОГИКА СО OFFSET ---
          // Нема селекција, само вметни го симболот
          textToInsert = symbol;

          // Пресметај каде треба да биде курсорот
          // start (почеток) + должина на симболот + offset (кој е негативен)
          newCursorPos = start + symbol.length + offset;
      }

      // 3. Ажурирај го текстот во textarea
      this.textarea.value =
          fullText.substring(0, start) +
          textToInsert +
          fullText.substring(end);

      // 4. Врати го фокусот и постави го курсорот на вистинското место
      this.textarea.focus();
      this.textarea.setSelectionRange(newCursorPos, newCursorPos);

      // 5. Повикај ги функциите за зачувување и преглед (користејќи го новиот debounce од претходно)
      this.autoSaveToHistory();
      if (this.showPreview) {
        this.debouncedPreviewUpdate(); // Ова е функцијата што ја додадовме во претходниот чекор
      }
    }

    insertTemplate(e, btn) {
      e.preventDefault();
      const template = btn.getAttribute('data-latex');
      this.textarea.value = template;
      this.textarea.focus();

      if (this.showPreview) {
        this.safeRender();
      }
      this.autoSaveToHistory();
    }

    autoSaveToHistory() {
      const currentValue = this.textarea.value;
      if (currentValue && currentValue !== this.lastSavedValue && currentValue.length > 3) {
        clearTimeout(this.saveTimeout);
        this.saveTimeout = setTimeout(() => {
          if (!this.formulaHistory.includes(currentValue)) {
            this.formulaHistory.unshift(currentValue);
            this.formulaHistory = this.formulaHistory.slice(0, 20);
            localStorage.setItem('mathFormulaHistory', JSON.stringify(this.formulaHistory));
            this.lastSavedValue = currentValue;
          }
        }, 1000);
      }
    }

    loadHistory() {
      this.lastSavedValue = this.textarea.value;
    }

    toggleHandwritingMode() {
        const isHidden = this.handwritingContainer.classList.contains('hidden');

        if (isHidden) {
            // Вклучи режим за цртање
            // Запомни дали прегледот бил вклучен пред да влеземе во handwriting
            this.wasPreviewOpenBeforeHandwriting = this.showPreview;
            
            this.handwritingContainer.classList.remove('hidden');
            this.handwritingContainer.classList.add('flex');
            if (this.preview) {
                this.preview.classList.add('hidden');
                this.preview.classList.remove('opacity-100');
                this.preview.classList.add('opacity-0');
            }
            if (this.textarea) this.textarea.classList.remove('hidden'); // Show textarea to see results
            
            // Важно: почекај да се појави елементот пред да сетираш резолуција
            requestAnimationFrame(() => {
                this.resizeCanvas();
            });
            
            this.handwritingToggle.classList.add('bg-yellow-200', 'ring-2', 'ring-yellow-400');
        } else {
            // Исклучи режим за цртање
            this.handwritingContainer.classList.add('hidden');
            this.handwritingContainer.classList.remove('flex');
            this.handwritingToggle.classList.remove('bg-yellow-200', 'ring-2', 'ring-yellow-400');
            
            // Врати ја состојбата на прегледот ако била претходно активна
            if (this.wasPreviewOpenBeforeHandwriting && !this.showPreview) {
                this.togglePreview();
            } else if (this.showPreview) {
                // Ако е веќе отворен прегледот (пр. после препознавање), осигурај се дека е видлив
                this.preview.classList.remove('hidden');
                this.preview.classList.remove('opacity-0');
                this.preview.classList.add('opacity-100');
                this.textarea.classList.add('hidden');
            }
        }
    }

    resizeCanvas() {
        // Го прави канвасот остар (Retina support) и точна големина
        const rect = this.canvas.parentElement.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        
        // Постави димензии на самиот елемент (backing store)
        this.canvas.width = rect.width * dpr;
        this.canvas.height = (rect.height - 40) * dpr;
        
        // Постави CSS димензии (display size)
        this.canvas.style.width = `${rect.width}px`;
        this.canvas.style.height = `${rect.height - 40}px`;

        // Ресетирај го контекстот по промена на големина
        this.ctx.scale(dpr, dpr);
        this.ctx.lineWidth = 3;
        this.ctx.lineCap = 'round';
        this.ctx.lineJoin = 'round';
        this.ctx.strokeStyle = '#2563eb'; // Модерна сина боја
    }

    initCanvasEvents() {
        if (!this.canvas) return;

        const startDrawing = (e) => {
            this.isDrawing = true;
            const { x, y } = this.getCoords(e);
            this.lastX = x;
            this.lastY = y;
        };

        const draw = (e) => {
            if (!this.isDrawing) return;
            e.preventDefault(); // Спречи скролање на мобилен додека црта
            const { x, y } = this.getCoords(e);

            this.ctx.beginPath();
            this.ctx.moveTo(this.lastX, this.lastY);
            this.ctx.lineTo(x, y);
            this.ctx.stroke();

            this.lastX = x;
            this.lastY = y;
        };

        const stopDrawing = () => {
            this.isDrawing = false;
        };

        // Mouse Events
        this.canvas.addEventListener('mousedown', startDrawing);
        this.canvas.addEventListener('mousemove', draw);
        this.canvas.addEventListener('mouseup', stopDrawing);
        this.canvas.addEventListener('mouseout', stopDrawing);

        // Touch Events (за мобилен/таблет)
        this.canvas.addEventListener('touchstart', startDrawing, { passive: false });
        this.canvas.addEventListener('touchmove', draw, { passive: false });
        this.canvas.addEventListener('touchend', stopDrawing);
    }

    getCoords(e) {
        // Универзален метод за координати (Mouse & Touch)
        const rect = this.canvas.getBoundingClientRect();
        let clientX, clientY;
        
        if (e.touches && e.touches.length > 0) {
            clientX = e.touches[0].clientX;
            clientY = e.touches[0].clientY;
        } else {
            clientX = e.clientX;
            clientY = e.clientY;
        }
        
        // Враќаме координати релативни на CSS големината на канвасот
        // Поради ctx.scale(dpr, dpr), овие координати ќе бидат точни
        return {
            x: clientX - rect.left,
            y: clientY - rect.top
        };
    }

    clearCanvas() {
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    }

    // --- ГЛАВНАТА MAGIC ФУНКЦИЈА (СЕГА СО ВИСТИНСКО AI) ---
    async recognizeHandwriting() {
        // 1. Провери дали има нешто нацртано
        const pixels = this.ctx.getImageData(0, 0, this.canvas.width, this.canvas.height).data;
        const hasContent = pixels.some(p => p !== 0);
        
        if (!hasContent) {
            alert('Ве молиме нацртајте нешто прво.');
            return;
        }

        // 2. Земи ја сликата како Base64
        const imageData = this.canvas.toDataURL('image/png');

        // 3. Покажи loading
        this.canvasLoading.classList.remove('hidden');
        this.canvasLoading.classList.add('flex');
        
        const btnText = this.recognizeBtn.querySelector('.recognize-text');
        const btnIcon = this.recognizeBtn.querySelector('.recognize-icon');
        const originalText = btnText ? btnText.textContent : '';
        if (btnText) btnText.textContent = 'Препознавање...';
        if (btnIcon) btnIcon.classList.add('animate-pulse');
        this.recognizeBtn.disabled = true;

        try {
            // ПОВИКУВАЊЕ НА ВИСТИНСКИОТ API ЕНДПОИНТ (Gemini 1.5 Flash)
            const response = await fetch('/api/vision-latex', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ image: imageData })
            });

            if (!response.ok) {
                throw new Error('API грешка');
            }

            const result = await response.json();
            const latex = result.latex;

            if (!latex) {
                throw new Error('Не беше пронајдена формула');
            }

            // 4. Вметни го резултатот
            this.textarea.value = latex;

            // 5. Затвори го Canvas и покажи го резултатот
            this.toggleHandwritingMode();
            this.safeRender(); 
            this.autoSaveToHistory();
            this.clearCanvas(); // Исчисти по успешна операција

        } catch (err) {
            alert('Грешка при препознавање. Проверете ја интернет конекцијата или обидете се повторно.');
            console.error('Handwriting Recognition Error:', err);
        } finally {
            this.canvasLoading.classList.add('hidden');
            this.canvasLoading.classList.remove('flex');
            
            if (btnText) btnText.textContent = originalText;
            if (btnIcon) btnIcon.classList.remove('animate-pulse');
            this.recognizeBtn.disabled = false;
        }
    }
  }

  // Initialize editors safely
  const initEditors = () => {
    document.querySelectorAll('.math-formula-editor-enhanced:not([data-initialized])').forEach(container => {
      container.setAttribute('data-initialized', 'true');
      new MathFormulaEditorEnhanced(container);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEditors);
  } else {
    initEditors();
  }
</script>

