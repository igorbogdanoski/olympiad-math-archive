        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="\begin{cases} x + y = 10 \\ x - y = 2 \end{cases}">
          <div class="font-medium">Систем равенки</div>
          <div class="text-gray-500 text-xs">Систем од две линеарни равенки</div>
        </button>
        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="\vec{v} = (v_1, v_2, v_3)">
