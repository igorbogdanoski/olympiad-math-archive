        </button>

        <!-- Linear algebra -->
        <button class="template-btn p-2 bg-white border border-gray-300 rounded hover:bg-blue-50 text-left" data-latex="\det \begin{pmatrix} a & b \\ c & d \end{pmatrix} = ad - bc">
          <div class="font-medium">Детерминанта 2x2</div>
