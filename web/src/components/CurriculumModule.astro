---
interface Topic {
  name: string;
  hours: number;
  objectives: string[];
  standards: string[];
}

interface GradeData {
  title: string;
  total_hours: number;
  weekly_hours: number;
  topics: Topic[];
}

interface Props {
  grade: string;
  section: string;
  gradeData: GradeData;
}

const { grade, section, gradeData } = Astro.props;
---

<div class="curriculum-module bg-white rounded-xl border shadow-sm p-6">
  <!-- Module Header -->
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-2">
      {gradeData.title}
    </h2>
    <div class="flex items-center gap-4 text-sm text-gray-600">
      <span class="flex items-center">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Вкупно часови: {gradeData.total_hours}
      </span>
      <span class="flex items-center">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v6a2 2 0 002 2h6a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        Неделно: {gradeData.weekly_hours} часа
      </span>
    </div>
  </div>

  <!-- Topics List -->
  <div class="space-y-4">
    <h3 class="text-lg font-semibold text-gray-700 mb-4">
      Наставни единици ({gradeData.topics.length})
    </h3>

    {gradeData.topics.map((topic, index) => (
      <div class="topic-card border border-gray-200 rounded-lg overflow-hidden hover:shadow-md transition-shadow">
        <!-- Topic Header -->
        <div
          class="topic-header bg-gray-50 px-4 py-3 cursor-pointer flex items-center justify-between"
          onclick={`toggleTopic('${topic.name}')`}
        >
          <div class="flex items-center">
            <h4 class="font-medium text-gray-800">{topic.name}</h4>
            <span class="ml-2 text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">
              {topic.hours}ч
            </span>
          </div>
          <div class="flex items-center">
            <button
              class="mr-3 px-3 py-1 bg-indigo-100 text-indigo-700 rounded hover:bg-indigo-200 transition-colors text-sm"
              onclick={`selectTopic(${JSON.stringify(topic).replace(/'/g, "\\'")})`}
            >
              Избери
            </button>
            <svg
              class="w-5 h-5 text-gray-500 transform transition-transform topic-chevron"
              data-topic={topic.name}
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </div>

        <!-- Topic Details -->
        <div class="topic-details p-4 bg-white border-t border-gray-200 hidden" data-topic={topic.name}>
          <!-- Learning Objectives -->
          <div class="mb-4">
            <h5 class="font-medium text-gray-700 mb-2 flex items-center">
              <svg class="w-4 h-4 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Цели на учење
            </h5>
            <ul class="list-disc list-inside text-sm text-gray-600 space-y-1">
              {topic.objectives.map((objective) => (
                <li>{objective}</li>
              ))}
            </ul>
          </div>

          <!-- Standards -->
          <div>
            <h5 class="font-medium text-gray-700 mb-2 flex items-center">
              <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              Стандарди
            </h5>
            <ul class="list-disc list-inside text-sm text-gray-600 space-y-1">
              {topic.standards.map((standard) => (
                <li>{standard}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  function toggleTopic(topicName: string) {
    const details = document.querySelector(`[data-topic="${topicName}"].topic-details`) as HTMLElement;
    const chevron = document.querySelector(`[data-topic="${topicName}"].topic-chevron`) as HTMLElement;

    if (details && chevron) {
      const isHidden = details.classList.contains('hidden');
      if (isHidden) {
        details.classList.remove('hidden');
        chevron.style.transform = 'rotate(180deg)';
      } else {
        details.classList.add('hidden');
        chevron.style.transform = 'rotate(0deg)';
      }
    }
  }

  function selectTopic(topic: any) {
    // Dispatch custom event to parent component
    const event = new CustomEvent('topicSelected', { detail: topic });
    document.dispatchEvent(event);
  }

  // Make functions globally available
  (window as any).toggleTopic = toggleTopic;
  (window as any).selectTopic = selectTopic;
</script>