---
interface Props {
  category?: string;
  compact?: boolean;
}

const { category = 'general', compact = false } = Astro.props;

const quotes = {
  geometry: [
    {
      text: "Геометријата е мост помеѓу светот на идеите и светот на чувствата.",
      author: "Платон",
      context: "За улогата на геометријата во разбирањето"
    },
    {
      text: "Во геометријата, она што не е дефинирано не може да се докаже.",
      author: "Евклид",
      context: "Основно правило во математичките докази"
    }
  ],
  algebra: [
    {
      text: "Броевите се слободните творби на човековиот ум.",
      author: "Рихард Дедекинд",
      context: "За природата на математичките концепти"
    },
    {
      text: "Алгебрата е генерализација на аритметиката.",
      author: "Џозеф Луј Лагранж",
      context: "За развојот на алгебарските методи"
    }
  ],
  general: [
    {
      text: "Математиката е јазикот кој Бог го користел за да создаде универзумот.",
      author: "Галилео Галилеј",
      context: "За универзалната моќ на математиката"
    },
    {
      text: "Во математиката процесот на откривање на вистината е исто толку важен колку и самата вистина.",
      author: "Карл Фридрих Гаус",
      context: "За важноста на математичкото истражување"
    },
    {
      text: "Математиката е најсовршената форма на уметноста.",
      author: "Џозеф Жубер",
      context: "За естетската димензија на математиката"
    }
  ],
  olympiad: [
    {
      text: "Решението на секој проблем е повеќе вредно од самиот проблем.",
      author: "Рихард Фајнман",
      context: "За вредноста на математичкото решавање"
    },
    {
      text: "Математиката е уметноста да се дава исти имиња на различни работи.",
      author: "Анри Поенкаре",
      context: "За суштината на математичката апстракција"
    }
  ]
};

// Select a random quote from the category
const categoryQuotes = quotes[category] || quotes.general;
const randomIndex = Math.floor(Math.random() * categoryQuotes.length);
const quote = categoryQuotes[randomIndex];
---

{compact ? (
  <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/10 dark:to-indigo-900/10 rounded-lg p-4 border border-blue-100 dark:border-blue-800/30">
    <blockquote class="text-center">
      <p class="text-sm italic text-slate-700 dark:text-slate-300 mb-2">
        "{quote.text}"
      </p>
      <footer class="text-xs text-slate-500 dark:text-slate-400">
        <cite class="font-medium">{quote.author}</cite>
      </footer>
    </blockquote>
  </div>
) : (
  <div class="bg-gradient-to-br from-slate-50 via-blue-50/50 to-indigo-50 dark:from-slate-800/50 dark:via-blue-900/10 dark:to-indigo-900/10 rounded-xl p-6 border border-slate-200/50 dark:border-slate-700/30 shadow-sm">
    <blockquote class="text-center">
      <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="text-blue-600 dark:text-blue-400 text-xl">💭</span>
      </div>
      <p class="text-lg italic text-slate-800 dark:text-slate-200 mb-4 leading-relaxed">
        "{quote.text}"
      </p>
      <footer class="text-slate-600 dark:text-slate-400">
        <cite class="font-semibold">{quote.author}</cite>
        {quote.context && (
          <p class="text-sm mt-1 opacity-75">{quote.context}</p>
        )}
      </footer>
    </blockquote>
  </div>
)}