---
// ProblemList Component - Drag & Drop interface for problem management
---

<div class="problem-list-container">
  <div class="list-header">
    <h3>Преглед на Задачи <span id="problem-count-badge" class="badge">0</span></h3>
    <button id="refresh-all-btn" class="btn-text">🔄 Регенерирај ги сите</button>
  </div>

  <div id="worksheet-preview" class="worksheet-preview">
    <div class="empty-state">
      <div class="empty-icon">📋</div>
      <p>Изберете темплејт за да генерирате задачи</p>
    </div>
  </div>
</div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>

<style>
  .problem-list-container {
    background: #f8fafc;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 2rem;
    border: 1px dashed #cbd5e1;
  }

  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .list-header h3 {
    font-size: 1.25rem;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .badge {
    background: #e0e7ff;
    color: #3730a3;
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .btn-text {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .btn-text:hover {
    background: #f1f5f9;
    color: #334155;
  }

  .worksheet-preview {
    min-height: 200px;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
    color: #94a3b8;
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  /* --- Styles за поединечна задача (Card) --- */
  :global(.problem-card) {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  :global(.problem-card:hover) {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    border-color: #cbd5e1;
  }

  /* Dragging State */
  :global(.sortable-ghost) {
    opacity: 0.4;
    background: #e2e8f0;
    border: 2px dashed #94a3b8;
  }

  :global(.drag-handle) {
    cursor: grab;
    color: #94a3b8;
    padding: 0.25rem;
    font-size: 1.25rem;
    line-height: 1;
    user-select: none;
  }

  :global(.drag-handle:active) {
    cursor: grabbing;
    color: #475569;
  }

  :global(.problem-content) {
    flex-grow: 1;
  }

  :global(.problem-text) {
    color: #334155;
    font-size: 0.9375rem;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  :global(.problem-meta) {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    flex-wrap: wrap;
  }

  :global(.tag) {
    padding: 3px 8px;
    border-radius: 4px;
    background: #f1f5f9;
    color: #475569;
    font-weight: 600;
    white-space: nowrap;
  }
  
  :global(.tag.easy) { background: #dcfce7; color: #166534; }
  :global(.tag.medium) { background: #fef9c3; color: #854d0e; }
  :global(.tag.hard) { background: #fee2e2; color: #991b1b; }
  :global(.tag.points) { background: #e0e7ff; color: #3730a3; }

  /* Action Buttons */
  :global(.problem-actions) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  :global(.problem-card:hover .problem-actions) {
    opacity: 1;
  }

  :global(.action-btn) {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    border-radius: 4px;
    color: #64748b;
    font-size: 1.1rem;
    transition: all 0.2s;
  }

  :global(.action-btn:hover) {
    background: #f1f5f9;
    color: #0f172a;
  }
  
  :global(.action-btn.delete:hover) {
    background: #fee2e2;
    color: #ef4444;
  }
</style>
