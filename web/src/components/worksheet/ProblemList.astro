---
// ProblemList Component - Drag & Drop interface for problem management
---

<div class="problem-list-container">
  <!-- Group Tabs + Actions -->
  <div class="list-header-row">
    <div class="group-tabs">
      <button class="tab-btn active" data-group="A" onclick="window.switchGroup('A')">
        📄 Група А
      </button>
      <button class="tab-btn" data-group="B" onclick="window.switchGroup('B')">
        📑 Група Б
      </button>
    </div>
    
    <button id="btn-gen-variant" class="btn-magic" onclick="window.generateGroupB()" title="Генерирај варијанта на тестот">
      ✨ Генерирај Група Б
    </button>
  </div>

  <!-- Header -->
  <div class="list-header">
    <h3>
      Преглед на Задачи 
      <span id="problem-count-badge" class="badge">0</span>
      <span id="draft-indicator" class="draft-badge" style="display: none;">💾 Auto-saved</span>
    </h3>
    <button id="refresh-all-btn" class="btn-text">🔄 Регенерирај ги сите</button>
  </div>

  <!-- Skeleton Loader (shown during loading) -->
  <div id="skeleton-loader" class="skeleton-wrapper" style="display: none;">
    <div class="skeleton-card">
      <div class="skeleton-handle"></div>
      <div class="skeleton-content">
        <div class="skeleton-line title"></div>
        <div class="skeleton-line meta"></div>
      </div>
    </div>
    <div class="skeleton-card">
      <div class="skeleton-handle"></div>
      <div class="skeleton-content">
        <div class="skeleton-line title"></div>
        <div class="skeleton-line meta"></div>
      </div>
    </div>
    <div class="skeleton-card">
      <div class="skeleton-handle"></div>
      <div class="skeleton-content">
        <div class="skeleton-line title"></div>
        <div class="skeleton-line meta"></div>
      </div>
    </div>
  </div>

  <!-- Problem List -->
  <div id="worksheet-preview" class="worksheet-preview">
    <div class="empty-state">
      <div class="empty-icon">📋</div>
      <p>Изберете темплејт за да генерирате задачи</p>
    </div>
  </div>
</div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>

<style>
  .problem-list-container {
    background: #f8fafc;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 2rem;
    border: 1px dashed #cbd5e1;
  }

  /* === GROUP TABS === */
  .list-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1rem;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 0.5rem;
  }

  .group-tabs {
    display: flex;
    gap: 0.5rem;
  }

  .tab-btn {
    padding: 0.75rem 1.5rem;
    border: none;
    background: transparent;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    transition: all 0.2s;
    font-size: 0.9375rem;
  }

  .tab-btn:hover {
    color: #1e293b;
  }

  .tab-btn.active {
    color: #2563eb;
    border-bottom-color: #2563eb;
  }

  .btn-magic {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white;
    border: none;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 6px -1px rgba(99, 102, 241, 0.3);
    transition: transform 0.1s, opacity 0.2s;
    font-size: 0.875rem;
  }

  .btn-magic:hover {
    box-shadow: 0 6px 8px -1px rgba(99, 102, 241, 0.4);
  }

  .btn-magic:active {
    transform: scale(0.97);
  }

  .btn-magic:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* === SKELETON LOADER === */
  .skeleton-wrapper {
    padding: 1rem 0;
  }

  .skeleton-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 0.75rem;
    display: flex;
    gap: 1rem;
  }

  .skeleton-handle {
    width: 20px;
    height: 40px;
    background: #e2e8f0;
    border-radius: 4px;
    animation: pulse 1.5s infinite ease-in-out;
  }

  .skeleton-content {
    flex-grow: 1;
  }

  .skeleton-line {
    height: 12px;
    background: #e2e8f0;
    border-radius: 4px;
    margin-bottom: 8px;
    animation: pulse 1.5s infinite ease-in-out;
  }

  .skeleton-line.title {
    width: 70%;
    height: 16px;
  }

  .skeleton-line.meta {
    width: 40%;
  }

  @keyframes pulse {
    0% { opacity: 0.6; }
    50% { opacity: 1; }
    100% { opacity: 0.6; }
  }

  /* === HEADER === */
  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .list-header h3 {
    font-size: 1.25rem;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .badge {
    background: #e0e7ff;
    color: #3730a3;
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .draft-badge {
    background: #dcfce7;
    color: #166534;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .btn-text {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .btn-text:hover {
    background: #f1f5f9;
    color: #334155;
  }

  .worksheet-preview {
    min-height: 200px;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
    color: #94a3b8;
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  /* --- Styles за поединечна задача (Card) --- */
  :global(.problem-card) {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  :global(.problem-card:hover) {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    border-color: #cbd5e1;
  }

  /* Dragging State */
  :global(.sortable-ghost) {
    opacity: 0.4;
    background: #e2e8f0;
    border: 2px dashed #94a3b8;
  }

  :global(.drag-handle) {
    cursor: grab;
    color: #94a3b8;
    padding: 0.25rem;
    font-size: 1.25rem;
    line-height: 1;
    user-select: none;
  }

  :global(.drag-handle:active) {
    cursor: grabbing;
    color: #475569;
  }

  :global(.problem-content) {
    flex-grow: 1;
  }

  :global(.problem-text) {
    color: #334155;
    font-size: 0.9375rem;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  :global(.problem-meta) {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    flex-wrap: wrap;
  }

  :global(.tag) {
    padding: 3px 8px;
    border-radius: 4px;
    background: #f1f5f9;
    color: #475569;
    font-weight: 600;
    white-space: nowrap;
  }
  
  :global(.tag.easy) { background: #dcfce7; color: #166534; }
  :global(.tag.medium) { background: #fef9c3; color: #854d0e; }
  :global(.tag.hard) { background: #fee2e2; color: #991b1b; }
  :global(.tag.points) { background: #e0e7ff; color: #3730a3; }

  /* Action Buttons */
  :global(.problem-actions) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  :global(.problem-card:hover .problem-actions) {
    opacity: 1;
  }

  :global(.action-btn) {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    border-radius: 4px;
    color: #64748b;
    font-size: 1.1rem;
    transition: all 0.2s;
  }

  :global(.action-btn:hover) {
    background: #f1f5f9;
    color: #0f172a;
  }
  
  :global(.action-btn.delete:hover) {
    background: #fee2e2;
    color: #ef4444;
  }
</style>
