{
  "name": "mongodb-sink-connector",
  "config": {
    "connector.class": "com.mongodb.kafka.connect.MongoSinkConnector",
    "topics": ".*",
    "connection.uri": "mongodb://mongos:27017/?replicaSet=rs0",
    "database": "olympiad_archive",
    "collection": "${topic}",
    "change.data.capture.handler": "com.mongodb.cdc.debezium.rdbms.RdbmsHandler",
    "document.id.strategy": "com.mongodb.kafka.connect.sink.processor.id.strategy.FullKeyStrategy",
    "key.projection.type": "allowlist",
    "key.projection.list": "id",
    "value.projection.type": "allowlist",
    "value.projection.list": "after",
    "max.num.retries": 3,
    "retries.defer.timeout": 5000,
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "mongodb-sink-dlq",
    "errors.deadletterqueue.context.headers.enable": true,
    "writemodel.strategy": "com.mongodb.kafka.connect.sink.writemodel.strategy.UpdateOneDefaultStrategy",
    "max.in.flight.requests": 1,
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": false,
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": false,
    "transforms": "unwrap,denormalize,replaceField",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": false,
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.unwrap.add.headers": "op,source.ts_ms",
    "transforms.denormalize.type": "com.olympiad.archive.transforms.Denormalize$Value",
    "transforms.denormalize.prefixes": ["competition:competition_details", "author:author_info", "tags:problem_tags"],
    "transforms.denormalize.add.timestamp": true,
    "transforms.replaceField.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
    "transforms.replaceField.renames": "id:_id,processed_at:last_updated"
  }
}