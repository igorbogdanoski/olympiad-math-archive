# Dockerfile for PostgreSQL backup service with wal-g
FROM postgres:14

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install wal-g
RUN curl -L https://github.com/wal-g/wal-g/releases/download/v2.0.1/wal-g-pg-ubuntu-20.04-amd64.tar.gz | tar -xz -C /usr/local/bin/

# Copy backup script
COPY postgres_backup.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/postgres_backup.sh

# Set working directory
WORKDIR /backup

# Default command
CMD ["/usr/local/bin/postgres_backup.sh", "full"]