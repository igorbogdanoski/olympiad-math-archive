{
  "dashboard": {
    "id": null,
    "title": "CDC Synchronization Dashboard",
    "tags": ["cdc", "kafka"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Kafka Topics Lag",
        "type": "graph",
        "targets": [
          {
            "expr": "kafka_consumergroup_lag",
            "legendFormat": "{{topic}} - {{consumergroup}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Connector Running Status",
        "type": "table",
        "targets": [
          {
            "expr": "kafka_connect_connector_running_total",
            "legendFormat": "{{connector}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Records Sent Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(kafka_connect_sink_task_records_sent_total[5m])",
            "legendFormat": "{{connector}} - {{task}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "Failed Records",
        "type": "graph",
        "targets": [
          {
            "expr": "kafka_connect_sink_task_records_failed_total",
            "legendFormat": "{{connector}} - {{task}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "PostgreSQL Connections",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_stat_activity_count",
            "legendFormat": "Active connections",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 6,
        "title": "MongoDB Connections",
        "type": "graph",
        "targets": [
          {
            "expr": "mongodb_connections",
            "legendFormat": "Connections",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}