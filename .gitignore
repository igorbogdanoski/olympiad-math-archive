# Ignore temporary input files
tools/input.json

# Python virtual environments
venv/
.venv/
env/

# Python cache
**/__pycache__/
*.pyc
*.pyo

# Node.js dependencies
node_modules/

# Environment variables
.env
.env.local
.env.production

# PDF files (large binary files)
*.pdf

# System files
.DS_Store
Thumbs.db

# VS Code settings (optional, if you want to keep them private)
.vscode/

# Build outputs
dist/
build/

# Terraform state and providers
.terraform/
*/.terraform/
**/.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# Terraform provider binaries (large files)
**/.terraform/providers/**

# Astro build output (should be generated fresh on deployment)
web/dist/

# Infrastructure directory with large binaries
infrastructure/prod/.terraform/