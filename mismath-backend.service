[Unit]
Description=MisMath Platform Backend API
After=network.target mongodb.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/olympiad-math-archive/backend
Environment="PATH=/root/olympiad-math-archive/backend/venv/bin"
ExecStart=/root/olympiad-math-archive/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
