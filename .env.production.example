# Production Environment Variables
# ⚠️ IMPORTANT: Change all default values before deployment!

# Database Configuration
DB_PASSWORD=change_this_secure_password_123_CHANGE_ME
POSTGRES_DB=math_archive
POSTGRES_USER=mathuser

# JWT Authentication
JWT_SECRET=change_this_jwt_secret_key_456_CHANGE_ME

# Gemini API (for GeoGebra Auto-Matcher)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
SERVER_URL=http://76.13.129.9
# Or if you have domain:
# SERVER_URL=https://olympiad-math.mk

# Node Environment
NODE_ENV=production

# Redis Configuration (usually no need to change)
REDIS_URL=redis://redis:6379

# Email Configuration (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Rate Limiting (requests per second)
API_RATE_LIMIT=10
GENERAL_RATE_LIMIT=100

# Session Configuration
SESSION_SECRET=change_this_session_secret_789_CHANGE_ME
SESSION_MAX_AGE=86400000

# File Upload Limits
MAX_FILE_SIZE=20971520

# Cors Origins (comma separated)
CORS_ORIGINS=http://76.13.129.9,https://olympiad-math.mk

# Logging
LOG_LEVEL=info

# Manim Worker
MANIM_OUTPUT_DIR=/app/output
MANIM_QUALITY=medium_quality
